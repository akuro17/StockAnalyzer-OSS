## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# ClaudeCode: local bridge to Antigravity's .agent/skills & .agent/workflows, plus machine-specific
# settings.json (Y: drive paths). Not portable across clones/OS - regenerate locally instead.
.claude/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Visual Studio 2017 auto generated files
Generated\ Files/

# Visual Studio Code
.vscode/

# PowerShell
*.ps1.xml

# Screenshots and Failures
Screenshots/
ui_test_errors.txt
calc_test_output.txt
full_test_log.txt
CheckXml.ps1
dotnet-install.sh

# Temporary logs and databases
logs/
launcher_error.log
startup_trace.log
startup_error.log
git_status.txt
TestResults/
*.pb
*.db
out.log
process.txt

# Data and Python cache
Data/
MarketData/
**/__pycache__/

# Allow specific documentation layout configurations
!PROJECT_STRUCTURE.md
!CODE_REVIEW_GUIDELINES.md
!WEBAI_FUNCTION_PROMPTS.md

# Scripts and scratch files in root
check_mtime.py
dump_db.py
extract_strings.py
scratch_*.cs
scratch_*.ps1
debug_*.cs
debug_*.py
frama_test.cs
test.cs
test_layout.cs
test_nan.cs
test_run_all.log
regen_output.txt
single_test_output.txt
sa_*.md
sa_*.tmp
# Windows' case-insensitive matching makes the "sa_*.md" rule above also match the
# uppercase-prefixed "SA_*.md" core reference docs under docs/ (e.g. SA_ARCHITECTURE_RULES.md) -
# carve those back out so they stay trackable.
!docs/SA_ARCHITECTURE_RULES.md
!docs/SA_PYTHON_IPC.md
!docs/SA_RENDERING_PERFORMANCE.md
!docs/SA_UI_INTERACTION.md
!docs/SA_UI_SUBWINDOW_STANDARD.md
!docs/ja/SA_DEBUG_LOGGING_SPEC.md
propose_comment.md

# Local configuration files
appsettings.json
appsettings.Development.json

# Python training tooling virtual environment
StockAnalyzer.Python/.venv/

# Generated training-run ONNX artifacts now live under Data/TrainingArtifacts/, already covered
# by the wholesale "Data/" ignore above. The old location below is superseded (code no longer
# writes there) but stays ignored so any leftover local artifacts from before the move don't
# show up as untracked/committable in a working copy that still has that directory.
StockAnalyzer.Python/training/artifacts/
