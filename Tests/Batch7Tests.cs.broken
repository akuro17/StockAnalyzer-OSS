using System;
using System.Collections.Generic;
using System.Linq;
using Xunit;
using StockAnalyzer.Core.Models.Indicators.Statistics;
using StockAnalyzer.Core.Models.Indicators.Volatility;
using System.Windows.Media;

namespace StockAnalyzer.Tests
{
    public class Batch7Tests
    {
        private List<CandleData> CreateTestData(int count, decimal startPrice = 100m, decimal trend = 0m)
        {
            var candles = new List<CandleData>();
            var date = new DateTime(2023, 1, 1);

            for (int i = 0; i < count; i++)
            {
                decimal price = startPrice + (i * trend);
                candles.Add(new CandleData
                {
                    Timestamp = date.AddDays(i),
                    Open = price,
                    High = price + 5m,
                    Low = price - 5m,
                    Close = price,
                    Volume = 1000
                });
            }
            return candles;
        }

        // VaR (Value at Risk)
        [Fact]
        public void VaR_Calculate_ReturnsCorrectValues()
        {
            var candles = CreateTestData(30, 100m, 10m);
            var var = new ValueAtRiskIndicator(20, 0.95, Colors.Blue);
            var.Calculate(candles);
            Assert.Equal(30, var.Values.Count);
        }

        [Fact]
        public void VaR_WithInsufficientData_ReturnsNulls()
        {
            var candles = CreateTestData(10, 100m, 0m);
            var var = new ValueAtRiskIndicator(20, 0.95, Colors.Blue);
            var.Calculate(candles);
            Assert.All(var.Values, v => Assert.Null(v));
        }

        // CVaR (Conditional Value at Risk)
        [Fact]
        public void CVaR_Calculate_ReturnsCorrectValues()
        {
            var candles = CreateTestData(30, 100m, 10m);
            var cvar = new ConditionalValueAtRiskIndicator(20, 0.95, Colors.Blue);
            cvar.Calculate(candles);
            Assert.Equal(30, cvar.Values.Count);
        }

        [Fact]
        public void CVaR_WithInsufficientData_ReturnsNulls()
        {
            var candles = CreateTestData(10, 100m, 0m);
            var cvar = new ConditionalValueAtRiskIndicator(20, 0.95, Colors.Blue);
            cvar.Calculate(candles);
            Assert.All(cvar.Values, v => Assert.Null(v));
        }

        // Variance
        [Fact]
        public void Variance_Calculate_ReturnsCorrectValues()
        {
            var candles = CreateTestData(30, 100m, 10m);
            var variance = new VarianceIndicator(20, Colors.Blue);
            variance.Calculate(candles);
            Assert.Equal(30, variance.Values.Count);
        }

        [Fact]
        public void Variance_WithFlatData_ReturnsZero()
        {
            var candles = CreateTestData(30, 100m, 0m);
            var variance = new VarianceIndicator(20, Colors.Blue);
            variance.Calculate(candles);
            Assert.NotNull(variance.Values.Last());
            Assert.Equal(0m, variance.Values.Last()!.Value, 2);
        }

        // Standard Deviation
        [Fact]
        public void StandardDeviation_Calculate_ReturnsCorrectValues()
        {
            var candles = CreateTestData(30, 100m, 10m);
            var std = new StandardDeviationIndicator(20, true, Colors.Blue);
            std.Calculate(candles);
            Assert.Equal(30, std.Values.Count);
            Assert.NotNull(std.Values.Last());
        }

        [Fact]
        public void StandardDeviation_WithFlatData_ReturnsZero()
        {
            var candles = CreateTestData(30, 100m, 0m);
            var std = new StandardDeviationIndicator(20, true, Colors.Blue);
            std.Calculate(candles);
            Assert.NotNull(std.Values.Last());
            Assert.Equal(0m, std.Values.Last()!.Value, 2);
        }
    }
}
