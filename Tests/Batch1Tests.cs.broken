using System;
using System.Collections.Generic;
using System.Linq;
using Xunit;
using System.Windows.Media;

namespace StockAnalyzer.Tests
{
    public class Batch1Tests
    {
        private List<CandleData> CreateTestData(int count, decimal startPrice = 100m, decimal trend = 0m)
        {
            var candles = new List<CandleData>();
            var date = new DateTime(2023, 1, 1);

            for (int i = 0; i < count; i++)
            {
                decimal price = startPrice + (i * trend);
                candles.Add(new CandleData
                {
                    Timestamp = date.AddDays(i),
                    Open = price,
                    High = price + 5m,
                    Low = price - 5m,
                    Close = price,
                    Volume = 1000
                });
            }
            return candles;
        }

        [Fact]
        public void SMA_Calculate_ReturnsCorrectValues()
        {
            // Arrange
            var candles = CreateTestData(10, 100m, 10m); // 100, 110, 120...
            var sma = new SmaIndicator(5, Colors.Blue);

            // Act
            sma.Calculate(candles);

            // Assert
            Assert.Equal(10, sma.Values.Count);
            // First 4 should be null
            Assert.All(sma.Values.Take(4), v => Assert.Null(v));
            
            // 5th value (index 4): (100+110+120+130+140)/5 = 120
            Assert.NotNull(sma.Values[4]);
            Assert.Equal(120m, sma.Values[4]!.Value);
            
            // Last value: (150+160+170+180+190)/5 = 170
            Assert.NotNull(sma.Values.Last());
            Assert.Equal(170m, sma.Values.Last()!.Value);
        }

        [Fact]
        public void EMA_Calculate_ReturnsCorrectValues()
        {
            // Arrange
            var candles = CreateTestData(10, 100m, 0m); // Flat 100
            var ema = new EmaIndicator(5, Colors.Blue);

            // Act
            ema.Calculate(candles);

            // Assert
            // For flat data, EMA should eventually settle at the price
            // But initially it might be SMA or just the price depending on impl
            // Assuming standard EMA: First value is SMA, then EMA formula
            
            Assert.NotNull(ema.Values.Last());
            Assert.Equal(100m, ema.Values.Last()!.Value);
        }

        [Fact]
        public void WMA_Calculate_ReturnsCorrectValues()
        {
            // Arrange
            var candles = CreateTestData(5, 10m, 10m); // 10, 20, 30, 40, 50
            var wma = new WmaIndicator(3, Colors.Blue);

            // Act
            wma.Calculate(candles);

            // Assert
            // Weights for period 3: 1, 2, 3. Sum = 6.
            // Index 2 (30): (10*1 + 20*2 + 30*3) / 6 = (10+40+90)/6 = 140/6 = 23.333...
            // Index 3 (40): (20*1 + 30*2 + 40*3) / 6 = (20+60+120)/6 = 200/6 = 33.333...
            // Index 4 (50): (30*1 + 40*2 + 50*3) / 6 = (30+80+150)/6 = 260/6 = 43.333...

            Assert.NotNull(wma.Values[2]);
            Assert.Equal(23.3333m, wma.Values[2]!.Value, 3);
        }

        [Fact]
        public void DEMA_Calculate_ReturnsCorrectValues()
        {
            // Arrange
            var candles = CreateTestData(40, 100m, 10m);
            var dema = new DemaIndicator(10, Colors.Blue);

            // Act
            dema.Calculate(candles);

            // Assert
            Assert.Equal(40, dema.Values.Count);
            Assert.NotNull(dema.Values.Last());
        }

        [Fact]
        public void TEMA_Calculate_ReturnsCorrectValues()
        {
            // Arrange
            var candles = CreateTestData(40, 100m, 10m);
            var tema = new TemaIndicator(10, Colors.Blue);

            // Act
            tema.Calculate(candles);

            // Assert
            Assert.Equal(40, tema.Values.Count);
            Assert.NotNull(tema.Values.Last());
        }
        
        [Fact]
        public void VWMA_Calculate_ReturnsCorrectValues()
        {
            // Arrange
            var candles = new List<CandleData>();
            var date = new DateTime(2023, 1, 1);
            
            // Create candles with different volumes: 100, 200, 300, 400, 500
            for(int i=0; i<5; i++)
            {
                candles.Add(new CandleData
                {
                    Timestamp = date.AddDays(i),
                    Open = 100m,
                    High = 105m,
                    Low = 95m,
                    Close = 100m,
                    Volume = (i+1)*100
                });
            }
            
            var vwma = new VwmaIndicator(3, Colors.Blue);

            // Act
            vwma.Calculate(candles);

            // Assert
            // Index 2: Prices 100, 100, 100. Volumes 100, 200, 300.
            // VWMA = (100*100 + 100*200 + 100*300) / (100+200+300) = 100
            Assert.NotNull(vwma.Values[2]);
            Assert.Equal(100m, vwma.Values[2]!.Value);
        }
    }
}
