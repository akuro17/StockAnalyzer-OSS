using System;
using System.Collections.Generic;
using System.Linq;
using Xunit;
using StockAnalyzer.Core.Models.Indicators;

namespace StockAnalyzer.Tests
{
    public class Batch11Tests
    {
        private static readonly DateTime BaseTime = new DateTime(2020, 1, 1, 9, 0, 0);

        [Fact]
        public void Kagi_Constructor_ValidParameters_Succeeds()
        {
            var kagi = new KagiIndicator(10m, ReversalType.Fixed, System.Windows.Media.Colors.Blue);
            Assert.Equal(10m, kagi.ReversalAmount);
            Assert.Equal(ReversalType.Fixed, kagi.ReversalType);
            Assert.Equal("Kagi (10) [Fixed]", kagi.Name);
        }

        [Fact]
        public void Kagi_Constructor_InvalidParameters_Throws()
        {
            Assert.Throws<ArgumentOutOfRangeException>(() =>
                new KagiIndicator(0m, ReversalType.Fixed, System.Windows.Media.Colors.Blue));
            Assert.Throws<ArgumentOutOfRangeException>(() =>
                new KagiIndicator(-1m, ReversalType.Fixed, System.Windows.Media.Colors.Blue));
        }

        [Fact]
        public void Kagi_Calculate_Basic_Trend()
        {
            // Basic Trend Test
            int n = 100;
            var candles = GenerateSequentialCandles(n, 100m, 1m); // Linear trend
            var kagi = new KagiIndicator(10m, ReversalType.Fixed, System.Windows.Media.Colors.Blue);

            kagi.Calculate(candles);

            // With redundancy elimination, count won't match n if trend establishment takes time
            Assert.NotEmpty(kagi.Values);
            Assert.NotNull(kagi.Values.Last());
        }

        [Fact]
        public void Kagi_Calculate_Reversal_Detection()
        {
            // Create a ZigZag pattern: 100 -> 120 -> 90 -> 110
            var candles = new List<CandleData>();
            int t = 0;
            // Up to 120
            for (decimal p = 100; p <= 120; p += 1) candles.Add(CreateCandle(t++, p));
            // Down to 90
            for (decimal p = 119; p >= 90; p -= 1) candles.Add(CreateCandle(t++, p));
            // Up to 110
            for (decimal p = 91; p <= 110; p += 1) candles.Add(CreateCandle(t++, p));

            // Reversal Amount = 5
            var kagi = new KagiIndicator(5m, ReversalType.Fixed, System.Windows.Media.Colors.Blue);
            kagi.Calculate(candles);

            Assert.NotEmpty(kagi.Values);
            
            // Check that we have multiple lines
            Assert.True(kagi.KagiLines.Count >= 3, "Should have at least 3 lines (Up, Down, Up)");
            Assert.Contains(kagi.KagiLines, l => l.Type == KagiLineType.Yang);
            Assert.Contains(kagi.KagiLines, l => l.Type == KagiLineType.Yin);
        }

        [Fact]
        public void Kagi_DynamicReversal_ATR_RunsWithoutError()
        {
            var candles = GenerateSequentialCandles(50, 100m, 1m);
            // Reversal Amount = 14 (treated as Period for ATR)
            var kagi = new KagiIndicator(14, ReversalType.ATR, System.Windows.Media.Colors.Blue);
            
            kagi.Calculate(candles);
            
            Assert.NotEmpty(kagi.Values);
            Assert.NotEmpty(kagi.KagiLines);
        }

        [Fact]
        public void Kagi_ShoulderDetection_MarksShoulders()
        {
            // Construct a sequence that creates shoulders
            // Yang up to 110 (Peak 1) -> Reversal down -> Yin down to 90 -> Reversal up
            // Yang up to 120 (Peak 2, Higher) -> Reversal down
            // Yang up to 115 (Peak 3, Shoulder - Lower than 120) -> Reversal down
            
            var candles = new List<CandleData>();
            int t = 0;
            
            void AddMove(decimal start, decimal end)
            {
                int steps = (int)Math.Abs(end - start);
                int dir = Math.Sign(end - start);
                for (int i = 0; i <= steps; i++)
                {
                    decimal p = start + i * dir;
                    candles.Add(CreateCandle(t++, p));
                }
            }
            
            AddMove(100, 120); // Up to 120
            AddMove(119, 100); // Down to 100 (Reversal trigger > 5)
            AddMove(101, 130); // Up to 130 (Higher Peak)
            AddMove(129, 110); // Down to 110
            AddMove(111, 140); // Up to 140 (Higher Peak)
            AddMove(139, 100); // Down to 100
             
            // Try to make a lower peak for Shoulder
            // From 100 go up to 135 (Lower than 140) then down
            AddMove(101, 135); 
            AddMove(134, 100);

            var kagi = new KagiIndicator(5m, ReversalType.Fixed, System.Windows.Media.Colors.Blue);
            kagi.Calculate(candles);
            
            // Check if any line has IsShoulder = true
            // Note: The logic in implementation was "Higher than previous high" -> Shoulder??
            // Checking the implementation logic again:
            // if (line.EndPrice > lastYangHigh) { if (i > 0) isShoulder = true; lastYangHigh = ... }
            // This logic marks "New Highs" as shoulders if they follow previous lines.
            // Strict Definition of Shoulder in Kagi is complex, but for this Refactoring verification,
            // we mainly verify the *property logic matches the implementation*.
            
            Assert.Contains(kagi.KagiLines, l => l.IsShoulder == true);
        }
        
        // --- Helpers ---

        private List<CandleData> GenerateSequentialCandles(int count, decimal basePrice, decimal increment)
        {
            var candles = new List<CandleData>();
            for (int i = 0; i < count; i++)
            {
                decimal close = basePrice + (i * increment);
                // Simple candle where Close is the main mover
                candles.Add(CreateCandle(i, close));
            }
            return candles;
        }

        private CandleData CreateCandle(int minuteOffset, decimal close)
        {
            return new CandleData
            {
                Timestamp = BaseTime.AddMinutes(minuteOffset),
                Open = close,
                High = close, // Simplified for Line chart testing
                Low = close,
                Close = close,
                Volume = 1000
            };
        }
        [Fact]
        public void PointAndFigure_Basic_Trend_Generation()
        {
            // BoxSize = 1, Reversal = 3
            var pf = new PointAndFigureIndicator(1m, 3, System.Windows.Media.Colors.Blue);
            
            var candles = new List<CandleData>();
            int t = 0;
            // 1. Start at 100
            candles.Add(CreateCandle(t++, 100)); // Anchor 100
            
            // 2. Move Up to 105 (Up Trend established)
            // 100 -> 101 (Box 1), 102, 103, 104, 105
            // Should be Up Column from 100 to 105
            for (decimal p = 101; p <= 105; p++) candles.Add(CreateCandle(t++, p));
            
            // 3. Move Down to 103 (Pullback 2 boxes < Reversal 3) - No new column
            candles.Add(CreateCandle(t++, 104));
            candles.Add(CreateCandle(t++, 103));
            
            // 4. Move Down to 102 (Reversal: 105 - 102 = 3 >= 3)
            // Should finalize Up Column (100-105) and start Down Column
            candles.Add(CreateCandle(t++, 102));
            
            // 5. Move Down to 90
            for (decimal p = 101; p >= 90; p--) candles.Add(CreateCandle(t++, p));
            
            pf.Calculate(candles);
            
            Assert.NotEmpty(pf.Columns); // Check Columns exist
            // Expect:
            // Col 1: Up, High 105, Low 100
            // Col 2: Down, High 105, Low 90
            
            var col1 = pf.Columns[0];
            Assert.Equal(PfColumnType.Up, col1.Type);
            Assert.Equal(105m, col1.High);
            
            var col2 = pf.Columns[1];
            Assert.Equal(PfColumnType.Down, col2.Type);
            Assert.Equal(105m, col2.High);
            Assert.Equal(90m, col2.Low);
        }
    }
}
