<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StockAnalyzer.Avalonia.App"
             xmlns:local="using:StockAnalyzer.Avalonia"
             xmlns:sys="using:System"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/Colors.axaml"/>
                <ResourceInclude Source="/Assets/Styles.axaml"/>
                <ResourceInclude Source="/Assets/StockStyles.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="BaseFontSize">16</sys:Double>
            <sys:Double x:Key="TitleFontSize">20</sys:Double>
            <sys:Double x:Key="DetailFontSize">12</sys:Double>
            <sys:Double x:Key="HelperFontSize">12</sys:Double>
            <sys:Double x:Key="SmallFontSize">10</sys:Double>

            <!-- ButtonSpinner / RepeatButton Theme Resource Overrides (eliminates square frames & borders globally) -->
            <Thickness x:Key="ButtonSpinnerButtonBorderThickness">0</Thickness>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBorderBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBackground">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBackgroundPointerOver">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBackgroundPressed">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBackgroundDisabled">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBorderBrushPointerOver">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBorderBrushPressed">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSpinnerButtonBorderBrushDisabled">Transparent</SolidColorBrush>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <!-- Explicitly include ColorPicker styles if not covered by FluentTheme in strict mode -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Fluent.axaml" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="/Assets/ModernTheme.axaml"/>
        <Style Selector="Window">
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Global ComboBox DropDown Glyph Clean Arrow Styling (matches Indicator Manager clean styling) -->
        <Style Selector="ComboBox ToggleButton">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ComboBox ToggleButton:pointerover">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox ToggleButton:pressed">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox /template/ PathIcon">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Standard ButtonSpinner & RepeatButton Styling (Restored) -->
        <Style Selector="ButtonSpinner">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Dynamic Control Clean Styling Override inside Screener & Dialogs -->
        <Style Selector="ComboBox /template/ Border#PART_ButtonBorder">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Clean Uniform 1px Outer Border for NumericUpDown (matching ComboBox) -->
        <Style Selector="NumericUpDown">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="NumericUpDown:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="NumericUpDown:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Zero out ALL inner borders inside NumericUpDown so ONLY the single 1px outer border remains -->
        <Style Selector="NumericUpDown /template/ ButtonSpinner">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ Border#PART_ButtonSpinnerBorder">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown:pointerover /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown:focus /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown:focus-within /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ComboBox:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Tag Chip Styles -->
        <Style Selector="Border.TagChip">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
        </Style>
        <Style Selector="TextBlock.TagText">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Overflow Badge Styles -->
        <Style Selector="Border.TagBadge">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
        </Style>
        <Style Selector="TextBlock.TagBadgeText">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Styles>
</Application>