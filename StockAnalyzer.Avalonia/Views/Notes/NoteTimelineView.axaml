<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Notes"
             xmlns:views="using:StockAnalyzer.Avalonia.Views.Notes"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             xmlns:conv="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
             xmlns:c="clr-namespace:StockAnalyzer.Avalonia.Common;assembly=StockAnalyzer.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="700"
             x:Class="StockAnalyzer.Avalonia.Views.Notes.NoteTimelineView"
             x:DataType="vm:NoteTimelineViewModel"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Suggestion item template for Related Ticker AutoCompleteBox -->
        <DataTemplate x:Key="TickerSuggestionItemTemplate">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2">
                <TextBlock Text="{Binding}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Semantic.Success}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{l:Localize AddTicker_SymbolSeparator}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{l:Localize AddTicker_SymbolDescription}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource HelperFontSize}"/>

                <Border Grid.Column="3" Background="{DynamicResource Brush.Background.Primary}" Padding="4,1" CornerRadius="2" Margin="6,0">
                    <TextBlock Text="{l:Localize AddTicker_MarketLabel}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontWeight="Bold"/>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                    <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                          Fill="{DynamicResource Brush.Semantic.Success}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize AddTicker_ValidLabel}" Foreground="{DynamicResource Brush.Semantic.Success}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- CalendarDatePicker button icon: the shared date_range visual (replaces the default day-number glyph). -->
        <StyleInclude Source="avares://StockAnalyzer.Avalonia/Assets/CalendarDatePickerIcon.axaml"/>

        <!-- Action icon buttons in search bar (e.g. Back button) matching post action icon styling -->
        <Style Selector="Button.NoteActionIcon">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.NoteActionIcon:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
    </UserControl.Styles>

    <!-- Unified 3-Column Root Grid: Left (250px) = Right (250px), Center (*) -->
    <Grid ColumnDefinitions="250,Auto,*,Auto,250">

        <!-- ======================================================== -->
        <!-- COLUMN 0: LEFT COLUMN (Fixed Width = 250px)               -->
        <!-- ======================================================== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,4,0">
            <!-- Row 0: Action buttons panel (Hidden during compose/edit) -->
            <Border Grid.Row="0" Classes="PremiumCard" Padding="8" Margin="0,0,0,8"
                    IsVisible="{Binding EditingNote, Converter={x:Static ObjectConverters.IsNull}}">
                <StackPanel Spacing="8">
                    <Button Theme="{DynamicResource PrimaryButtonStyle}" Content="{l:Localize Note_NewNoteButton}"
                            Command="{Binding BeginCreateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Margin="0,0,3,0" Theme="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding OpenTrashCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="{l:Localize Note_TrashButton_Tooltip}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <PathIcon Data="{x:Static c:SharedIconGeometries.Delete}" Width="14" Height="14"/>
                                <TextBlock Text="{Binding DeletedNotesCount}" FontSize="{DynamicResource DetailFontSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Margin="3,0,0,0" Theme="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding OpenOrphanedFilesCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="{l:Localize Note_OrphanedButton_Tooltip}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <Grid Width="16" Height="14" VerticalAlignment="Center">
                                    <PathIcon Data="M320-240h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Zm280-520h200L520-800v200Z"
                                              Width="12" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <PathIcon Data="{x:Static c:SharedIconGeometries.LinkOff}"
                                              Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="{Binding OrphanedFilesCount}" FontSize="{DynamicResource DetailFontSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Row 0: Aggregated Composer Controls at Top of Left Column (Shown when EditingNote != null) -->
            <Border Grid.Row="0" Classes="PremiumCard" Padding="8" Margin="0,0,0,8"
                    IsVisible="{Binding EditingNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="6" DataContext="{Binding EditingNote}" x:DataType="vm:NoteEditorViewModel">
                    <!-- Ticker AutoCompleteBox (Full width) -->
                    <AutoCompleteBox Height="28" HorizontalAlignment="Stretch"
                                     TabIndex="2"
                                     Watermark="{l:Localize Note_RelatedTicker_Watermark}"
                                     Text="{Binding RelatedTicker, Mode=OneWay}"
                                     ItemsSource="{Binding AvailableTickers}"
                                     FilterMode="StartsWith"
                                     KeyDown="RelatedTickerBox_KeyDown"
                                     SelectionChanged="RelatedTickerBox_SelectionChanged"
                                     BorderBrush="{DynamicResource Brush.Border}"
                                     BorderThickness="1"
                                     CornerRadius="6">
                        <AutoCompleteBox.ItemTemplate>
                            <StaticResource ResourceKey="TickerSuggestionItemTemplate"/>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>

                    <!-- CalendarDatePicker (Full width, stacked vertically below Ticker) -->
                    <CalendarDatePicker Height="28" HorizontalAlignment="Stretch"
                                        TabIndex="3"
                                        SelectedDate="{Binding CatalystDate, Mode=TwoWay}"
                                        SelectedDateFormat="Custom" CustomDateFormatString="yyyyMMdd"
                                        Watermark="{l:Localize Note_CatalystDate_Watermark}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="6"/>

                    <!-- Row B: Action Buttons (Save, Cancel, Attach) -->
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Margin="0,0,2,0" TabIndex="4" Theme="{DynamicResource PrimaryButtonStyle}"
                                Content="{l:Localize Btn_Save}"
                                Command="{Binding $parent[UserControl].((vm:NoteTimelineViewModel)DataContext).SaveEditCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,2"/>
                        <Button Grid.Column="1" Margin="2,0,2,0" TabIndex="5" Theme="{DynamicResource PrimaryButtonStyle}"
                                Content="{l:Localize Btn_Cancel}"
                                Command="{Binding $parent[UserControl].((vm:NoteTimelineViewModel)DataContext).CancelEditCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,2"/>
                        <Button Grid.Column="2" Margin="2,0,0,0" TabIndex="6" Theme="{DynamicResource PrimaryButtonStyle}"
                                Content="{l:Localize Note_AttachImageButton}"
                                Click="AttachImageButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,2"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Splitter Left -->
        <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns"/>

        <!-- ======================================================== -->
        <!-- COLUMN 2: CENTER COLUMN (Width = *)                       -->
        <!-- ======================================================== -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="4,0,4,0">
            <!-- ROW 0: ALWAYS FIXED TOP Search & Filter Bar (Standardized 16px bottom margin) -->
            <Border Grid.Row="0" Classes="PremiumCard" Margin="0,0,0,16" Padding="8">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="{DynamicResource Note.ActionIconButtonSize}">
                        <!-- Unified Scope / Ticker / Tag / Hashtag AutoCompleteBox (Just-size: 240px, unified height: 32px matching Back button) -->
                        <AutoCompleteBox Grid.Column="0" Margin="0,0,8,0" x:Name="SearchSuggestionBox" Width="240" Height="32"
                                         VerticalAlignment="Center"
                                         Watermark="{l:Localize Note_SearchSuggestion_Watermark}"
                                         Text="{Binding SearchBoxDisplayText, Mode=OneWay}"
                                         ItemsSource="{Binding AvailableSearchSuggestions}"
                                         FilterMode="Custom"
                                         KeyDown="SearchSuggestionBox_KeyDown"
                                         SelectionChanged="SearchSuggestionBox_SelectionChanged"
                                         BorderBrush="{DynamicResource Brush.Border}"
                                         BorderThickness="1"
                                         CornerRadius="6">
                            <AutoCompleteBox.ItemTemplate>
                                <StaticResource ResourceKey="SuggestionRowTemplate"/>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>

                        <!-- Search Text Box (Unified to same width: 240px, unified height: 32px) -->
                        <TextBox Grid.Column="1" Width="240" Height="32" VerticalAlignment="Center"
                                 Text="{Binding SearchText}" Watermark="{l:Localize Note_SearchText_Watermark}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{x:Static c:SharedIconGeometries.Search}"
                                          Width="14" Height="14" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>

                        <!-- Back Button (shown only when viewing individual note detail, positioned at far right of search bar row) -->
                        <Button Grid.Column="3"
                                Theme="{DynamicResource NoteActionIconButtonStyle}" Classes="NoteActionIcon"
                                Command="{Binding BackToListCommand}"
                                IsVisible="{Binding IsDetailVisible}"
                                ToolTip.Tip="{l:Localize Note_BackToListButton}"
                                Margin="0"
                                VerticalAlignment="Center">
                            <!-- arrow_back icon (Assets\Icons\arrow_back.svg) styled identical to post action buttons (Reply etc.) -->
                            <PathIcon Data="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"
                                      Width="{DynamicResource Note.ActionIconButtonSize}"
                                      Height="{DynamicResource Note.ActionIconButtonSize}"/>
                        </Button>
                    </Grid>

                    <!-- Filter Chips Row -->
                    <ItemsControl ItemsSource="{Binding SelectedTickerCodes}"
                                  IsVisible="{Binding SelectedTickerCodes.Count, Converter={x:Static conv:NumericalConverters.IsGreaterThanZero}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                                        <Button Content="{l:Localize Note_RemoveAttachmentButton_Symbol}" Padding="4,0"
                                                Command="{Binding $parent[ItemsControl].((vm:NoteTimelineViewModel)DataContext).RemoveTickerFilterCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ROW 1: Main Content Space (Switches between Timeline, Expansive Composer, and Detail) -->
            <Panel Grid.Row="1">
                <!-- VIEW A: Main Timeline Feed -->
                <ScrollViewer x:Name="TimelineScrollViewer"
                              Theme="{StaticResource SidebarScrollViewerTheme}" AllowAutoHide="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding IsTimelineListVisible}">
                    <ItemsControl ItemsSource="{Binding DisplayedNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NoteTimelineItemViewModel">
                                <views:NoteCardView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- VIEW B: Expansive Note Composer Body Area (New Note / Edit) -->
                <Border Classes="PremiumCard" Padding="12"
                        IsVisible="{Binding EditingNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer Theme="{StaticResource SidebarScrollViewerTheme}" AllowAutoHide="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10" DataContext="{Binding EditingNote}" x:DataType="vm:NoteEditorViewModel">
                            <!-- Multiline Body Editor (Occupies wide center column) -->
                            <TextBox x:Name="ComposeBodyTextBox" TabIndex="1"
                                     Text="{Binding Body}" Watermark="{l:Localize Note_ComposeBody_Watermark}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="160"/>

                            <!-- Staged Attachments & Error Previews wrapped in MaxHeight="160" ScrollViewer -->
                            <ScrollViewer MaxHeight="160" Theme="{StaticResource SidebarScrollViewerTheme}"
                                          AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                    <ItemsControl ItemsSource="{Binding PendingAttachments}"
                                                  IsVisible="{Binding PendingAttachments.Count, Converter={x:Static conv:NumericalConverters.IsGreaterThanZero}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PendingImageAttachment">
                                                <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="6,4" Margin="0,0,6,6"
                                                        ToolTip.Tip="{Binding OriginalFileName}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Image Source="{Binding Preview}"
                                                               Width="{Binding $parent[ItemsControl].((vm:NoteEditorViewModel)DataContext).ThumbnailSizePixels}"
                                                               Height="{Binding $parent[ItemsControl].((vm:NoteEditorViewModel)DataContext).ThumbnailSizePixels}"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        <Button Content="{l:Localize Note_RemoveAttachmentButton_Symbol}" Padding="4,0"
                                                                Command="{Binding $parent[ItemsControl].((vm:NoteEditorViewModel)DataContext).RemovePendingAttachmentCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding AttachmentErrors}"
                                                  IsVisible="{Binding AttachmentErrors.Count, Converter={x:Static conv:NumericalConverters.IsGreaterThanZero}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Semantic.Error}" FontSize="{DynamicResource HelperFontSize}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- VIEW C: Note Detail View -->
                <views:NoteDetailView IsVisible="{Binding IsDetailVisible}"/>
            </Panel>
        </Grid>

        <!-- Splitter Right -->
        <GridSplitter Grid.Column="3" Width="4" Background="Transparent" ResizeDirection="Columns"/>

        <!-- ======================================================== -->
        <!-- COLUMN 4: RIGHT COLUMN (Fixed Width = 250px)              -->
        <!-- ======================================================== -->
        <Border Grid.Column="4" Classes="PremiumCard" Margin="4,0,0,0" Padding="10">
            <Grid RowDefinitions="Auto,*">
                <!-- Sidebar Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <PathIcon Grid.Column="0" Data="{x:Static c:SharedIconGeometries.Calendar}" Width="16" Height="16"
                              Foreground="{DynamicResource Brush.Accent.Primary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="{l:Localize Note_UpcomingCatalysts_Title}"
                               FontWeight="Bold" FontSize="{DynamicResource SubtitleFontSize}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Catalyst Items Stream -->
                <ScrollViewer Grid.Row="1" Theme="{StaticResource SidebarScrollViewerTheme}" AllowAutoHide="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding UpcomingCatalysts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UpcomingCatalystItemViewModel">
                                <Button Classes="SubtleButton" Command="{Binding NavigateCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,8" Padding="0">
                                    <Border Background="{DynamicResource Brush.Background.Secondary}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="6" Padding="8">
                                        <StackPanel Spacing="4">
                                            <!-- Header: Ticker, Date, Countdown badge -->
                                            <StackPanel Spacing="3">
                                                <!-- Ticker badge (when present) -->
                                                <Border Background="{DynamicResource Brush.Background.Primary}"
                                                        CornerRadius="4" Padding="4,1" HorizontalAlignment="Left"
                                                        IsVisible="{Binding Ticker, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Ticker}" FontWeight="Bold" FontSize="{DynamicResource HelperFontSize}"
                                                               Foreground="{DynamicResource Brush.Semantic.Success}"/>
                                                </Border>

                                                <!-- Date and countdown badge side-by-side on same line -->
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedDate}"
                                                               FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Classes.urgent="{Binding IsUrgent}"
                                                            Background="{DynamicResource Brush.Accent.Muted}" CornerRadius="4" Padding="6,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CountdownText}" FontWeight="SemiBold"
                                                                   FontSize="{DynamicResource HelperFontSize}"
                                                                   Foreground="{DynamicResource Brush.Accent.Primary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Body Snippet -->
                                            <TextBlock Text="{Binding BodySnippet}" TextWrapping="Wrap"
                                                       FontSize="{DynamicResource DetailFontSize}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
