<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Notes"
             xmlns:views="using:StockAnalyzer.Avalonia.Views.Notes"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             xmlns:conv="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
             xmlns:c="clr-namespace:StockAnalyzer.Avalonia.Common;assembly=StockAnalyzer.Avalonia"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="600"
             x:Class="StockAnalyzer.Avalonia.Views.Notes.NoteTimelineView"
             x:DataType="vm:NoteTimelineViewModel"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Identical suggestion-row layout to MainWindow's Symbol AutoCompleteBox
             (fix request #1, 2nd round: "same suggestion display spec"), used by the compose panel's
             Related-ticker box below (Ticker-only, unaffected by the unified search box below). -->
        <DataTemplate x:Key="TickerSuggestionItemTemplate">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2">
                <TextBlock Text="{Binding}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Semantic.Success}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{l:Localize AddTicker_SymbolSeparator}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{l:Localize AddTicker_SymbolDescription}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource HelperFontSize}"/>

                <Border Grid.Column="3" Background="{DynamicResource Brush.Background.Primary}" Padding="4,1" CornerRadius="2" Margin="6,0">
                    <TextBlock Text="{l:Localize AddTicker_MarketLabel}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontWeight="Bold"/>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                    <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                          Fill="{DynamicResource Brush.Semantic.Success}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize AddTicker_ValidLabel}" Foreground="{DynamicResource Brush.Semantic.Success}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Unified search suggestion row (sa_implement Task 3, sa_analysis_report.md §10):
             replaces the old separate scope-menu Flyout and "Tag ▼" ListBox. One icon shape per
             NoteScopeSuggestionKind - Watchlist/Portfolio/Filter reuse the exact same path data as
             TickerListView.axaml's own TreeDataTemplates (computed in NoteScopeSuggestion.IconGeometry
             itself, not duplicated here), so the same shape means the same thing in both tabs. -->
        <DataTemplate x:Key="SearchSuggestionItemTemplate" x:DataType="vm:NoteScopeSuggestion">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                <PathIcon Data="{Binding IconGeometry}" Width="12" Height="12" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- sa_minimal_fix (New Note Polish, 3rd round - "when the host panel showing the Note tab is
         short, no scrollbar appears"): the compose panel (Row 2 below) used to have its own "Auto"
         row, which Avalonia measures with an effectively unconstrained height by design ("Auto" means
         "give me your true desired size", not "size to available space") - so when the actual host
         (e.g. a resized dockable bottom-panel tab) was shorter than the compose panel's own natural
         height, the excess was silently clipped by the host with nothing to scroll to reach it. The
         compose Border and the timeline ScrollViewer now share the same "*" row (Grid.Row="2" for
         both) instead of the compose panel getting a dedicated "Auto" row ahead of it - since the two
         are already mutually exclusive (IsVisible: EditingNote non-null vs IsTimelineListVisible), only
         one ever actually occupies that row at a time, and it correctly receives the row's real
         available height instead of an unconstrained one. The compose Border's own content is now
         wrapped in its own ScrollViewer (see below) so that real, now-correctly-bounded height acts as
         a genuine scroll boundary instead of a hard clip. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Filter bar (spec 5.1): (Scope) AND (RegisteredTag) AND (search). The period filter
             (DatePicker x2) was removed here (fix request #3, 5th round).
             sa_implement Task 3 (sa_analysis_report.md §10) replaced the separate scope-menu Flyout
             and "Tag ▼" ListBox entirely with one unified search box: Ticker/Watchlist/Portfolio/
             Filter/Tag suggestions all live in NoteTimelineViewModel.AvailableSearchSuggestions, and
             picking any one of them (SelectSuggestion) routes to the matching underlying dimension
             and clears the other two, so only one is ever active at a time. This also removes the
             registered-tag multi-select (OR) behavior in favor of "pick one", matching how Ticker/
             Scope selection already behaved. -->
        <Border Grid.Row="0" Classes="PremiumCard" Margin="0,0,0,8" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Unified Ticker/Watchlist/Portfolio/Filter/Tag search box. FilterMode="Custom"
                     since ItemsSource mixes NoteScopeSuggestion (not the plain-string case
                     FilterMode="StartsWith" was built for); ItemFilter/ItemSelector are delegate-typed
                     CLR properties with no XAML markup, so they're wired in code-behind
                     (NoteTimelineView.axaml.cs constructor). -->
                <AutoCompleteBox x:Name="SearchSuggestionBox" Width="220" Height="28"
                                 VerticalAlignment="Center"
                                 Watermark="{l:Localize Note_SearchSuggestion_Watermark}"
                                 Text="{Binding SearchBoxDisplayText, Mode=OneWay}"
                                 ItemsSource="{Binding AvailableSearchSuggestions}"
                                 FilterMode="Custom"
                                 KeyDown="SearchSuggestionBox_KeyDown"
                                 SelectionChanged="SearchSuggestionBox_SelectionChanged"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 CornerRadius="6">
                    <AutoCompleteBox.ItemTemplate>
                        <StaticResource ResourceKey="SearchSuggestionItemTemplate"/>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <!-- Search text, sized to match SearchSuggestionBox (fix request #4) with a fixed
                     magnifying-glass icon at the left edge (fix request #5). The period filter
                     (DatePicker x2) that previously sat here was removed (fix request #3). -->
                <TextBox Text="{Binding SearchText}" Watermark="{l:Localize Note_SearchText_Watermark}" Width="220" Height="28" VerticalAlignment="Center">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{x:Static c:SharedIconGeometries.Search}"
                                  Width="14" Height="14" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Theme="{DynamicResource PrimaryButtonStyle}" Content="{l:Localize Note_NewNoteButton}" Command="{Binding BeginCreateCommand}" HorizontalAlignment="Right"/>
                <!-- Split from the old single "🗑 Trash" text button (fix request) into two
                     icon+count buttons, one per trash-dialog tab, each opening straight to its own
                     tab (OpenTrashCommand/OpenOrphanedFilesCommand -> ShowNoteTrashDialogAsync). The
                     count TextBlock binds FontSize to DetailFontSize (SA_UI_SUBWINDOW_STANDARD.md
                     §3.1: "secondary labels" - the same semantic size the card's own CreatedAt
                     timestamp uses in NoteCardView.axaml) rather than inheriting the ambient default,
                     which read oversized next to the 14px icon (fix request). -->
                <Button Theme="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenTrashCommand}"
                        HorizontalAlignment="Right" ToolTip.Tip="{l:Localize Note_TrashButton_Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{x:Static c:SharedIconGeometries.Delete}" Width="14" Height="14"/>
                        <TextBlock Text="{Binding DeletedNotesCount}" FontSize="{DynamicResource DetailFontSize}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Theme="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenOrphanedFilesCommand}"
                        HorizontalAlignment="Right" ToolTip.Tip="{l:Localize Note_OrphanedButton_Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Grid Width="16" Height="14" VerticalAlignment="Center">
                            <!-- Base file icon (description.svg) -->
                            <PathIcon Data="M320-240h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Zm280-520h200L520-800v200Z"
                                      Width="12" Height="14"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- Badged broken link overlay (link_off.svg) -->
                            <PathIcon Data="m770-302-60-62q40-11 65-42.5t25-73.5q0-50-35-85t-85-35H520v-80h160q83 0 141.5 58.5T880-480q0 57-29.5 105T770-302ZM634-440l-80-80h86v80h-6ZM792-56 56-792l56-56 736 736-56 56ZM440-280H280q-83 0-141.5-58.5T80-480q0-69 42-123t108-71l74 74h-24q-50 0-85 35t-35 85q0 50 35 85t85 35h160v80ZM320-440v-80h65l79 80H320Z"
                                      Width="9" Height="9"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Text="{Binding OrphanedFilesCount}" FontSize="{DynamicResource DetailFontSize}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Selected-Ticker chip list (fix request: multi-Ticker OR filter, Task F). Each pick from
             the unified search box's Ticker suggestions accumulates here instead of replacing the
             box's own text (SelectSuggestion), so multiple Tickers can be active at once; the ✕
             button on a chip calls RemoveTickerFilterCommand for that single ticker. -->
        <ItemsControl Grid.Row="1" Margin="0,0,0,8" ItemsSource="{Binding SelectedTickerCodes}"
                      IsVisible="{Binding SelectedTickerCodes.Count, Converter={x:Static conv:NumericalConverters.IsGreaterThanZero}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="6,4" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                            <Button Content="{l:Localize Note_RemoveAttachmentButton_Symbol}" Padding="4,0"
                                    Command="{Binding $parent[ItemsControl].((vm:NoteTimelineViewModel)DataContext).RemoveTickerFilterCommand}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Inline compose/edit panel, shown while EditingNote is non-null -->
        <Border Grid.Row="2" Classes="PremiumCard" Margin="0,0,0,8" Padding="12"
                IsVisible="{Binding EditingNote, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- sa_minimal_fix (New Note Polish, 3rd round): wraps the WHOLE compose panel (not just
                 the attachments sub-section below) so it stays reachable via scroll when the panel's
                 own natural height (Ticker row + up to 160px body + up to 160px attachments, easily
                 300px+) exceeds the now-correctly-bounded "*" row height (see the root Grid's own
                 comment for why this row is now bounded rather than "Auto"). Same SidebarScrollViewerTheme
                 (Assets/Styles.axaml, shared with DrawingToolSidebar.axaml) + AllowAutoHide="False" as
                 the attachments ScrollViewer below - no MaxHeight here, since this one should use
                 however much room the row actually has, not a fixed cap. -->
            <ScrollViewer Theme="{StaticResource SidebarScrollViewerTheme}" AllowAutoHide="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" DataContext="{Binding EditingNote}" x:DataType="vm:NoteEditorViewModel">
                <!-- URLs are auto-extracted from Body at Save time (UrlExtractor, spec section 8) -
                     no separate "Add URL" input; typing a http(s):// link directly in the text
                     above is enough, mirroring how #hashtags work.
                     fix request: MaxHeight caps how tall this box (and thus the whole panel) can grow
                     as the user types a long post - beyond that, the TextBox's own internal
                     ScrollViewer (built into Avalonia's default multiline TextBox template) takes
                     over instead of pushing the Ticker input/buttons further down, which previously
                     could shove Save off the bottom of a small window entirely. -->
                <TextBox x:Name="ComposeBodyTextBox" Text="{Binding Body}" Watermark="{l:Localize Note_ComposeBody_Watermark}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"/>

                <!-- Ticker input + Attach image/Cancel/Save all on one row below the body (fix
                     request): previously Attach Image had its own row, and Cancel/Save sat in a
                     separate row below the pending-attachments/error lists, which - combined with the
                     body TextBox's previously-unbounded growth above - could push these controls off
                     screen. Keeping them on a single row directly under the body means they stay
                     reachable regardless of how many pending attachments are listed below. -->
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Related ticker: same AutoCompleteBox+suggestion spec as MainWindow's Symbol
                         selector (fix request #3 / #1 2nd round), via the shared
                         SymbolAutoCompleteInputHelper and the identical suggestion-row ItemTemplate. -->
                    <AutoCompleteBox Grid.Column="0" Width="160" Height="28"
                                     HorizontalAlignment="Left"
                                     Watermark="{l:Localize Note_RelatedTicker_Watermark}"
                                     Text="{Binding RelatedTicker, Mode=OneWay}"
                                     ItemsSource="{Binding AvailableTickers}"
                                     FilterMode="StartsWith"
                                     KeyDown="RelatedTickerBox_KeyDown"
                                     SelectionChanged="RelatedTickerBox_SelectionChanged"
                                     BorderBrush="{DynamicResource Brush.Border}"
                                     BorderThickness="1"
                                     CornerRadius="6">
                        <AutoCompleteBox.ItemTemplate>
                            <StaticResource ResourceKey="TickerSuggestionItemTemplate"/>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>

                    <!-- sa_improve (New Note Polish): order changed to Save, Cancel, Attach (fix
                         request) - was Attach, Cancel, Save. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Theme="{DynamicResource PrimaryButtonStyle}" Content="{l:Localize Btn_Save}" Command="{Binding $parent[UserControl].((vm:NoteTimelineViewModel)DataContext).SaveEditCommand}"/>
                        <Button Theme="{DynamicResource PrimaryButtonStyle}" Content="{l:Localize Btn_Cancel}" Command="{Binding $parent[UserControl].((vm:NoteTimelineViewModel)DataContext).CancelEditCommand}"/>
                        <!-- Image attachments (fix request #3, 2nd round): NoteEditorViewModel already
                             stages/saves these (PendingAttachments/AddPendingAttachment/SaveAsync) - this
                             button and list are the previously-missing UI entry point. -->
                        <Button Theme="{DynamicResource PrimaryButtonStyle}" Content="{l:Localize Note_AttachImageButton}" Click="AttachImageButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- sa_minimal_fix (New Note Polish, "no scrollbar when compose panel content
                     overflows"): the body TextBox above already caps its own growth at MaxHeight=160
                     with an internal scroll (see its own comment), but that only protected against the
                     body itself growing tall - nothing capped PendingAttachments (Task D, Note Tab
                     Enhancements, added after that original fix) or AttachmentErrors below it. With
                     enough staged images the WrapPanel grew without bound and pushed content off screen
                     with no way to scroll to it. Same MaxHeight="160" + internal-scroll pattern as the
                     body TextBox, wrapping both lists together (Spacing="8" here replaces the spacing
                     the outer StackPanel used to provide between them directly).
                     sa_minimal_fix (follow-up, common UI spec "UIレイアウト幅の最適化および
                     スクロールバーの表示制御仕様"): the plain ScrollViewer above scrolled correctly but
                     rendered no visible scrollbar chrome - Avalonia FluentTheme's default ScrollBar is
                     an overlay style that collapses to near-invisible until hovered/dragged, which read
                     as "no scrollbar at all". SidebarScrollViewerTheme (Assets/Styles.axaml, shared
                     with DrawingToolSidebar.axaml - a headless-UI probe confirmed its "*,Auto" content
                     column measures a WrapPanel with the real available width to wrap correctly here
                     AND still renders the sidebar's own fixed-width icon buttons identically, so one
                     shared theme now covers both shapes) isolates the scrollbar into its own dedicated
                     Grid column (never overlapping content) and AllowAutoHide="False" keeps it
                     permanently visible at its standard width instead of only on hover. -->
                <ScrollViewer MaxHeight="160" Theme="{StaticResource SidebarScrollViewerTheme}"
                              AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding PendingAttachments}"
                                      IsVisible="{Binding PendingAttachments.Count, Converter={x:Static conv:NumericalConverters.IsGreaterThanZero}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PendingImageAttachment">
                                    <!-- sa_improve (Note Tab Polish, Task 3): the filename label was removed -
                                         the preview thumbnail (plus the remove button) already reads as the
                                         attachment; the filename is kept reachable via ToolTip on hover instead
                                         of a permanent label (fix request: don't show a filename next to the
                                         preview image). -->
                                    <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="6,4" Margin="0,0,6,6"
                                            ToolTip.Tip="{Binding OriginalFileName}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Image Source="{Binding Preview}"
                                                   Width="{Binding $parent[ItemsControl].((vm:NoteEditorViewModel)DataContext).ThumbnailSizePixels}"
                                                   Height="{Binding $parent[ItemsControl].((vm:NoteEditorViewModel)DataContext).ThumbnailSizePixels}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <Button Content="{l:Localize Note_RemoveAttachmentButton_Symbol}" Padding="4,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:NoteEditorViewModel)DataContext).RemovePendingAttachmentCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding AttachmentErrors}"
                                      IsVisible="{Binding AttachmentErrors.Count, Converter={x:Static conv:NumericalConverters.IsGreaterThanZero}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Semantic.Error}" FontSize="{DynamicResource HelperFontSize}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Timeline: pinned-first, CreatedAt descending (spec 5.4). Hidden while an individual
             Note's detail page (Feature A) is open, i.e. SelectedDetailItem is non-null. -->
        <!-- sa_improve (Note Tab Polish, Task 4): IsVisible now also excludes EditingNote (fix
             request - don't show the posted timeline while composing/editing a Note), via
             NoteTimelineViewModel.IsTimelineListVisible - previously only excluded SelectedDetailItem
             (the detail-page condition, unchanged and still preserved inside that property).
             sa_minimal_fix (New Note Polish, 3rd round): shares Grid.Row="2" with the compose panel
             above now (root Grid reduced from 4 rows to 3) - see the root Grid's own comment for why.
             sa_minimal_fix (common UI spec "UIレイアウト幅の最適化およびスクロールバーの表示制御仕様"):
             same SidebarScrollViewerTheme + AllowAutoHide="False" as the compose panel's attachments
             ScrollViewer above - the default FluentTheme overlay scrollbar collapsed to near-invisible
             outside of hover, which read as no scrollbar at all for the main timeline too.
             NoteCardView content needs real (not infinite) available width to word-wrap/lay out
             correctly; SidebarScrollViewerTheme's "*,Auto" content column provides that (sa_improve,
             SAで制約確認 remediation Finding 3: consolidated from a separate duplicate theme after a
             headless-UI probe confirmed the shared theme also renders DrawingToolSidebar's own
             fixed-width icon buttons identically). -->
        <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="2"
                      Theme="{StaticResource SidebarScrollViewerTheme}" AllowAutoHide="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsTimelineListVisible}">
            <ItemsControl ItemsSource="{Binding DisplayedNotes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoteTimelineItemViewModel">
                        <views:NoteCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Individual Note detail page (Feature A): replaces the list above while
             SelectedDetailItem is non-null (opened via a card's posted-time timestamp,
             NoteCardView.axaml's OpenDetailCommand).
             sa_minimal_fix (New Note Polish, 3rd round): shares Grid.Row="2" with the compose panel
             and timeline above now (root Grid reduced from 4 rows to 3) - see the root Grid's own
             comment for why; already mutually exclusive with both via SelectedDetailItem/EditingNote/
             IsTimelineListVisible. -->
        <views:NoteDetailView Grid.Row="2"
                               IsVisible="{Binding SelectedDetailItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </Grid>
</UserControl>
