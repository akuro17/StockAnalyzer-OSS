<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chart="using:StockAnalyzer.Avalonia.Views.Chart"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels"
             xmlns:core="using:StockAnalyzer.Core.Models"
             xmlns:conv="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             x:Class="StockAnalyzer.Avalonia.Views.Chart.ChartView"
             x:DataType="vm:ChartViewModel">
    <UserControl.Styles>
        <!-- Price Scale Button Style (Ghost Button design for UX) -->
        <Style Selector="Button.price-scale-btn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="36,*">
        <!-- In-Tab Toolbar (FR-70-12) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Background.Tertiary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
                <!-- Synchronization Toggle -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Sync" VerticalAlignment="Center" FontSize="{DynamicResource BaseFontSize}" Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                    <ToggleSwitch IsChecked="{Binding IsSyncEnabled}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Margin="0,8" Width="1" Background="{DynamicResource Brush.Border}"/>

                <!-- Independent Controls (Symbol) -->
                <AutoCompleteBox Width="160" Height="28"
                                 IsEnabled="{Binding !IsSyncEnabled}"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource BaseFontSize}"
                                 Watermark="{l:Localize AddTicker_Placeholder}"
                                 Text="{Binding Symbol, Mode=OneWay}"
                                 ItemsSource="{Binding AvailableTickers}"
                                 FilterMode="StartsWith"
                                 KeyDown="SymbolSearchBox_KeyDown"
                                 SelectionChanged="SymbolSearchBox_SelectionChanged">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2">
                                <TextBlock Text="{Binding}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Semantic.Success}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize AddTicker_SymbolSeparator}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{l:Localize AddTicker_SymbolDescription}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource HelperFontSize}"/>

                                <Border Grid.Column="3" Background="{DynamicResource Brush.Background.Primary}" Padding="4,1" CornerRadius="2" Margin="6,0">
                                    <TextBlock Text="{l:Localize AddTicker_MarketLabel}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontWeight="Bold"/>
                                </Border>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                    <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                          Fill="{DynamicResource Brush.Semantic.Success}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="{l:Localize AddTicker_ValidLabel}" Foreground="{DynamicResource Brush.Semantic.Success}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>

                <!-- Chart Type Selection -->
                <ComboBox ItemsSource="{x:Static vm:ChartViewModel.ChartTypeOptions}" 
                          SelectedItem="{Binding ChartType}" 
                          Width="140" Height="28"
                          FontSize="{DynamicResource BaseFontSize}"
                          VerticalAlignment="Center"/>

                <Separator Margin="0,8" Width="1" Background="{DynamicResource Brush.Border}"/>

                <!-- Local Configuration Commands -->
                <Button Margin="2,0" Padding="4" Height="30" VerticalAlignment="Center"
                        Content="{l:Localize Chart_IndicatorsButton}"
                        Command="{Binding OpenIndicatorSettingsCommand}"
                        Theme="{DynamicResource SecondaryButtonStyle}"/>

                <ToggleButton IsChecked="{Binding IsMainWindowVisible}"
                               Margin="2,0" Padding="4" Height="30" VerticalAlignment="Center"
                               Content="{l:Localize Chart_MainChartToggle}"
                               Theme="{DynamicResource ChartToggleButtonStyle}"/>

                <ToggleButton IsChecked="{Binding IsSubWindowVisible}"
                               Margin="2,0" Padding="4" Height="30" VerticalAlignment="Center"
                               Content="{l:Localize Chart_SubChartToggle}"
                               Theme="{DynamicResource ChartToggleButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <chart:ChartBaseControl ViewModel="{Binding}" 
                                     IsSubWindowVisible="{Binding EffectiveIsSubWindowVisible}"
                                     HoveredCandle="{Binding CurrentHoveredCandle, Mode=TwoWay}">
                <chart:ChartBaseControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Localize Chart_SyncSymbol}" 
                                   Command="{Binding SyncCurrentSymbolCommand}" />
                    </ContextMenu>
                </chart:ChartBaseControl.ContextMenu>
            </chart:ChartBaseControl>

            <!-- Price Scale Overlay -->
            <Button Classes="price-scale-btn"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Margin="0,0,13,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    ZIndex="1000"
                    ToolTip.Tip="{l:Localize PriceScale_Options}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource Color.Background.Hover}"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemControlHighlightListAccentLowBrush"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                </Button.Resources>
                <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41l-0.36,2.54c-0.59,0.24-1.13,0.57-1.62,0.94L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.81,11.69,4.81,12c0,0.31,0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                          Width="14" Height="14"
                          Foreground="{DynamicResource Brush.Foreground.Secondary}"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuItem Header="{l:Localize PriceScale_Linear}" 
                                  Command="{Binding SetPriceScaleCommand}" 
                                  CommandParameter="{x:Static core:PriceScaleType.Linear}">
                            <MenuItem.Icon>
                                <TextBlock Text="✓" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding PriceScale, Converter={x:Static conv:NumericalConverters.IsEqualTo}, ConverterParameter={x:Static core:PriceScaleType.Linear}}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Localize PriceScale_Log}" 
                                  Command="{Binding SetPriceScaleCommand}" 
                                  CommandParameter="{x:Static core:PriceScaleType.Log}">
                            <MenuItem.Icon>
                                <TextBlock Text="✓" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding PriceScale, Converter={x:Static conv:NumericalConverters.IsEqualTo}, ConverterParameter={x:Static core:PriceScaleType.Log}}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Localize PriceScale_Percent}" 
                                  Command="{Binding SetPriceScaleCommand}" 
                                  CommandParameter="{x:Static core:PriceScaleType.Percent}">
                            <MenuItem.Icon>
                                <TextBlock Text="✓" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding PriceScale, Converter={x:Static conv:NumericalConverters.IsEqualTo}, ConverterParameter={x:Static core:PriceScaleType.Percent}}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Localize PriceScale_Inverted}" 
                                  Command="{Binding SetPriceScaleCommand}" 
                                  CommandParameter="{x:Static core:PriceScaleType.Inverted}">
                            <MenuItem.Icon>
                                <TextBlock Text="✓" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding PriceScale, Converter={x:Static conv:NumericalConverters.IsEqualTo}, ConverterParameter={x:Static core:PriceScaleType.Inverted}}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:Localize PriceScale_InvertOscillator}" 
                                  Command="{Binding ToggleInvertOscillatorCommand}"
                                  IsEnabled="{Binding PriceScale, Converter={x:Static conv:NumericalConverters.IsEqualTo}, ConverterParameter={x:Static core:PriceScaleType.Inverted}}">
                            <MenuItem.Icon>
                                <TextBlock Text="✓" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding InvertOscillator}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
