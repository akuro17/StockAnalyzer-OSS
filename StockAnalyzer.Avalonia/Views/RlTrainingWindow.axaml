<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels"
        xmlns:l="using:StockAnalyzer.Avalonia.Markup"
        xmlns:ui="using:StockAnalyzer.Avalonia.Common"
        xmlns:controls="using:StockAnalyzer.Avalonia.Views.Controls"
        x:Class="StockAnalyzer.Avalonia.Views.RlTrainingWindow"
        x:DataType="vm:RlTrainingDialogViewModel"
        AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Window}"
        Title="{l:Localize Rl.Title}"
        Width="{x:Static ui:RlUiLayout.WindowWidth}"
        Height="{x:Static ui:RlUiLayout.WindowHeight}"
        MinWidth="{x:Static ui:RlUiLayout.MinimumWidth}"
        MinHeight="{x:Static ui:RlUiLayout.MinimumHeight}"
        FontSize="{DynamicResource BaseFontSize}"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Header robot/brain feature icon geometry -->
    <StreamGeometry x:Key="RlWindowIconData">M13,3V9H21V3M13,21H21V11H13M3,21H11V15H3M3,13H11V3H3V13Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://StockAnalyzer.Avalonia/Assets/CalendarDatePickerIcon.axaml" />
    <!-- groupHeader / advancedGroupHeader: the group-header styles shared with the Training Wizard and the Portfolio RL window. -->
    <StyleInclude Source="avares://StockAnalyzer.Avalonia/Assets/TrainingGroupHeader.axaml" />
    <!-- Clean, borderless Expander template eliminating default accordion frames and separators while preserving logical tree contracts -->
    <Style Selector="Expander">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <ToggleButton x:Name="ExpanderHeader"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          IsHitTestVisible="False"
                          Focusable="False"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalAlignment="Stretch">
              <ToggleButton.Template>
                <ControlTemplate>
                  <Border Background="Transparent" Padding="0">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Left"
                                      VerticalContentAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Expander.rl-storage /template/ ToggleButton#ExpanderHeader">
      <Setter Property="AutomationProperties.AutomationId" Value="{x:Static ui:RlUiConstants.StorageSettings}" />
    </Style>
    <Style Selector="Expander.rl-maintenance /template/ ToggleButton#ExpanderHeader">
      <Setter Property="AutomationProperties.AutomationId" Value="{x:Static ui:RlUiConstants.MaintenanceSection}" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Padding" Value="{x:Static ui:RlUiLayout.SectionPadding}" />
      <Setter Property="BorderThickness" Value="{x:Static ui:RlUiLayout.SectionBorder}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="{x:Static ui:RlUiLayout.LabelMaximumWidth}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.diagnostic">
      <Setter Property="FontSize" Value="{DynamicResource HelperFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Form Input Control Width, Bounds & Alignment Rules -->
    <Style Selector="NumericUpDown">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
      <Setter Property="MinWidth" Value="{x:Static ui:RlUiLayout.InputMinimumWidth}" />
      <Setter Property="MaxWidth" Value="{x:Static ui:RlUiLayout.InputMaximumWidth}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
      <Setter Property="MinWidth" Value="{x:Static ui:RlUiLayout.InputMinimumWidth}" />
      <Setter Property="MaxWidth" Value="{x:Static ui:RlUiLayout.InputMaximumWidth}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="CalendarDatePicker">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
      <Setter Property="MinWidth" Value="{x:Static ui:RlUiLayout.DateMinimumWidth}" />
      <Setter Property="MaxWidth" Value="{x:Static ui:RlUiLayout.InputMaximumWidth}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="AutoCompleteBox">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
      <Setter Property="MinWidth" Value="{x:Static ui:RlUiLayout.InputMinimumWidth}" />
      <Setter Property="MaxWidth" Value="{x:Static ui:RlUiLayout.InputMaximumWidth}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
      <Setter Property="MinWidth" Value="{x:Static ui:RlUiLayout.InputMinimumWidth}" />
      <Setter Property="MaxWidth" Value="{x:Static ui:RlUiLayout.ChoiceMaximumWidth}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="36" />
    </Style>

    <!-- Button standard per SA_UI_SUBWINDOW_STANDARD: Height 36, center aligned, Theme token compliant -->
    <Style Selector="Button.action">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Theme" Value="{DynamicResource SecondaryButtonStyle}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding TrainCommand}" />
  </Window.KeyBindings>

  <Border BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="{x:Static ui:ToolWindowUiLayout.HeaderRow}" />
        <RowDefinition Height="{x:Static ui:ToolWindowUiLayout.BodyRow}" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="{x:Static ui:ToolWindowUiLayout.FooterRow}" />
      </Grid.RowDefinitions>
      <!-- Header (56px) per SA_UI_SUBWINDOW_STANDARD -->
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource Brush.Border.Primary}"
              BorderThickness="0,0,0,1"
              Padding="24,0"
              Background="{DynamicResource Brush.Background.Tertiary}"
              PointerPressed="OnHeaderPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
            <PathIcon Data="{StaticResource RlWindowIconData}"
                      Width="20" Height="20"
                      Foreground="{DynamicResource Brush.Accent.Primary}" />
            <TextBlock Text="{l:Localize Rl.Title}"
                       Classes="label"
                       FontSize="{DynamicResource TitleFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <!-- Measured result of the selected generation's saved evaluation (nothing is simulated) -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"
                      IsVisible="{Binding HasRiskMetrics}"
                      AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.RiskMetricsHeader}">
            <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="6,2">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="diagnostic" Text="{l:Localize Rl.RiskMetrics.Return}" VerticalAlignment="Center" />
                <TextBlock Classes="value" Text="{Binding CumulativeReturnDisplay}" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="6,2">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="diagnostic" Text="{l:Localize Rl.RiskMetrics.MaxDrawdown}" VerticalAlignment="Center" />
                <TextBlock Classes="value" Text="{Binding MaxDrawdownDisplay}" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock Classes="diagnostic" Text="{Binding RiskMetricsScopeDisplay}" VerticalAlignment="Center" />

          </StackPanel>
        </Grid>
      </Border>

      <!-- Body (Scrollable Workspace) -->
      <ScrollViewer Grid.Row="1"
                    AllowAutoHide="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Grid.IsSharedSizeScope="True"
                    MaxWidth="{x:Static ui:RlUiLayout.FormMaximumWidth}"
                    HorizontalAlignment="Center"
                    Margin="{x:Static ui:RlUiLayout.OuterMargin}"
                    Spacing="{x:Static ui:RlUiLayout.SectionGap}">

          <!-- Group: Basic Settings (what a run needs: symbol, dates, initial equity and costs) -->
          <TextBlock Classes="groupHeader" Text="{l:Localize TrainingWizard_Header_BasicSettings}" />

          <!-- Section 1: Training Setup & Scope -->
          <Border Classes="section">
            <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}">
              <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.G1}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.TrainingSetupSection}" />
              
              <!-- 2-Column Form: Symbol & Dates -->
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}" RowSpacing="{x:Static ui:RlUiLayout.RowSpacing}" IsEnabled="{Binding Editable}">
                <!-- Row 0, Col 0: Symbol Field Unit -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.Symbol}" />
                  <AutoCompleteBox Text="{Binding Symbol, Mode=TwoWay}"
                                   ItemsSource="{Binding AvailableTickers}"
                                   FilterMode="StartsWith"
                                   KeyDown="SymbolSearchBox_KeyDown"
                                   SelectionChanged="SymbolSearchBox_SelectionChanged"
                                   Watermark="{l:Localize AddTicker_Placeholder}"
                                   AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Symbol}"
                                   AutomationProperties.Name="{l:Localize Rl.Symbol}">
                    <AutoCompleteBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2">
                          <TextBlock Classes="value" Text="{Binding}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource Brush.Semantic.Success}"
                                     VerticalAlignment="Center" />
                          <TextBlock Classes="diagnostic" Grid.Column="1" Text="{l:Localize AddTicker_SymbolSeparator}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                          <TextBlock Classes="diagnostic" Grid.Column="2" Text="{l:Localize AddTicker_SymbolDescription}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource HelperFontSize}" />

                          <Border Grid.Column="3" Background="{DynamicResource Brush.Background.Primary}" Padding="4,1" CornerRadius="2" Margin="6,0">
                            <TextBlock Classes="diagnostic" Text="{l:Localize AddTicker_MarketLabel}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontWeight="Bold" />
                          </Border>

                          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" 
                                  Fill="{DynamicResource Brush.Semantic.Success}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Classes="diagnostic" Text="{l:Localize AddTicker_ValidLabel}" Foreground="{DynamicResource Brush.Semantic.Success}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                  </AutoCompleteBox>
                </StackPanel>

                <!-- Row 1, Col 0: Start Date Field Unit -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.StartDate}" />
                  <CalendarDatePicker Classes="isoDate isoDateHint" SelectedDate="{Binding StartDateAsDateTime, Mode=TwoWay}"
                                      Background="{DynamicResource Brush.Background.Tertiary}"
                                      BorderBrush="{DynamicResource Brush.Border.Primary}"
                                      AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StartDate}"
                                      AutomationProperties.Name="{l:Localize Rl.StartDate}" />
                </StackPanel>

                <!-- Row 1, Col 1: End Date Field Unit -->
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.EndDate}" />
                  <CalendarDatePicker Classes="isoDate isoDateHint" SelectedDate="{Binding EndDateExclusiveAsDateTime, Mode=TwoWay}"
                                      Background="{DynamicResource Brush.Background.Tertiary}"
                                      BorderBrush="{DynamicResource Brush.Border.Primary}"
                                      AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.EndDate}"
                                      AutomationProperties.Name="{l:Localize Rl.EndDate}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="diagnostic" Foreground="{DynamicResource Brush.Semantic.Warning}" Text="{Binding DateValidationDisplay}" IsVisible="{Binding IsDateOrderInvalid}" TextWrapping="Wrap" />
              <TextBlock Classes="diagnostic" Foreground="{DynamicResource Brush.Semantic.Warning}" Text="{Binding PeriodStatusDisplay}" IsVisible="{Binding HasPeriodStatus}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.PeriodStatus}" />

            </StackPanel>
          </Border>

          <!-- Section 2: Trading Costs & Capital -->
          <Border Classes="section">
            <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}">
              <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.G2}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CostsSection}" />
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}" RowSpacing="{x:Static ui:RlUiLayout.RowSpacing}" IsEnabled="{Binding Editable}">
                <!-- The concept order shared with the Portfolio RL window: Capital | Flat cost, Unit cost | Slippage, Liquidation penalty -->
                <!-- Row 0: Capital (left) & Flat Cost (right) -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.Capital}" />
                  <NumericUpDown Value="{Binding InitialCapital, Mode=TwoWay}" ui:RlInputValidation.Field="InitialCapital" AutomationProperties.Name="{l:Localize Rl.Capital}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Capital}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.FlatCost}" />
                  <NumericUpDown Value="{Binding CommissionFlat, Mode=TwoWay}" ui:RlInputValidation.Field="CommissionFlat" AutomationProperties.Name="{l:Localize Rl.FlatCost}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.FlatCommission}" />
                </StackPanel>

                <!-- Row 1: Unit Cost (left) & Slippage (right) -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.UnitCost}" />
                  <NumericUpDown Value="{Binding CommissionPerUnit, Mode=TwoWay}" ui:RlInputValidation.Field="CommissionPerUnit" AutomationProperties.Name="{l:Localize Rl.UnitCost}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.UnitCommission}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.Slippage}" />
                  <NumericUpDown Value="{Binding SlippageRatio, Mode=TwoWay}" ui:RlInputValidation.Field="SlippageRatio" AutomationProperties.Name="{l:Localize Rl.Slippage}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Slippage}" />
                </StackPanel>

                <!-- Row 2: Liquidation penalty (left) -->
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.Liquidation}" />
                  <NumericUpDown Value="{Binding LiquidationPenaltyRatio, Mode=TwoWay}" ui:RlInputValidation.Field="LiquidationPenaltyRatio" AutomationProperties.Name="{l:Localize Rl.Liquidation}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Liquidation}" />
                </StackPanel>
              </Grid>
              <!-- The blocking reason of an invalid cost editor sits directly under the costs (it was in the training card) -->
              <TextBlock Classes="diagnostic" Text="{Binding InputStatusDisplay}" IsVisible="{Binding HasInputError}" />
            </StackPanel>
          </Border>

          <!-- Group: Advanced Settings (run conditions and the training / resume controls) -->
          <TextBlock Classes="groupHeader advancedGroupHeader" Text="{l:Localize TrainingWizard_Header_AdvancedSettings}" />

          <!-- Section: Run conditions (continuous policy and its direction model, trial run, short history) -->
          <Border Classes="section">
            <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}">
              <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.RunConditions}" />
              <CheckBox Content="{l:Localize Rl.ContinuousMode}"
                        IsChecked="{Binding UseContinuousPolicy}"
                        IsEnabled="{Binding Editable}"
                        AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.ContinuousMode}" />

              <!-- Continuous Policy Options in 2-Column Grid -->
              <Grid RowDefinitions="Auto" ColumnDefinitions="*,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}" IsVisible="{Binding UseContinuousPolicy}" IsEnabled="{Binding Editable}">
                <!-- Col 0: Frozen Direction Field Unit -->
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.FrozenDirection}" />
                  <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirectionOption}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.FrozenDirection}" IsVisible="{Binding HasDirections}" AutomationProperties.Name="{l:Localize Rl.FrozenDirection}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="{x:Null}">
                        <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="value" Text="{Binding DirectionTemporalDisplay}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.DirectionTemporal}" IsVisible="{Binding HasSelectedDirection}" />
                </StackPanel>

                <!-- Col 1: All Complete Blocks Option -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                  <CheckBox Content="{l:Localize Rl.AllBlockOption}" IsChecked="{Binding UseAllCompleteBlocks}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.AllCompleteBlocks}" Margin="0,24,0,4" />
                  <TextBlock Classes="diagnostic" Text="{Binding DirectionsDisplay}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <!-- Trial run (left) | Short history (right, only when offered) -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}">
                <CheckBox Grid.Column="0" VerticalAlignment="Top" Content="{l:Localize Rl.Smoke}" IsChecked="{Binding SmokeOnly}" IsEnabled="{Binding Editable}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Smoke}" />
                <CheckBox Grid.Column="1" VerticalAlignment="Top" Content="{l:Localize Rl.ShortHistoryOption}" IsChecked="{Binding UseShortHistory}" IsEnabled="{Binding Editable}" IsVisible="{Binding ShowShortHistoryOption}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.ShortHistory}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Section 3: Training & Checkpoints -->
          <Border Classes="section">
            <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}">
              <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.G3}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.TrainingSection}" />
              <Grid RowDefinitions="Auto">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="RlFieldLabel" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="label" Text="{l:Localize Rl.Ui.Field.CompletedSteps}" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding ProcessingStepsDisplay}" />
              </Grid>
              <!-- The progress bar, the phase and the message are in the run-status strip above the footer; the blocking input reason is under the costs. -->
              <!-- Checkpoint section rendered as unified always-expanded subcard with non-interactive header -->
              <Expander IsVisible="{Binding CheckpointAvailable}" IsExpanded="True">
                <Expander.Header>
                  <TextBlock Classes="label" FontWeight="SemiBold" Text="{l:Localize Rl.Checkpoint.Title}" />
                </Expander.Header>
                <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}">
                    <Button Classes="action" Content="{l:Localize Rl.Checkpoint.Inspect}" Command="{Binding InspectCheckpointsCommand}" ToolTip.Tip="{Binding InspectCheckpointsTooltip}" IsEnabled="{Binding CanInspectCheckpoints}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointInspect}" HorizontalAlignment="Left" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding CheckpointRows}" SelectedItem="{Binding SelectedCheckpoint}" IsEnabled="{Binding Editable}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointModels}" IsVisible="{Binding HasCheckpoints}" AutomationProperties.Name="{l:Localize Rl.Checkpoint.Title}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RlTrainingDialogViewModel+CheckpointRow">
                          <TextBlock Classes="value" Text="{Binding Display}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <!-- Checkpoint Status Badge -->
                  <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointStatusBadge}">
                    <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Classes="diagnostic" FontWeight="SemiBold" Text="{Binding CheckpointStatusBadgeDisplay}" VerticalAlignment="Center" />
                    </Border>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}" IsVisible="{Binding HasCheckpoints}">
                    <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}">
                      <CheckBox Content="{l:Localize Rl.Checkpoint.ResumeConfirm}" IsChecked="{Binding ResumeConfirmed}" IsEnabled="{Binding CanConfirmResume}" ToolTip.Tip="{Binding ResumeConfirmTooltip}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointResumeConfirm}" />
                      <Button Classes="action" Content="{l:Localize Rl.Checkpoint.Resume}" Command="{Binding ResumeCheckpointCommand}" ToolTip.Tip="{Binding ResumeTooltip}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointResume}" IsEnabled="{Binding CanResumeCheckpoint}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{x:Static ui:RlUiLayout.FieldGap}">
                      <CheckBox Content="{l:Localize Rl.Checkpoint.AbandonConfirm}" IsChecked="{Binding AbandonConfirmed}" IsEnabled="{Binding CanConfirmAbandon}" ToolTip.Tip="{Binding AbandonConfirmTooltip}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointAbandonConfirm}" />
                      <Button Classes="action" Content="{l:Localize Rl.Checkpoint.Abandon}" Command="{Binding AbandonCheckpointCommand}" ToolTip.Tip="{Binding AbandonTooltip}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointAbandon}" IsEnabled="{Binding CanAbandonCheckpoint}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Grid>
                  <!-- Checkpoint Export & Import Actions -->
                  <StackPanel Orientation="Horizontal" Spacing="{x:Static ui:RlUiLayout.FieldGap}">
                    <Button Classes="action" Content="{l:Localize Rl.Checkpoint.Export}" Command="{Binding ExportCheckpointCommand}" ToolTip.Tip="{l:Localize Rl.Checkpoint.ExportTip}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointExport}" IsVisible="{Binding HasSelectedCheckpoint}" IsEnabled="{Binding CanExportCheckpoint}" />
                    <Button Classes="action" Content="{l:Localize Rl.Checkpoint.Import}" Command="{Binding ImportCheckpointCommand}" ToolTip.Tip="{l:Localize Rl.Checkpoint.ImportTip}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointImport}" IsEnabled="{Binding CanImportCheckpoint}" />
                  </StackPanel>
                  <TextBlock Classes="diagnostic" Text="{Binding CheckpointsDisplay}" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- Group: Results and management (models, verification, storage, maintenance) -->
          <TextBlock Classes="groupHeader advancedGroupHeader" Text="{l:Localize Rl.Ui.Group.Results}" />

          <!-- Section 4: Models & Replay Evaluation -->
          <Border Classes="section">
            <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}">
              <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.G4}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.ModelsSection}" />
              
              <!-- 2-Column Grid for Models: Qualified Models (left) & Active Model (right) -->
              <Grid RowDefinitions="Auto" ColumnDefinitions="*,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}" IsEnabled="{Binding Editable}">
                <!-- Col 0: Qualified Models Field Unit -->
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.QualifiedModels}" />
                  <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModelOption}"
                            AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Models}"
                            IsVisible="{Binding HasModels}"
                            AutomationProperties.Name="{l:Localize Rl.QualifiedModels}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="{x:Null}">
                        <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="value" Text="{Binding ModelsDisplay}"
                             IsVisible="{Binding !HasModels}"
                             VerticalAlignment="Center" Height="36" />
                  <Button Classes="action" Content="{l:Localize Rl.Ui.RemoveModel}"
                          Command="{Binding RemoveSelectedModelCommand}"
                          IsVisible="{Binding SelectedModelHasNoWorkFolder}"
                          AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.RemoveModel}"
                          HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Col 1: Active Model Field Unit -->
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="label" Text="{l:Localize Rl.Ui.Field.ActiveModel}" />
                  <Grid ColumnDefinitions="*,Auto" Height="36">
                    <TextBlock Classes="value" Text="{Binding ActiveDisplay}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{x:Static ui:RlUiLayout.FieldGap}">
                      <Button Classes="action" Content="{l:Localize Rl.Generation.Export}"
                              Command="{Binding ExportGenerationCommand}"
                              IsEnabled="{Binding CanExportGeneration}"
                              ToolTip.Tip="{l:Localize Rl.Generation.ExportTip}"
                              AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.GenerationExport}"
                              IsVisible="{Binding HasSelectedModel}" />
                      <Button Classes="action" Content="{l:Localize Rl.Activate}"
                              Command="{Binding ActivateCommand}"
                              IsEnabled="{Binding CanActivate}"
                              AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Activate}"
                              IsVisible="{Binding ShowActivate}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>

              <SelectableTextBlock Classes="value" Text="{Binding SelectedModelDisplay}" IsVisible="{Binding HasSelectedModel}" TextWrapping="Wrap" />
              <SelectableTextBlock Classes="value" IsVisible="{Binding HasActiveId}" Text="{Binding ActiveId}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.ActiveModel}" />
              <TextBlock Classes="value" Text="{Binding TemporalStatusDisplay}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.TemporalStatus}" IsVisible="{Binding HasSelectedModel}" />

              <!-- Generation Comparison: Validation vs OOS Distribution -->
              <Expander IsVisible="{Binding HasGenerationScatterPoints}" IsExpanded="True">
                <Expander.Header>
                  <TextBlock Classes="label" FontWeight="SemiBold" Text="{l:Localize Rl.Ui.GenerationComparison.Title}" />
                </Expander.Header>
                <StackPanel Spacing="6" Margin="0,6,0,0">
                  <TextBlock Classes="diagnostic" Text="{Binding GenerationComparisonSummary}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding GenerationScatterPoints}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RlGenerationScatterPoint">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="8,4" Margin="0,2">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Classes="value" Text="{Binding ModelId}" TextTrimming="CharacterEllipsis" FontWeight="{Binding SelectionFontWeight}" />
                            <TextBlock Grid.Column="1" Classes="diagnostic" Text="{Binding ValidationDisplay}" />
                            <TextBlock Grid.Column="2" Classes="value" Text="{Binding OosDisplay}" />
                            <Border Grid.Column="3" Background="{Binding QualityBadgeColor}" CornerRadius="3" Padding="6,1">
                              <TextBlock Classes="diagnostic" Foreground="White" Text="{Binding QualityBadge}" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>

              <TextBlock Classes="diagnostic" Text="{Binding EvaluationStateDisplay}" IsVisible="{Binding HasSelectedModel}" />
              <!-- Evaluation Details -->
              <Expander IsVisible="{Binding HasEvaluation}" IsExpanded="True">
                <Expander.Header>
                  <TextBlock Classes="label" Text="{l:Localize Rl.EvaluationDetails}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.EvaluationDetails}" />
                </Expander.Header>
                <TextBlock Classes="diagnostic" Text="{Binding EvaluationReport}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.EvaluationReport}" />
              </Expander>
            </StackPanel>
          </Border>

          <!-- Section 7: Verification & Facts (the fixed run conditions first, then the verification facts) -->
          <Border Classes="section">
            <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}">
              <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.G7}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.VerificationSection}" />
              <ItemsControl ItemsSource="{Binding FixedConditions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RlNamedValue">
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RlFieldLabel" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Classes="label" Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding VerificationFacts}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Disclosure}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RlNamedValue">
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RlFieldLabel" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Classes="label" Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander IsVisible="{Binding HasTechnicalDetails}" IsExpanded="True">
                <Expander.Header>
                  <TextBlock Classes="diagnostic" Text="{l:Localize Rl.Ui.Field.TechnicalDetails}" />
                </Expander.Header>
                <TextBlock Classes="diagnostic" Text="{Binding TechnicalDetails}" TextWrapping="Wrap" />
              </Expander>
            </StackPanel>
          </Border>

          <!-- Section 5: Storage Retention Policy (Unified card layout) -->
          <Border Classes="section" IsVisible="{Binding StorageAvailable}">
            <Expander Classes="rl-storage" IsVisible="{Binding StorageAvailable}" IsExpanded="True">
              <Expander.Header>
                <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.G5}" />
              </Expander.Header>
              <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}" Margin="0,8,0,0">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="{x:Static ui:RlUiLayout.ColumnSpacing}" RowSpacing="{x:Static ui:RlUiLayout.RowSpacing}" IsEnabled="{Binding Editable}">
                  <!-- Row 0: Quota (GiB) & Nonactive days -->
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="{l:Localize Rl.Storage.Quota}" TextWrapping="Wrap" />
                    <NumericUpDown Value="{Binding StorageQuotaGiB}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageQuota}" ui:RlInputValidation.Field="StorageQuotaGiB" AutomationProperties.Name="{l:Localize Rl.Storage.Quota}" />
                  </StackPanel>

                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="{l:Localize Rl.Storage.NonactiveDays}" TextWrapping="Wrap" />
                    <NumericUpDown Value="{Binding StorageNonactiveDays}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageNonactiveDays}" ui:RlInputValidation.Field="StorageNonactiveDays" AutomationProperties.Name="{l:Localize Rl.Storage.NonactiveDays}" />
                  </StackPanel>

                  <!-- Row 1: Minimum free (GiB) & Failed retention days -->
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="{l:Localize Rl.Storage.MinimumFree}" TextWrapping="Wrap" />
                    <NumericUpDown Value="{Binding StorageMinimumFreeGiB}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageMinimumFree}" ui:RlInputValidation.Field="StorageMinimumFreeGiB" AutomationProperties.Name="{l:Localize Rl.Storage.MinimumFree}" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="{l:Localize Rl.Storage.FailedDays}" TextWrapping="Wrap" />
                    <NumericUpDown Value="{Binding StorageFailedRetentionDays}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageFailedDays}" ui:RlInputValidation.Field="StorageFailedRetentionDays" AutomationProperties.Name="{l:Localize Rl.Storage.FailedDays}" />
                  </StackPanel>

                  <!-- Row 2: Model keep count & Checkpoint keep count -->
                  <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="{l:Localize Rl.Storage.KeepCount}" TextWrapping="Wrap" />
                    <NumericUpDown Value="{Binding StorageKeepCount}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageKeepCount}" ui:RlInputValidation.Field="StorageKeepCount" AutomationProperties.Name="{l:Localize Rl.Storage.KeepCount}" />
                  </StackPanel>

                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="label" Text="{l:Localize Rl.Checkpoint.KeepCount}" TextWrapping="Wrap" />
                    <NumericUpDown Value="{Binding StorageCheckpointKeepCount}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.CheckpointKeepCount}" ui:RlInputValidation.Field="StorageCheckpointKeepCount" AutomationProperties.Name="{l:Localize Rl.Checkpoint.KeepCount}" />
                  </StackPanel>
                </Grid>

                <TextBlock Classes="diagnostic" Text="{Binding RetentionDisplay}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Expander>
          </Border>

          <!-- Section 6: Maintenance & Recovery (Unified card layout) -->
          <Border Classes="section" IsVisible="{Binding MaintenanceAvailable}">
            <Expander Classes="rl-maintenance" IsVisible="{Binding MaintenanceAvailable}" IsExpanded="True">
              <Expander.Header>
                <TextBlock Classes="heading" Text="{l:Localize Rl.Ui.Section.G6}" />
              </Expander.Header>
              <StackPanel Spacing="{x:Static ui:RlUiLayout.FieldGap}" Margin="0,8,0,0">
                <StackPanel IsVisible="{Binding StorageAvailable}" Spacing="{x:Static ui:RlUiLayout.FieldGap}">
                  <Button Classes="action" Content="{l:Localize Rl.Storage.Inspect}" Command="{Binding InspectArtifactsCommand}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageInspect}" IsEnabled="{Binding CanInspectArtifacts}" HorizontalAlignment="Left" />
                  <TextBlock Classes="diagnostic" Text="{Binding StorageDisplay}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageSummary}" />
                  <ScrollViewer MaxHeight="{x:Static ui:RlUiConstants.EvaluationMaximumHeight}" IsVisible="{Binding HasArtifacts}">
                    <ItemsControl ItemsSource="{Binding ArtifactRows}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageEntries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RlTrainingDialogViewModel+ArtifactRow">
                          <TextBlock Classes="value" Text="{Binding Display}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <CheckBox Content="{l:Localize Rl.Storage.Confirm}" IsChecked="{Binding CleanupConfirmed}" IsEnabled="{Binding Editable}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageConfirm}" IsVisible="{Binding HasCleanupCandidates}" />
                  <Button Classes="action" Content="{l:Localize Rl.Storage.Cleanup}" Command="{Binding CleanupArtifactsCommand}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StorageCleanup}" IsVisible="{Binding HasCleanupCandidates}" IsEnabled="{Binding CanCleanupArtifacts}" HorizontalAlignment="Left" />
                  <TextBlock Classes="diagnostic" Text="{Binding ArtifactsDisplay}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding RecoveryAvailable}" Spacing="{x:Static ui:RlUiLayout.FieldGap}">
                  <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.RecoveryStatusBadge}">
                    <TextBlock Classes="diagnostic" FontWeight="SemiBold" Text="{Binding RecoveryStatusBadgeDisplay}" />
                  </Border>
                  <TextBlock Classes="diagnostic" Text="{Binding RecoveryDisplay}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.RecoveryPreview}" />
                  <WrapPanel>
                    <Button Classes="action" Content="{l:Localize Rl.InspectRecovery}" Command="{Binding InspectRecoveryCommand}" ToolTip.Tip="{Binding InspectRecoveryTooltip}" IsEnabled="{Binding CanInspectRecovery}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.InspectRecovery}" />
                    <Button Classes="action" Content="{l:Localize Rl.RecoverPointer}" Command="{Binding RecoverPointerCommand}" ToolTip.Tip="{Binding RecoverPointerTooltip}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.RecoverPointer}" IsVisible="{Binding HasRecoveryCandidate}" IsEnabled="{Binding CanRecover}" />
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Expander>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- Run status (outside the scrolled body, directly above the footer): progress, phase and the window message. -->
      <controls:RunStatusStrip Grid.Row="2"
                               ShowProgress="{Binding ShowProgressBar}"
                               IsIndeterminate="{Binding IsProgressIndeterminate}"
                               Percent="{Binding ProgressPercent}"
                               PercentText="{Binding ProgressPercentDisplay}"
                               Phase="{Binding ProgressPhaseDisplay}"
                               Message="{Binding Message}"
                               MessageAutomationId="{x:Static ui:RlUiConstants.Message}" />

      <!-- Footer per SA_UI_SUBWINDOW_STANDARD -->
      <Border Grid.Row="3"
              Height="{x:Static ui:ToolWindowUiLayout.FooterHeight}"
              Background="{DynamicResource Brush.Background.Tertiary}"
              BorderBrush="{DynamicResource Brush.Border.Primary}"
              BorderThickness="0,1,0,0"
              Padding="24,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Left: Status Display -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
            <TextBlock Classes="label" Text="{l:Localize Rl.Ui.Field.Status}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0" />
            <TextBlock Classes="value" Text="{Binding StatusDisplay}" AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Status}" FontWeight="SemiBold" />
          </StackPanel>

          <!-- Next to the status: the one reason Start is disabled (blocking reasons only) above the state labels of the options that change what the result means.
               Two rows in a cell of the star column, so neither can push the other (or the buttons) out of the window: the reason keeps the cell width, the labels wrap. -->
          <Grid Grid.Column="1" RowDefinitions="Auto,Auto" Margin="{x:Static ui:RunModeBadgeLayout.FooterMargin}" VerticalAlignment="Center">
            <TextBlock Classes="diagnostic" Text="{Binding StartBlockerDisplay}" IsVisible="{Binding HasStartBlocker}"
                       Foreground="{DynamicResource Brush.Semantic.Warning}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.StartBlocker}" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ModeBadges}" IsVisible="{Binding HasModeBadges}" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.ModeBadges}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="{x:Static ui:RunModeBadgeLayout.Spacing}" LineSpacing="{x:Static ui:RunModeBadgeLayout.LineSpacing}" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="{x:Static ui:RunModeBadgeLayout.Corner}" Padding="{x:Static ui:RunModeBadgeLayout.Padding}">
                    <TextBlock Classes="diagnostic" Text="{Binding}" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- Right: Action Buttons per SA_UI_SUBWINDOW_STANDARD Footer specifications -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
            <Button Content="{l:Localize Rl.Train}"
                    Command="{Binding TrainCommand}"
                    IsEnabled="{Binding CanTrain}"
                    AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Train}"
                    Theme="{DynamicResource PrimaryButtonStyle}"
                    FontWeight="Bold"
                    Height="36" Padding="20,0" MinWidth="110" />
            <Button Content="{l:Localize Rl.Checkpoint.Pause}"
                    Command="{Binding PauseCommand}"
                    IsVisible="{Binding ShowPause}"
                    IsEnabled="{Binding CanPause}"
                    AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Pause}"
                    Theme="{DynamicResource SecondaryButtonStyle}"
                    Height="36" Padding="16,0" MinWidth="90" />
            <Button Content="{l:Localize Rl.Cancel}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="{x:Static ui:RlUiConstants.Cancel}"
                    IsVisible="{Binding ShowCancel}"
                    IsEnabled="{Binding CanCancel}"
                    Theme="{DynamicResource SecondaryButtonStyle}"
                    Height="36" Padding="16,0" MinWidth="90" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
