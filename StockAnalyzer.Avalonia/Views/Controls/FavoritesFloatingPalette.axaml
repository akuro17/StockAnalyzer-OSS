<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels"
             x:Class="StockAnalyzer.Avalonia.Views.Controls.FavoritesFloatingPalette"
             x:DataType="vm:DrawingToolSidebarViewModel"
             IsVisible="{Binding ShowFavoritesPalette}">

    <UserControl.Styles>
        <Style Selector="Button.FavToolButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        </Style>
        <Style Selector="Button.FavToolButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Hover}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Brush.Background.Secondary}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4"
            Margin="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BoxShadow="2 2 8 0 #40000000">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <!-- Star indicator -->
            <TextBlock Text="★" FontSize="{DynamicResource BaseFontSize}" VerticalAlignment="Center"
                       Margin="4,0" Opacity="0.6"/>
            <ItemsControl ItemsSource="{Binding Favorites}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="FavToolButton"
                                Command="{Binding SelectCommand}"
                                ToolTip.Tip="{Binding NameKey}">
                            <TextBlock Text="{Binding Icon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
