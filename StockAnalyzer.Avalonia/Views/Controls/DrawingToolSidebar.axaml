<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels"
             xmlns:views="using:StockAnalyzer.Avalonia.Views"
             xmlns:conv="using:StockAnalyzer.Avalonia.Converters"
             xmlns:c="using:StockAnalyzer.Avalonia.Common"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             x:Class="StockAnalyzer.Avalonia.Views.Controls.DrawingToolSidebar"
             x:DataType="vm:DrawingToolSidebarViewModel"
             ClipToBounds="False">

    <UserControl.Resources>
        <conv:BoolToStarConverter x:Key="BoolToStarConverter"/>
        <!-- SidebarScrollViewerTheme (Non-Overlay ScrollBar Separation, DRAWING_TOOLS_SPEC.md) now
             lives in Assets/Styles.axaml (sa_minimal_fix, Notes tab scrollbar fix) so
             NoteTimelineView.axaml can reuse the identical ControlTheme instead of duplicating it. -->
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Category icon button style -->
        <Style Selector="Button.CategoryButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.CategoryButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Hover}"/>
        </Style>
        <Style Selector="Button.CategoryButton.selected">
            <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
        </Style>

        <!-- Tool item button in flyout -->
        <Style Selector="Button.ToolItemButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ToolItemButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Hover}"/>
        </Style>

        <!-- Selected tool highlight -->
        <Style Selector="Button.ToolItemSelected">
            <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Hover}"/>
        </Style>

        <!-- Favorite toggle button -->
        <Style Selector="Button.FavoriteButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.FavoriteButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Hover}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,Auto" PointerExited="Sidebar_PointerExited" ClipToBounds="False">
        <!-- Left: Vertical Sidebar with Category Icons & Bottom Layer Manager Button -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Background.Secondary}"
                MinWidth="44"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">
                <!-- Top: Drawing Tool Categories -->
                <ScrollViewer Grid.Row="0"
                              Theme="{StaticResource SidebarScrollViewerTheme}"
                              AllowAutoHide="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="CategoryButton"
                                        PointerEntered="CategoryButton_PointerEntered">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="{DynamicResource TitleFontSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom: Drawing Objects / Layer Manager Toggle Button -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="0,4">
                    <Button Classes="CategoryButton"
                            Classes.selected="{Binding IsObjectsPanelOpen}"
                            Command="{Binding ToggleObjectsPanelCommand}"
                            ToolTip.Tip="{l:Localize Objects_TabTitle}"
                            HorizontalAlignment="Left">
                        <PathIcon Data="{x:Static c:SharedIconGeometries.Layer}"
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Right: Category Flyout Panel (visible when a category is expanded) -->
        <Border Grid.Column="1"
                IsVisible="{Binding IsFlyoutOpen}"
                Background="{DynamicResource Brush.Background.Primary}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0"
                MinWidth="200"
                MaxWidth="260"
                Padding="4">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="{Binding ExpandedCategory.DisplayName}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Foreground.Secondary}"
                           Margin="8,4,8,8"
                           VerticalAlignment="Center"/>
                <!-- sa_improve (共通UI仕様「UIレイアウト幅の最適化およびスクロールバーの表示制御仕様」準拠):
                     元は既定のプレーンScrollViewerで、Avalonia FluentThemeのOverlay/Auto-hideスクロール
                     バー（ホバー時以外は細く縮小しコンテンツと重なる）のままだった。左のアイコン列（上の
                     ScrollViewer, Grid.Row="0"）と同じSidebarScrollViewerThemeを適用し、コンテンツ列と
                     スクロールバー列をGridで物理分離、AllowAutoHide="False"で常時標準幅表示にする。 -->
                <ScrollViewer Grid.Row="1" Theme="{StaticResource SidebarScrollViewerTheme}"
                              AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ExpandedCategory.Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes.ToolItemButton="True"
                                    Classes.ToolItemSelected="{Binding IsSelected}"
                                    Command="{Binding SelectCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <!-- Tool Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontSize="{DynamicResource BaseFontSize}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <!-- Tool Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource BaseFontSize}"/>

                                    <!-- Favorite Toggle (★/☆) -->
                                    <Button Grid.Column="2"
                                            Classes="FavoriteButton"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToStarConverter}}"
                                                   FontSize="{DynamicResource BaseFontSize}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Selection Indicator (✓) -->
                                    <TextBlock Grid.Column="3"
                                               Text="✓"
                                               FontSize="{DynamicResource BaseFontSize}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               IsVisible="{Binding IsSelected}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: Drawing Objects Manager Panel (visible when Objects button is toggled) -->
        <Border Grid.Column="1"
                IsVisible="{Binding IsObjectsPanelOpen}"
                Background="{DynamicResource Brush.Background.Primary}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0"
                Width="300"
                MinWidth="280"
                MaxWidth="380">
            <views:DrawingObjectsView DataContext="{Binding DrawingObjectsViewModel}"/>
        </Border>
    </Grid>
</UserControl>
