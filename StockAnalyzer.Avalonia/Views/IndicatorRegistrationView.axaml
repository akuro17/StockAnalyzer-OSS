<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels"
             xmlns:models="using:StockAnalyzer.Core.Models.Screener"
             xmlns:controls="using:StockAnalyzer.Avalonia.Views.Controls"
             xmlns:converters="using:StockAnalyzer.Avalonia.Converters"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             xmlns:c="clr-namespace:StockAnalyzer.Core.Constants;assembly=StockAnalyzer.Core"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="StockAnalyzer.Avalonia.Views.IndicatorRegistrationView"
             x:DataType="vm:IndicatorRegistrationViewModel"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <GridLength x:Key="ScreenerLabelColumnWidth">260</GridLength>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ModeSwitch button style linked to Theme with sufficient padding preventing bottom edge clipping -->
        <Style Selector="Button.ModeSwitch">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- GridSplitter Drag Visual Highlight harmonized with theme background -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
        </Style>
    </UserControl.Styles>

    <!-- Resizable 3-Column Layout with Star Proportions and Active GridSplitters -->
    <Grid ColumnDefinitions="220*, Auto, 260*, Auto, 450*" Margin="0,4,0,0">

        <!-- Column 1: Navigation Groups (Indicators, Columns, Criteria) -->
        <Border Grid.Column="0"
                MinWidth="150"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">
            <ListBox ItemsSource="{Binding NavGroups}"
                     SelectedItem="{Binding SelectedGroupItem}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:ScreenerGroupDisplayItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="3"/>
                        <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
                        <Setter Property="IsEnabled" Value="{Binding !IsHeader}"/>
                    </Style>
                    <Style Selector="ListBoxItem[IsEnabled=False]">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScreenerGroupDisplayItem">
                        <Panel>
                            <!-- Category Parent Header Row -->
                            <Border IsVisible="{Binding IsHeader}"
                                    Background="{DynamicResource Brush.Background.Tertiary}"
                                    CornerRadius="4"
                                    Padding="6,4"
                                    Margin="-6,4,-6,2">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource DetailFontSize}"
                                           Foreground="{DynamicResource Brush.Accent.Primary}"/>
                            </Border>

                            <!-- Top-Level "All Filters" Row (Unified ListBoxItem Selection & Hover Background with Filter Icon & Accent Color) -->
                            <StackPanel IsVisible="{Binding IsAllFilters}"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <PathIcon Data="M10,18h4v-2h-4V18z M3,6v2h18V6H3z M6,13h12v-2H6V13z"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource Brush.Accent.Primary}"/>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource DetailFontSize}"
                                           Foreground="{DynamicResource Brush.Accent.Primary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Standard Sub-Group Item Row -->
                            <TextBlock IsVisible="{Binding IsStandardItem}"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- User Resizable Splitter 1: Between Navigation Panel and Catalog List -->
        <GridSplitter Grid.Column="1"
                      Width="8"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Cursor="SizeWestEast"
                      Margin="2,0"/>

        <!-- Column 2: Items Catalog List & Search -->
        <Border Grid.Column="2"
                MinWidth="180"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <Grid RowDefinitions="Auto, *">
                <!-- Search Box -->
                <TextBox Grid.Row="0"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="{l:Localize Indicator_SearchPlaceholder}"
                         Height="34"
                         Classes="clearButton"
                         Margin="0,0,0,8"/>

                <!-- Items List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredIndicators}"
                         SelectedItem="{Binding SelectedIndicator}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ScreenerCatalogItem">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ShortName}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource DetailFontSize}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="{DynamicResource HelperFontSize}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- User Resizable Splitter 2: Between Catalog List and Condition Settings -->
        <GridSplitter Grid.Column="3"
                      Width="8"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Cursor="SizeWestEast"
                      Margin="2,0"/>

        <!-- Column 3: Focus-Bind Condition Configuration Area -->
        <Border Grid.Column="4"
                MinWidth="300"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel Spacing="10">

                    <!-- Container 1: Left Target (Source) -->
                    <Border Classes.active="{Binding IsLeftActive}"
                            CornerRadius="6"
                            Padding="12"
                            PointerPressed="OnLeftContainerPointerPressed">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
                                <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                            <!-- High Contrast Active Border Styling -->
                            <Style Selector="Border.active">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{DynamicResource Brush.Background.Tertiary}"/>
                            </Style>
                        </Border.Styles>

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Left Target (Source)"
                                               FontSize="{DynamicResource BaseFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Accent.Primary}"/>
                                    <Border IsVisible="{Binding IsLeftActive}"
                                            Background="{DynamicResource Brush.Accent.Primary}"
                                            CornerRadius="3"
                                            Padding="6,2">
                                        <TextBlock Text="ACTIVE FOCUS"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Selected Left Indicator Name -->
                            <TextBlock Text="{Binding LeftSelectedIndicator.DisplayName, FallbackValue='Select an indicator from catalog'}"
                                       FontSize="{DynamicResource DetailFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>

                            <!-- Left Parameters Form Card Box -->
                            <Border BorderBrush="{DynamicResource Brush.Border.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{DynamicResource Brush.Background.Primary}"
                                    ClipToBounds="True"
                                    Padding="0"
                                    Margin="0,4,0,0">
                                <StackPanel Spacing="0">
                                    <!-- Left Output Series Selector -->
                                    <Border IsVisible="{Binding HasMultipleLeftOutputs}">
                                        <Grid MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Brush.Background.Tertiary}"
                                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                                    BorderThickness="0,0,1,0"
                                                    Padding="12,0,8,0"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="{l:Localize Label_DisplayItemSelection}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Border>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding LeftAvailableOutputs}"
                                                      SelectedItem="{Binding LeftSelectedOutput}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="12,0,0,0"
                                                      Height="30"
                                                      Width="140"/>
                                        </Grid>
                                    </Border>

                                    <!-- Dynamic Parameters View for Left Indicator -->
                                    <controls:DynamicIndicatorSettingsView ParameterObject="{Binding LeftIndicatorSettings.ParameterObject}"
                                                                            Margin="0"/>

                                    <!-- Left TimeFrame -->
                                    <Border>
                                        <Grid MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Brush.Background.Tertiary}"
                                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                                    BorderThickness="0,0,1,0"
                                                    Padding="12,0,8,0"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="{l:Localize Label_TimeFrame}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Border>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AvailableTimeFrames}"
                                                      SelectedItem="{Binding LeftSelectedTimeFrameItem}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="12,0,0,0"
                                                      Height="30"
                                                      Width="140">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Left Offset -->
                                    <Border>
                                        <Grid MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Brush.Background.Tertiary}"
                                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                                    BorderThickness="0,0,1,0"
                                                    Padding="12,0,8,0"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="{l:Localize Label_Offset}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Border>
                                            <NumericUpDown Grid.Column="1"
                                                           Value="{Binding LeftOffset}"
                                                           Minimum="0"
                                                           Maximum="500"
                                                           Increment="1"
                                                           Height="30"
                                                           Width="140"
                                                           Padding="6,2"
                                                           Margin="12,0,0,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Middle Section: Operator, Target Mode Switch & Action Button -->
                    <Border Background="{DynamicResource Brush.Background.Tertiary}"
                            BorderBrush="{DynamicResource Brush.Border.Primary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <Grid ColumnDefinitions="Auto, 14, Auto, 14, Auto, 14, Auto" RowDefinitions="Auto" HorizontalAlignment="Center">
                            <!-- Action Button on Column 0 -->
                            <Button Grid.Column="0"
                                    Content="Add"
                                    Command="{Binding RegisterIndicatorCommand}"
                                    IsEnabled="{Binding LeftSelectedIndicator, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                    Height="34"
                                    Padding="16,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <!-- Action Controls on Row 0 -->
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding AvailableComparisonOperators}"
                                      SelectedItem="{Binding SelectedComparisonOperator}"
                                      Height="34"
                                      Width="90"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ComparisonOperator">
                                        <TextBlock Text="{Binding Converter={x:Static converters:ComparisonOperatorConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid Grid.Column="4" ColumnDefinitions="36, 36, 36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Grid.Column="0"
                                        Content="123"
                                        Command="{Binding SetRightModeNumericCommand}"
                                        Classes="ModeSwitch"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        Margin="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="4,0,0,4"
                                        Theme="{Binding IsRightNumericMode, Converter={x:Static converters:BoolToButtonThemeConverter.Instance}}"/>
                                <Button Grid.Column="1"
                                        Content="Txt"
                                        Command="{Binding SetRightModeStringCommand}"
                                        Classes="ModeSwitch"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        Margin="-1,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="0"
                                        Theme="{Binding IsRightStringMode, Converter={x:Static converters:BoolToButtonThemeConverter.Instance}}"/>
                                <Button Grid.Column="2"
                                        Content="Ind"
                                        Command="{Binding SetRightModeIndicatorCommand}"
                                        Classes="ModeSwitch"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        Margin="-1,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="0,4,4,0"
                                        Theme="{Binding IsRightIndicatorMode, Converter={x:Static converters:BoolToButtonThemeConverter.Instance}}"/>
                            </Grid>

                            <!-- Logical Join AND/OR Buttons (Restored for Screener, Hidden when IsLogicalJoinVisible is False) -->
                            <Grid Grid.Column="6" IsVisible="{Binding IsLogicalJoinVisible}" ColumnDefinitions="48, 48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Grid.Column="0"
                                        Content="AND"
                                        Command="{Binding SetLogicalAndCommand}"
                                        Classes="ModeSwitch"
                                        Width="48"
                                        Height="32"
                                        Padding="0"
                                        Margin="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="4,0,0,4"
                                        Theme="{Binding IsLogicalAnd, Converter={x:Static converters:BoolToButtonThemeConverter.Instance}}"/>
                                <Button Grid.Column="1"
                                        Content="OR"
                                        Command="{Binding SetLogicalOrCommand}"
                                        Classes="ModeSwitch"
                                        Width="48"
                                        Height="32"
                                        Padding="0"
                                        Margin="-1,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="0,4,4,0"
                                        Theme="{Binding IsLogicalOr, Converter={x:Static converters:BoolToButtonThemeConverter.Instance}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Container 2: Right Target -->
                    <Border Classes.active="{Binding IsRightActive}"
                            CornerRadius="6"
                            Padding="12"
                            PointerPressed="OnRightContainerPointerPressed">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
                                <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                            <!-- High Contrast Active Border Styling -->
                            <Style Selector="Border.active">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{DynamicResource Brush.Background.Tertiary}"/>
                            </Style>
                        </Border.Styles>

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Right Target"
                                               FontSize="{DynamicResource BaseFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Accent.Primary}"/>
                                    <Border IsVisible="{Binding IsRightActive}"
                                            Background="{DynamicResource Brush.Accent.Primary}"
                                            CornerRadius="3"
                                            Padding="6,2">
                                        <TextBlock Text="ACTIVE FOCUS"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- String Input Mode View -->
                            <Border IsVisible="{Binding IsRightStringMode}"
                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{DynamicResource Brush.Background.Primary}"
                                    ClipToBounds="True"
                                    Padding="0"
                                    Margin="0,4,0,0">
                                <Grid MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource Brush.Background.Tertiary}"
                                            BorderBrush="{DynamicResource Brush.Border.Primary}"
                                            BorderThickness="0,0,1,0"
                                            Padding="12,0,8,0"
                                            VerticalAlignment="Stretch">
                                        <TextBlock Text="{l:Localize FilterSettings_Value}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding RightStringValue, Mode=TwoWay}"
                                             Watermark="{l:Localize Watermark_SearchText}"
                                             Height="30"
                                             Width="180"
                                             Padding="8,0"
                                             Margin="12,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Numeric Input Mode View -->
                            <Border IsVisible="{Binding IsRightNumericMode}"
                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{DynamicResource Brush.Background.Primary}"
                                    ClipToBounds="True"
                                    Padding="0"
                                    Margin="0,4,0,0">
                                <Grid MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource Brush.Background.Tertiary}"
                                            BorderBrush="{DynamicResource Brush.Border.Primary}"
                                            BorderThickness="0,0,1,0"
                                            Padding="12,0,8,0"
                                            VerticalAlignment="Stretch">
                                        <TextBlock Text="{l:Localize Label_NumericValue}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding RightNumericValue}"
                                                   Increment="1"
                                                   FormatString="0.00"
                                                   Height="30"
                                                   Width="140"
                                                   Padding="6,2"
                                                   Margin="12,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Indicator Mode View -->
                            <StackPanel IsVisible="{Binding IsRightIndicatorMode}" Spacing="8">
                                <TextBlock Text="{Binding RightSelectedIndicator.DisplayName, FallbackValue='Select an indicator from catalog'}"
                                           FontSize="{DynamicResource DetailFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>

                                <!-- Right Parameters Form Card Box -->
                                <Border BorderBrush="{DynamicResource Brush.Border.Primary}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.Background.Primary}"
                                        ClipToBounds="True"
                                        Padding="0"
                                        Margin="0,4,0,0">
                                    <StackPanel Spacing="0">
                                        <!-- Right Output Series Selector -->
                                        <Border IsVisible="{Binding HasMultipleRightOutputs}">
                                            <Grid MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource Brush.Background.Tertiary}"
                                                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                                                        BorderThickness="0,0,1,0"
                                                        Padding="12,0,8,0"
                                                        VerticalAlignment="Stretch">
                                                    <TextBlock Text="{l:Localize Label_DisplayItemSelection}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                </Border>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding RightAvailableOutputs}"
                                                          SelectedItem="{Binding RightSelectedOutput}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Margin="12,0,0,0"
                                                          Height="30"
                                                          Width="140"/>
                                            </Grid>
                                        </Border>

                                        <!-- Dynamic Parameters View for Right Indicator -->
                                        <controls:DynamicIndicatorSettingsView ParameterObject="{Binding RightIndicatorSettings.ParameterObject}"
                                                                                Margin="0"/>

                                        <!-- Right TimeFrame -->
                                        <Border>
                                            <Grid MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource Brush.Background.Tertiary}"
                                                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                                                        BorderThickness="0,0,1,0"
                                                        Padding="12,0,8,0"
                                                        VerticalAlignment="Stretch">
                                                    <TextBlock Text="{l:Localize Label_TimeFrame}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                </Border>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableTimeFrames}"
                                                          SelectedItem="{Binding RightSelectedTimeFrameItem}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Margin="12,0,0,0"
                                                          Height="30"
                                                          Width="140">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <!-- Right Offset -->
                                        <Border>
                                            <Grid MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ScreenerLabelColumnWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource Brush.Background.Tertiary}"
                                                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                                                        BorderThickness="0,0,1,0"
                                                        Padding="12,0,8,0"
                                                        VerticalAlignment="Stretch">
                                                    <TextBlock Text="{l:Localize Label_Offset}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                </Border>
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding RightOffset}"
                                                               Minimum="0"
                                                               Maximum="500"
                                                               Increment="1"
                                                               Height="30"
                                                               Width="140"
                                                               Padding="6,2"
                                                               Margin="12,0,0,0"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
