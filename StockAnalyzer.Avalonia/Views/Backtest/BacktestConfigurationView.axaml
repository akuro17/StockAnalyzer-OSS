<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Backtest"
             xmlns:conv="using:StockAnalyzer.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="StockAnalyzer.Avalonia.Views.Backtest.BacktestConfigurationView"
             x:DataType="vm:BacktestWindowViewModel">
    <UserControl.Resources>
        <conv:EnumToLocalizedDisplayNameConverter x:Key="EnumToLocalizedDisplayNameConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- CalendarDatePicker button icon: the shared date_range visual (replaces the default day-number glyph). -->
        <StyleInclude Source="avares://StockAnalyzer.Avalonia/Assets/CalendarDatePickerIcon.axaml"/>
        <Style Selector="TextBlock.GroupTitle">
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.HelperText">
            <Setter Property="FontSize" Value="{DynamicResource HelperFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        </Style>
        <!-- Section cards: permanently visible Border panels without expand/collapse toggles -->
        <Style Selector="Border.GroupCard">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
        </Style>

        <!-- Vertical Field Unit Styling -->
        <Style Selector="StackPanel.FieldUnit">
            <Setter Property="Spacing" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- Consistent Input Control Sizing & Constraints -->
        <Style Selector="StackPanel.FieldUnit > AutoCompleteBox,
                         StackPanel.FieldUnit > ComboBox,
                         StackPanel.FieldUnit > CalendarDatePicker,
                         StackPanel.FieldUnit > NumericUpDown">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AllowAutoHide="False"
                  Padding="0,0,12,0">
        <StackPanel Margin="16">

            <!-- Group A: Target Data and Evaluation Period -->
            <Border Classes="GroupCard">
                <StackPanel>
                    <TextBlock Classes="GroupTitle" Text="{l:Localize Backtest_GroupA_Title}"/>
                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="24" RowSpacing="12" RowDefinitions="Auto,Auto">
                        <!-- Row 0: Symbol | Frame -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_Symbol}"/>
                            <AutoCompleteBox AutomationProperties.AutomationId="Backtest_Symbol"
                                             Text="{Binding Symbol, Mode=TwoWay}"
                                             ItemsSource="{Binding AvailableSymbols}"
                                             FilterMode="StartsWith">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Semantic.Success}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{l:Localize AddTicker_SymbolSeparator}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{l:Localize AddTicker_SymbolDescription}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource HelperFontSize}"/>

                                            <Border Grid.Column="3" Background="{DynamicResource Brush.Background.Primary}" Padding="4,1" CornerRadius="2" Margin="6,0">
                                                <TextBlock Text="{l:Localize AddTicker_MarketLabel}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontWeight="Bold"/>
                                            </Border>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                      Fill="{DynamicResource Brush.Semantic.Success}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{l:Localize AddTicker_ValidLabel}" Foreground="{DynamicResource Brush.Semantic.Success}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_Frame}"/>
                            <ComboBox ItemsSource="{Binding AvailableFrames}" SelectedItem="{Binding Frame}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Row 1: Start Date | End Date -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_EvaluationStartUtc}"/>
                            <CalendarDatePicker Classes="isoDate" SelectedDate="{Binding EvaluationStartUtc}"
                                                ToolTip.Tip="{Binding EvaluationStartUtcTooltip}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_EvaluationEndUtc}"/>
                            <CalendarDatePicker Classes="isoDate" SelectedDate="{Binding EvaluationEndUtc}"
                                                ToolTip.Tip="{Binding EvaluationEndUtcTooltip}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group B: Capital and Cost Model -->
            <Border Classes="GroupCard">
                <StackPanel>
                    <TextBlock Classes="GroupTitle" Text="{l:Localize Backtest_GroupB_Title}"/>
                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="24" RowSpacing="12" RowDefinitions="Auto,Auto,Auto">
                        <!-- Row 0: Initial Capital | Slippage Ratio -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_InitialCapital}"/>
                            <NumericUpDown Value="{Binding InitialCapital}" Minimum="0" Increment="1000" FormatString="0.####"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_SlippageRatio}"/>
                            <NumericUpDown Value="{Binding SlippageRatio}" Minimum="{Binding SlippageRatioMinimum}" Maximum="{Binding SlippageRatioMaximum}" Increment="0.001" FormatString="0.####"/>
                        </StackPanel>

                        <!-- Row 1: Commission Flat | Commission Per Unit -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_CommissionFlat}"/>
                            <NumericUpDown Value="{Binding CommissionFlat}" Minimum="0" Increment="1" FormatString="0.####"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_CommissionPerUnit}"/>
                            <NumericUpDown Value="{Binding CommissionPerUnit}" Minimum="0" Increment="0.01" FormatString="0.####"/>
                        </StackPanel>

                        <!-- Row 2: Sizing Model | Sizing Parameter -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_SizingModel}"/>
                            <ComboBox ItemsSource="{Binding AvailableSizingModels}" SelectedItem="{Binding SizingModel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_SizingParameter}"/>
                            <NumericUpDown Value="{Binding SizingParameter}" Minimum="0" Increment="1" FormatString="0.####"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group C: Margin Model -->
            <Border Classes="GroupCard">
                <StackPanel>
                    <TextBlock Classes="GroupTitle" Text="{l:Localize Backtest_GroupC_Title}"/>
                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="24" RowSpacing="12" RowDefinitions="Auto,Auto">
                        <!-- Row 0: Initial Margin Ratio | Maintenance Margin Ratio -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_InitialMarginRatio}"/>
                            <NumericUpDown Value="{Binding InitialMarginRatio}" Minimum="{Binding InitialMarginRatioMinimum}" Maximum="{Binding InitialMarginRatioMaximum}" Increment="0.01" FormatString="0.####"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_MaintenanceMarginRatio}"/>
                            <NumericUpDown Value="{Binding MaintenanceMarginRatio}" Minimum="{Binding MaintenanceMarginRatioMinimum}" Maximum="{Binding MaintenanceMarginRatioMaximum}" Increment="0.01" FormatString="0.####"/>
                        </StackPanel>

                        <!-- Row 1: Liquidation Penalty Ratio | (Empty Column 1) -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_LiquidationPenaltyRatio}"/>
                            <NumericUpDown Value="{Binding LiquidationPenaltyRatio}" Minimum="{Binding LiquidationPenaltyRatioMinimum}" Maximum="{Binding LiquidationPenaltyRatioMaximum}" Increment="0.001" FormatString="0.####"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group D: Report & Bootstrap Parameters -->
            <Border Classes="GroupCard">
                <StackPanel>
                    <TextBlock Classes="GroupTitle" Text="{l:Localize Backtest_GroupD_Title}"/>
                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="24" RowSpacing="12" RowDefinitions="Auto,Auto">
                        <!-- Row 0: Annual Risk Free Rate | Annual MAR -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_AnnualRiskFreeRate}"/>
                            <NumericUpDown Value="{Binding AnnualRiskFreeRate}" Minimum="-0.999" Increment="0.001" FormatString="0.####"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_AnnualMAR}"/>
                            <NumericUpDown Value="{Binding AnnualMar}" Minimum="-0.999" Increment="0.001" FormatString="0.####"/>
                        </StackPanel>

                        <!-- Row 1: Bootstrap Seed | Bootstrap Iterations -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_BootstrapSeed}"/>
                            <NumericUpDown Value="{Binding BootstrapSeed}" Increment="1" FormatString="0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Classes="FieldUnit">
                            <TextBlock Classes="FieldLabel" Text="{l:Localize Backtest_Field_BootstrapIterations}"/>
                            <NumericUpDown AutomationProperties.AutomationId="Backtest_BootstrapIterations"
                                           Value="{Binding BootstrapIterations}" Minimum="1000" Increment="500" FormatString="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 1-Column Section: Annual Periods By Frame (Dynamic ItemsControl) -->
                    <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="FieldLabel" FontWeight="Bold" Text="{l:Localize Backtest_Field_AnnualPeriodsByFrame}"/>
                            <ItemsControl ItemsSource="{Binding AnnualPeriodsByFrame}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnnualPeriodEntry">
                                        <Grid ColumnDefinitions="160,200" Margin="0,0,0,6" VerticalAlignment="Center">
                                            <TextBlock Classes="FieldLabel" Grid.Column="0"
                                                       Text="{Binding Frame, Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"
                                                       VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding Periods}"
                                                           Minimum="1" Maximum="366" Increment="1" FormatString="0"
                                                           Height="32" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
