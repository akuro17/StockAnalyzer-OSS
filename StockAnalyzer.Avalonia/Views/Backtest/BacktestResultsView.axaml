<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             xmlns:conv="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Backtest"
             xmlns:engine="using:StockAnalyzer.Core.Models.Backtest.Engine"
             xmlns:c="using:StockAnalyzer.Avalonia.Common"
             xmlns:backtest="clr-namespace:StockAnalyzer.Avalonia.Views.Backtest;assembly=StockAnalyzer.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="StockAnalyzer.Avalonia.Views.Backtest.BacktestResultsView"
             x:DataType="vm:BacktestResultsViewModel">
    <UserControl.Resources>
        <conv:LocalizeConverter x:Key="LocalizeConverter"/>
        <conv:BacktestSemanticToBrushConverter x:Key="SemanticToBrushConverter"/>
        <!-- Live registered-condition row: condition text with a per-row delete icon at the right end.
             Icon/button follow Indicator Manager's delete button (PrimaryButtonStyle -> Settings/Theme
             Button Background/Text/Hover/Pressed, SharedIconGeometries.Delete, Btn_Delete tooltip). -->
        <DataTemplate x:Key="LiveConditionEntryTemplate" x:DataType="engine:BacktestConditionEntry">
            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Classes="CellValue" Height="24" VerticalAlignment="Center"
                           Text="{Binding Converter={x:Static conv:BacktestConditionEntryDisplayConverter.Instance}}"/>
                <Button Grid.Column="1"
                        Command="{Binding $parent[UserControl].((vm:BacktestResultsViewModel)DataContext).ConditionSelection.RemoveConditionEntryCommand}"
                        CommandParameter="{Binding}"
                        Theme="{DynamicResource PrimaryButtonStyle}"
                        Foreground="{DynamicResource Brush.Button.Text}"
                        Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                        VerticalAlignment="Center" HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="Backtest_RegisteredCondition_Delete"
                        ToolTip.Tip="{l:Localize Btn_Delete}">
                    <PathIcon Data="{x:Static c:SharedIconGeometries.Delete}" Width="12" Height="12"
                              Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.ColumnHeader">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <Style Selector="TextBlock.CellValue">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <!-- SAで改善(Round 2): the section card is now the Expander itself (an outer Border previously
             wrapped an inner-bordered Expander, producing a visible "frame within a frame"). -->
        <Style Selector="Expander.SectionCard">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- The Execution-mode notice keeps its own plain Border (it has no Expander/title row). -->
        <Style Selector="Border.SectionCard">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AllowAutoHide="False"
                  Padding="0,0,12,0">
        <StackPanel Margin="16">

            <!-- Registered comparison conditions (Task 6, plan section 4.4): drives
                 ConditionBasedBacktestStrategy (Task 3/5). The "Registered Indicators" card that used to
                 sit above this one (the Indicator Selection tab's now-removed single-target "Track
                 Indicator" Add flow) was deleted per explicit user request (SAで改善,
                 Y:\Temp\sa_improvement_plan_BacktestPriceSourceConditionFix.md) - the underlying
                 AddedIndicators/RemoveIndicatorCommand ViewModel members are left untouched (they still
                 back the NoOp-strategy zero-condition fallback and legacy backtest_configuration.json
                 round-trip), only their display here is gone. -->
            <!-- Open/close behavior (SAで改善 Task 3): identical Expander control to
                 MultiSyncProgressWindow's "Advanced Sync Settings" (default-expanded, toggle on the same
                 row as the header text). The Expander IS the section card (Classes="SectionCard" above) -
                 no separate wrapping Border (Round 2 fix for the earlier double-border look). Padding is
                 overridden to zero out the top/bottom only (Round 4 request: the column divider lines must
                 touch the card's own border, not stop short of it inside the shared style's 16px padding;
                 left/right padding stays 16 from the shared style since only the vertical gap was reported). -->
            <Expander Classes="SectionCard" IsExpanded="True" ExpandDirection="Down" Padding="16,0">
                <Expander.Header>
                    <TextBlock Classes="SectionTitle" Margin="0" Text="{l:Localize Backtest_Section_RegisteredConditions}"/>
                </Expander.Header>
                <StackPanel>
                    <!-- 3-column split (SAで改善 Task 4, dividers reworked Round 3/4/5): equal-width
                         Entry/Exit/Reverse columns matching the Entry/Exit/Reverse buttons above (same
                         Btn_ConditionRole* localization keys, SSoT - no new labels invented;
                         Btn_ConditionRoleBoth's own text was renamed to "Reverse" per Round 2).
                         BacktestConditionRole.Reversal (the role the "Reverse" button actually emits) is
                         bucketed into this 3rd column together with the legacy BacktestConditionRole.Both
                         (kept only for old saved configs); there is no 4th column in this spec. Each column
                         is independently scrollable with its own dedicated, non-overlapping vertical
                         scrollbar (SA_UI_SUBWINDOW_STANDARD §2.3: AllowAutoHide="False" + right padding).
                         Per-column bordered boxes were removed (Round 3) and replaced with a thin vertical
                         divider line between columns (Width="1" Background="Brush.Border.Primary", same
                         pattern as LogViewerView.axaml, SSoT). The divider still spans this Grid's full row
                         height with no Margin top/bottom, so - together with the Expander's zeroed vertical
                         Padding above - it keeps touching the "Registered Conditions" card's own border
                         directly (Round 4 fix, explicitly NOT to be changed again per Round 5 request: "区切
                         り線は現在の枠と接している状態にする"). MaxHeight="150" (~5 rows at this row
                         template's height) caps each column so a 6th+ registered condition triggers the
                         vertical scrollbar instead of growing the card indefinitely (Round 4 request). Each
                         column's own DockPanel now carries top/bottom Margin (Round 5 request: give the
                         Entry/Exit/Reverse content breathing room again, independent of the divider, which
                         must stay flush) - the divider's height is driven by the tallest DockPanel cell
                         (Grid row auto-sizing), so this Margin makes the divider slightly taller without
                         detaching it from the frame. HorizontalScrollBarVisibility stays "Disabled" here
                         (Round 5 fix): Round 4 had made the whole row scroll horizontally at this
                         column-scrollbar level. The horizontal scroll for long names now lives in the one
                         inner ScrollViewer that wraps the frozen text rows, so this outer ScrollViewer stays
                         single-axis and its vertical scrollbar has no horizontal corner overlap. -->
                    <Grid ColumnDefinitions="*,Auto,*,Auto,*" MinHeight="100">
                        <DockPanel Grid.Column="0" Margin="0,12,8,12">
                            <TextBlock DockPanel.Dock="Top" Classes="ColumnHeader" Margin="0,0,0,6" Text="{l:Localize Btn_ConditionRoleEntry}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Padding="0,0,8,0" MaxHeight="150">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
                                        <ItemsControl ItemsSource="{Binding ConditionSelection.EntryConditionEntries}"
                                                      ItemTemplate="{StaticResource LiveConditionEntryTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>

                        <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border.Primary}" Margin="4,0"/>

                        <DockPanel Grid.Column="2" Margin="8,12">
                            <TextBlock DockPanel.Dock="Top" Classes="ColumnHeader" Margin="0,0,0,6" Text="{l:Localize Btn_ConditionRoleExit}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Padding="0,0,8,0" MaxHeight="150">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
                                        <ItemsControl ItemsSource="{Binding ConditionSelection.ExitConditionEntries}"
                                                      ItemTemplate="{StaticResource LiveConditionEntryTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>

                        <Border Grid.Column="3" Width="1" Background="{DynamicResource Brush.Border.Primary}" Margin="4,0"/>

                        <DockPanel Grid.Column="4" Margin="8,12,0,12">
                            <TextBlock DockPanel.Dock="Top" Classes="ColumnHeader" Margin="0,0,0,6" Text="{l:Localize Btn_ConditionRoleBoth}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Padding="0,0,8,0" MaxHeight="150">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
                                        <ItemsControl ItemsSource="{Binding ConditionSelection.BothConditionEntries}"
                                                      ItemTemplate="{StaticResource LiveConditionEntryTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <Border Classes="SectionCard" Background="{DynamicResource Brush.Background.Secondary}"
                    IsVisible="{Binding HasResult}">
                <StackPanel>
                    <TextBlock Classes="CellValue" Text="{Binding ExecutionModeDescription}"
                               AutomationProperties.AutomationId="Backtest_Results_ModeDescription"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"/>
                    <TextBlock Classes="CellValue" Text="{Binding RiskManagementDescription}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Execution-mode notice (sa_implementation_plan_BacktestP3Hardening.md Task 4): originally
                 written when NoOpBacktestStrategy (P3 Gate G7, always 0 trades by design) was the ONLY
                 strategy RunBacktestAsync could ever select - without it, a Completed run with 0 trades
                 read as "the strategy ran and found no opportunity" rather than "no strategy logic ran at
                 all yet". Since Task 5 of sa_implementation_plan_BacktestComparisonSignals.md,
                 ConditionBasedBacktestStrategy is selected instead whenever at least one condition is
                 registered - this notice is now gated on ConditionEntries.Count == 0 too (SAで改善,
                 Y:\Temp\sa_improvement_plan_BacktestPriceSourceConditionFix.md bug fix), so it no longer
                 shows - misleadingly, "0 trades expected" - for a real condition-driven run. -->
            <Border IsVisible="{Binding HasResult}">
                <Border Classes="SectionCard" Background="{DynamicResource Brush.Background.Secondary}"
                        IsVisible="{Binding IsNoOp}">
                    <TextBlock Classes="CellValue" Text="{l:Localize Backtest_Results_ExecutionModeNotice}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"/>
                </Border>
            </Border>

            <Expander Classes="SectionCard" IsExpanded="True" ExpandDirection="Down">
                <Expander.Header>
                    <TextBlock Classes="SectionTitle" Margin="0" Text="{l:Localize Backtest_Section_EquityChart}"/>
                </Expander.Header>
                <!-- EmptyStateText intentionally unset (Round 2: "No equity data..." message removed per
                     explicit user request) - EquityCurveControl's DrawCenteredMessage already no-ops
                     cleanly on a null/empty message, so no control-level change was needed. -->
                <backtest:EquityCurveControl Height="260" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                              AutomationProperties.AutomationId="Backtest_Results_EquityCurve"
                                              EquityPoints="{Binding EquityPoints}"
                                              ResultRevision="{Binding ResultRevision}"
                                              LineSemantic="{Binding EquityLineSemantic}"
                                              UnavailableText="{l:Localize Backtest_Chart_Unavailable}"/>
            </Expander>

            <Expander Classes="SectionCard" IsExpanded="True" ExpandDirection="Down"
                      IsVisible="{Binding HasAudit}">
                <Expander.Header>
                    <TextBlock Classes="SectionTitle" Margin="0" Text="{l:Localize Backtest_Section_EvaluationAudit}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding AuditRows}"
                              AutomationProperties.AutomationId="Backtest_Results_EvaluationAudit">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BacktestAuditRow">
                            <Grid ColumnDefinitions="220,*" Margin="0,3">
                                <TextBlock Grid.Column="0" Classes="ColumnHeader"
                                           Text="{Binding LabelKey, Converter={StaticResource LocalizeConverter}}"/>
                                <SelectableTextBlock Grid.Column="1" Classes="CellValue"
                                                     Text="{Binding ValueText}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Expander Classes="SectionCard" IsExpanded="True" ExpandDirection="Down">
                <Expander.Header>
                    <TextBlock Classes="SectionTitle" Margin="0" Text="{l:Localize Backtest_Section_MetricsTable}"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,140,220" Margin="0,0,0,4">
                        <TextBlock Classes="ColumnHeader" Grid.Column="0" Text="{l:Localize Backtest_MetricsTable_Header_Metric}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="1" Text="{l:Localize Backtest_MetricsTable_Header_Value}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="2" Text="{l:Localize Backtest_MetricsTable_Header_ConfidenceInterval}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Metrics}" AutomationProperties.AutomationId="Backtest_Results_Metrics">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BacktestMetricRow">
                                <Grid ColumnDefinitions="*,140,220" Margin="0,2">
                                    <TextBlock Classes="CellValue" Grid.Column="0" Text="{Binding LabelKey, Converter={StaticResource LocalizeConverter}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="1" Text="{Binding ValueText}"
                                               Foreground="{Binding Semantic, Converter={StaticResource SemanticToBrushConverter}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="2" Text="{Binding ConfidenceIntervalText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Owner decision G5: the run's identity (SHA-256 fingerprint, or the reason none exists); selectable so it can be copied. -->
                    <SelectableTextBlock Classes="CellValue" Margin="0,8,0,0" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="Backtest_Results_Fingerprint"
                                         Text="{Binding RunFingerprintText}"
                                         IsVisible="{Binding RunFingerprintText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Expander>

            <Expander Classes="SectionCard" IsExpanded="True" ExpandDirection="Down">
                <Expander.Header>
                    <TextBlock Classes="SectionTitle" Margin="0" Text="{l:Localize Backtest_Section_TradeList}"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <Grid ColumnDefinitions="50,60,150,90,150,90,80,110,110" Margin="0,0,0,4">
                        <TextBlock Classes="ColumnHeader" Grid.Column="0" Text="{l:Localize Backtest_TradeList_Header_TradeId}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="1" Text="{l:Localize Backtest_TradeList_Header_Side}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="2" Text="{l:Localize Backtest_TradeList_Header_EntryTime}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="3" Text="{l:Localize Backtest_TradeList_Header_EntryPrice}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="4" Text="{l:Localize Backtest_TradeList_Header_ExitTime}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="5" Text="{l:Localize Backtest_TradeList_Header_ExitPrice}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="6" Text="{l:Localize Backtest_TradeList_Header_Quantity}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="7" Text="{l:Localize Backtest_TradeList_Header_ClosedNet}"/>
                        <TextBlock Classes="ColumnHeader" Grid.Column="8" Text="{l:Localize Backtest_TradeList_Header_ForcedLiquidation}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Trades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BacktestTradeRow">
                                <Grid ColumnDefinitions="50,60,150,90,150,90,80,110,110" Margin="0,2">
                                    <TextBlock Classes="CellValue" Grid.Column="0" Text="{Binding TradeId}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="1" Text="{Binding Side}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="2" Text="{Binding EntryTime, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="3" Text="{Binding EntryPrice, StringFormat=\{0:F4\}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="4" Text="{Binding ExitTime, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="5" Text="{Binding ExitPrice, StringFormat=\{0:F4\}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="6" Text="{Binding Quantity, StringFormat=\{0:F4\}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="7" Text="{Binding ClosedNet, StringFormat=\{0:F4\}}"
                                               Foreground="{Binding PnLSemantic, Converter={StaticResource SemanticToBrushConverter}}"/>
                                    <TextBlock Classes="CellValue" Grid.Column="8" Text="{l:Localize Backtest_TradeList_ForcedLiquidation_Badge}"
                                               Foreground="{DynamicResource Brush.Semantic.Error}"
                                               IsVisible="{Binding IsForcedLiquidation}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Export moved to the bottom-right of the card (SAで改善 Task 1; previously top-right
                         next to the section title). -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ExportStatusMessage}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontSize="{DynamicResource HelperFontSize}"
                                   VerticalAlignment="Center"/>
                        <Button Content="{l:Localize Backtest_Btn_Export}"
                                AutomationProperties.AutomationId="Backtest_Results_ExportButton"
                                Theme="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportReportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
