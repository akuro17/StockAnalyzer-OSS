<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
             xmlns:conv="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Backtest"
             xmlns:engine="using:StockAnalyzer.Core.Models.Backtest.Engine"
             xmlns:c="using:StockAnalyzer.Avalonia.Common"
             xmlns:backtest="clr-namespace:StockAnalyzer.Avalonia.Views.Backtest;assembly=StockAnalyzer.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="StockAnalyzer.Avalonia.Views.Backtest.BacktestResultsView"
             x:Name="BacktestResultsViewRoot"
             x:DataType="vm:BacktestResultsViewModel">
    <UserControl.Resources>
        <conv:LocalizeConverter x:Key="LocalizeConverter"/>
        <conv:BacktestSemanticToBrushConverter x:Key="SemanticToBrushConverter"/>

        <!-- sa_improve BF01: view-owned DIP geometry; each table shares its measured column widths. -->
        <x:Double x:Key="ResultsDataViewportHeight">320</x:Double>
        <GridLength x:Key="ResultsMetricsColumnWidth">2*</GridLength>
        <GridLength x:Key="ResultsTradesColumnWidth">3*</GridLength>
        <x:Double x:Key="ResultsSeparatorThickness">1</x:Double>
        <Thickness x:Key="ResultsCardBorderThickness">1</Thickness>
        <CornerRadius x:Key="ResultsCardCornerRadius">8</CornerRadius>
        <Thickness x:Key="ResultsCardPadding">16</Thickness>
        <Thickness x:Key="ResultsSectionMargin">0,0,0,16</Thickness>
        <Thickness x:Key="ResultsTitleBottomMargin">0,0,0,8</Thickness>
        <Thickness x:Key="ResultsUtilityTopMargin">0,8,0,0</Thickness>
        <Thickness x:Key="ResultsDividerMargin">16,0</Thickness>
        <x:Double x:Key="ResultsMetricNameMinWidth">260</x:Double>
        <x:Double x:Key="ResultsMetricValueMinWidth">120</x:Double>
        <x:Double x:Key="ResultsTradeIdMinWidth">50</x:Double>
        <x:Double x:Key="ResultsSideMinWidth">60</x:Double>
        <x:Double x:Key="ResultsEntryTimeMinWidth">150</x:Double>
        <x:Double x:Key="ResultsEntryPriceMinWidth">90</x:Double>
        <x:Double x:Key="ResultsExitTimeMinWidth">150</x:Double>
        <x:Double x:Key="ResultsExitPriceMinWidth">90</x:Double>
        <x:Double x:Key="ResultsQuantityMinWidth">80</x:Double>
        <x:Double x:Key="ResultsClosedNetMinWidth">110</x:Double>
        <x:Double x:Key="ResultsForcedLiquidationMinWidth">110</x:Double>

        <!-- Transparent hover target of a metric tooltip (definition, status and reason); placed over the cells it explains and visible only when there is text,
             so a row without text has no tooltip at all. Font size = Settings > Fonts > Tooltip Font Size (TooltipFontSize) and color = Brush.Text.Primary are set
             on the Tip content itself because the popup does not inherit them (SA_UI_INTERACTION section 12); the text wraps so nothing is cut at the popup's maximum width. -->
        <DataTemplate x:Key="MetricTipHostTemplate" x:DataType="vm:BacktestMetricDisplayRow">
            <Border Background="Transparent" IsVisible="{Binding TooltipText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ToolTip.Tip>
                    <TextBlock Text="{Binding TooltipText}" TextWrapping="Wrap"
                               FontSize="{DynamicResource TooltipFontSize}" Foreground="{DynamicResource Brush.Text.Primary}"
                               AutomationProperties.AutomationId="Backtest_Results_MetricTip"/>
                </ToolTip.Tip>
            </Border>
        </DataTemplate>

        <!-- One metric row (label, value with optional inline confidence interval); used by every metric group. -->
        <DataTemplate x:Key="MetricRowTemplate" x:DataType="vm:BacktestMetricDisplayRow">
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource ResultsMetricNameMinWidth}" SharedSizeGroup="MetricName"/>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource ResultsMetricValueMinWidth}" SharedSizeGroup="MetricValue"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="TableCell">
                    <Grid>
                        <TextBlock Classes="CellValue" Grid.Column="0"
                                   Text="{Binding LabelKey, Converter={StaticResource LocalizeConverter}}"/>
                        <Thumb Classes="ColumnResizer" DragDelta="OnMetricColumnDragDelta" DoubleTapped="OnMetricHeaderDoubleTapped" Tag="0"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Classes="TableCell">
                    <Grid>
                        <TextBlock Classes="CellValue NumericValue" Text="{Binding ValueText}"
                                   Foreground="{Binding Semantic, Converter={StaticResource SemanticToBrushConverter}}"/>
                        <Thumb Classes="ColumnResizer" DragDelta="OnMetricColumnDragDelta" DoubleTapped="OnMetricHeaderDoubleTapped" Tag="1"/>
                    </Grid>
                </Border>
                <ContentControl Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding}" ContentTemplate="{StaticResource MetricTipHostTemplate}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.ColumnHeader">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <Style Selector="TextBlock.CellValue">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <!-- Round 2: the section card is now the Expander itself (an outer Border previously
             wrapped an inner-bordered Expander, producing a visible "frame within a frame"). -->
        <Style Selector="Expander.SectionCard">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- The Execution-mode notice keeps its own plain Border (it has no Expander/title row). -->
        <Style Selector="Border.SectionCard">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Only the new results card adopts the common sub-window typography; other sections keep their contracts. -->
        <Style Selector="TextBlock.ResultsSectionTitle">
            <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="Margin" Value="{StaticResource ResultsTitleBottomMargin}"/>
        </Style>
        <Style Selector="Border.ResultsDetails TextBlock.ColumnHeader">
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.ResultsDetails TextBlock.NumericValue">
            <Setter Property="FontFamily" Value="{StaticResource Font_Mono}"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Table Grid Formatting matching TickerListView right-column standard -->
        <Style Selector="Border.TableHeaderCell">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Border.TableCell">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style Selector="Border.GroupHeaderBanner">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Tertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Border.GroupHeaderBanner TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Thumb.ColumnResizer">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,-4,-8,-4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ZIndex" Value="2"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.DataLabel">
            <Setter Property="FontSize" Value="{DynamicResource HelperFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.DataValue">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font_Mono}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <Style Selector="Button.CollapseToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.CollapseToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
        </Style>
        <Style Selector="Button.PaginationNavBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="{DynamicResource HelperFontSize}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.PaginationNumberBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="{DynamicResource HelperFontSize}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.PaginationNumberBtn.ActivePage">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
        </Style>
        <Style Selector="TextBlock.SortIndicator">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AllowAutoHide="False"
                  Padding="0">
        <StackPanel Margin="16">

            <!-- Result summary: key metrics at a glance (scrolls with content, not pinned) -->
            <Border Classes="SectionCard" IsVisible="{Binding HasSummary}"
                    AutomationProperties.AutomationId="Backtest_Results_SummaryContainer">
                <ItemsControl ItemsSource="{Binding Summary}" AutomationProperties.AutomationId="Backtest_Results_Summary">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BacktestMetricDisplayRow">
                            <Grid Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Classes="CellValue" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding LabelKey, Converter={StaticResource LocalizeConverter}}"/>
                                    <TextBlock Classes="SectionTitle" Margin="0" TextWrapping="Wrap"
                                               Text="{Binding ValueText}"
                                               Foreground="{Binding Semantic, Converter={StaticResource SemanticToBrushConverter}}"/>
                                </StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MetricTipHostTemplate}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

                <!-- Equity Curve: 2-column card with full-bleed chart on the left and bordered collapsible vertical data panel on the right -->
                <Border Classes="SectionCard"
                        Padding="0"
                        ClipToBounds="True"
                        AutomationProperties.AutomationId="Backtest_Results_EquityCard">
                    <Grid ColumnDefinitions="*, Auto">
                        <backtest:EquityCurveControl Grid.Column="0" Height="260" HorizontalAlignment="Stretch"
                                                      AutomationProperties.AutomationId="Backtest_Results_EquityCurve"
                                                      ShowHoverTooltip="False"
                                                      HoveredPoint="{Binding HoveredEquityPoint, Mode=OneWayToSource}"
                                                      EquityPoints="{Binding EquityPoints}"
                                                      UnderwaterFlags="{Binding EquityUnderwaterFlags}"
                                                      Trades="{Binding Trades}"
                                                      ResultRevision="{Binding ResultRevision}"
                                                      LineSemantic="{Binding EquityLineSemantic}"
                                                      UnavailableText="{l:Localize Backtest_Chart_Unavailable}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto, Auto" Margin="8,8,8,8">
                            <Border Grid.Column="0"
                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="{DynamicResource Brush.Background.Secondary}"
                                    Padding="12,10"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding IsEquityDataPanelExpanded}"
                                    AutomationProperties.AutomationId="Backtest_Results_EquityDataPanel">
                                <StackPanel Width="140" Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="DataLabel" Text="{l:Localize Backtest_EquityHover_Date}"/>
                                        <TextBlock Classes="DataValue" Text="{Binding DisplayEquityDate}"
                                                   AutomationProperties.AutomationId="Backtest_Results_DisplayDate"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="DataLabel" Text="{l:Localize Backtest_EquityHover_Equity}"/>
                                        <TextBlock Classes="DataValue" Text="{Binding DisplayEquityValue}"
                                                   AutomationProperties.AutomationId="Backtest_Results_DisplayEquity"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="DataLabel" Text="{l:Localize Backtest_EquityHover_Cash}"/>
                                        <TextBlock Classes="DataValue" Text="{Binding DisplayEquityCash}"
                                                   AutomationProperties.AutomationId="Backtest_Results_DisplayCash"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="DataLabel" Text="{l:Localize Backtest_EquityHover_MarketValue}"/>
                                        <TextBlock Classes="DataValue" Text="{Binding DisplayEquityMarketValue}"
                                                   AutomationProperties.AutomationId="Backtest_Results_DisplayMarketValue"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="DataLabel" Text="{l:Localize Backtest_EquityHover_HeldMargin}"/>
                                        <TextBlock Classes="DataValue" Text="{Binding DisplayEquityHeldMargin}"
                                                   AutomationProperties.AutomationId="Backtest_Results_DisplayHeldMargin"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Classes="CollapseToggle"
                                    Width="24" Height="24"
                                    VerticalAlignment="Top"
                                    Command="{Binding ToggleEquityDataPanelCommand}"
                                    AutomationProperties.AutomationId="Backtest_Results_ToggleEquityDataPanel"
                                    ToolTip.Tip="{l:Localize Backtest_Btn_TogglePanel}">
                                <PathIcon Data="{Binding ToggleButtonIconGeometry}" Width="16" Height="16"
                                          Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>


            <!-- BF01: always-open Metrics and Trade History, directly below the curve. -->
            <Border Classes="ResultsDetails"
                    AutomationProperties.AutomationId="Backtest_Results_DetailsBlock"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="{StaticResource ResultsCardBorderThickness}"
                    CornerRadius="{StaticResource ResultsCardCornerRadius}"
                    Padding="{StaticResource ResultsCardPadding}"
                    Margin="{StaticResource ResultsSectionMargin}"
                    Background="{DynamicResource Brush.Background.Secondary}">
                <Grid RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ResultsMetricsColumnWidth}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource ResultsTradesColumnWidth}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="ResultsSectionTitle"
                               Text="{l:Localize Backtest_Section_MetricsTable}">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Localize Backtest_Metrics_ContextMenu_CustomizeColumns}"
                                          Command="{Binding ShowMetricsChooserCommand}"/>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource ResultsTitleBottomMargin}">
                        <TextBlock Grid.Column="0" Classes="ResultsSectionTitle" Margin="0" VerticalAlignment="Center"
                                   Text="{l:Localize Backtest_Section_TradeList}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ExportStatusMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontSize="{DynamicResource HelperFontSize}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="8,0"/>
                        <Button Grid.Column="2" TabIndex="2" Content="{l:Localize Backtest_Btn_Export}"
                                AutomationProperties.AutomationId="Backtest_Results_ExportButton"
                                FontSize="{DynamicResource BaseFontSize}"
                                HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                Theme="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportReportCommand}"/>
                    </Grid>
                    <!-- Vertical separator line (1-DIP visible line, centered) -->
                    <Border Grid.Column="1" Grid.RowSpan="3" IsHitTestVisible="False"
                            AutomationProperties.AutomationId="Backtest_Results_DetailsSeparator"
                            Width="{StaticResource ResultsSeparatorThickness}"
                            Margin="{StaticResource ResultsDividerMargin}"
                            Background="{DynamicResource Brush.Border.Primary}"/>
                    <ScrollViewer Grid.Row="1" Grid.Column="0" Focusable="True" TabIndex="0"
                                  AutomationProperties.AutomationId="Backtest_Results_MetricsScroll"
                                  Height="{StaticResource ResultsDataViewportHeight}"
                                  MaxHeight="{StaticResource ResultsDataViewportHeight}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False" ScrollViewer.IsScrollChainingEnabled="True"
                                  Background="Transparent">
                        <StackPanel Grid.IsSharedSizeScope="True" Background="Transparent">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Localize Backtest_Metrics_ContextMenu_CustomizeColumns}"
                                              Command="{Binding ShowMetricsChooserCommand}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <!-- Sizing scope anchor for MetricName and MetricValue (Metric/Value header row removed per user request) -->
                            <Grid x:Name="MetricsHeaderGrid" Height="0" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource ResultsMetricNameMinWidth}" SharedSizeGroup="MetricName"/>
                                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource ResultsMetricValueMinWidth}" SharedSizeGroup="MetricValue"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="MetricNameAnchor" Grid.Column="0" Width="{StaticResource ResultsMetricNameMinWidth}"/>
                                <Border x:Name="MetricValueAnchor" Grid.Column="1" Width="{StaticResource ResultsMetricValueMinWidth}"/>
                            </Grid>
                            <!-- Top horizontal border line directly above Total P&L / metrics table -->
                            <Border Height="{StaticResource ResultsSeparatorThickness}" Background="{DynamicResource Brush.Border.Primary}" HorizontalAlignment="Stretch"/>
                            <ItemsControl ItemsSource="{Binding MetricGroups}" AutomationProperties.AutomationId="Backtest_Results_Metrics">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BacktestMetricGroupPresentation">
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" Grid.Column="2" Focusable="True" TabIndex="1"
                                  AutomationProperties.AutomationId="Backtest_Results_TradesScroll"
                                  Height="{StaticResource ResultsDataViewportHeight}"
                                  MaxHeight="{StaticResource ResultsDataViewportHeight}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False" ScrollViewer.IsScrollChainingEnabled="True"
                                  Background="Transparent">
                        <StackPanel x:Name="TradesContainerPanel"
                                    Grid.IsSharedSizeScope="True">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Localize Backtest_TradeList_ContextMenu_CustomizeColumns}"
                                              Command="{Binding ShowTradeColumnsChooserCommand}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Grid x:Name="TradesHeaderGrid">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:Localize Backtest_TradeList_ContextMenu_CustomizeColumns}"
                                                  Command="{Binding ShowTradeColumnsChooserCommand}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PagedTrades}" AutomationProperties.AutomationId="Backtest_Results_Trades">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BacktestTradeRow">
                                        <backtest:TradeRowGrid ActiveColumns="{Binding #BacktestResultsViewRoot.((vm:BacktestResultsViewModel)DataContext).ActiveTradeColumns}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </ScrollViewer>

                    <!-- Trade History Pagination Bar -->
                    <Border Grid.Row="2" Grid.Column="2" Margin="0,8,0,0"
                            AutomationProperties.AutomationId="Backtest_Results_TradesPaginationBar">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource HelperFontSize}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="{Binding TradePaginationInfoText}"
                                       AutomationProperties.AutomationId="Backtest_Results_TradesPaginationInfo"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="{l:Localize Backtest_TradeList_Pagination_Prev}"
                                            Command="{Binding PreviousTradePageCommand}"
                                            IsEnabled="{Binding CanPreviousTradePage}"
                                            Classes="PaginationNavBtn"
                                            AutomationProperties.AutomationId="Backtest_Results_TradesPrevPageBtn"/>
                                    <ItemsControl ItemsSource="{Binding TradePaginationTokens}"
                                                  AutomationProperties.AutomationId="Backtest_Results_TradesPaginationTokens">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TradePaginationToken">
                                                <Panel>
                                                    <Button Content="{Binding PageNumber}"
                                                            IsVisible="{Binding !IsEllipsis}"
                                                            Command="{Binding #BacktestResultsViewRoot.((vm:BacktestResultsViewModel)DataContext).GoToTradePageCommand}"
                                                            CommandParameter="{Binding PageNumber}"
                                                            Classes.ActivePage="{Binding IsActive}"
                                                            Classes="PaginationNumberBtn"/>
                                                    <TextBlock Text="{l:Localize Backtest_TradeList_Pagination_Ellipsis}"
                                                               IsVisible="{Binding IsEllipsis}"
                                                               VerticalAlignment="Center"
                                                               Padding="4,0"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{l:Localize Backtest_TradeList_Pagination_Next}"
                                            Command="{Binding NextTradePageCommand}"
                                            IsEnabled="{Binding CanNextTradePage}"
                                            Classes="PaginationNavBtn"
                                            AutomationProperties.AutomationId="Backtest_Results_TradesNextPageBtn"/>
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding TradePageSizeOptions}"
                                          SelectedItem="{Binding SelectedTradePageSize}"
                                          VerticalAlignment="Center"
                                          MinHeight="26"
                                          AutomationProperties.AutomationId="Backtest_Results_TradesPageSizeDropdown">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TradePageSizeOption">
                                            <TextBlock Text="{Binding DisplayText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Expander Classes="SectionCard" IsExpanded="True" ExpandDirection="Down"
                      IsVisible="{Binding HasAudit}">
                <Expander.Header>
                    <TextBlock Classes="SectionTitle" Margin="0" Text="{l:Localize Backtest_Section_EvaluationAudit}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding AuditRows}"
                              AutomationProperties.AutomationId="Backtest_Results_EvaluationAudit">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BacktestAuditRow">
                            <Border BorderBrush="{DynamicResource Brush.Border.Primary}"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,8">
                                <Grid ColumnDefinitions="260,*">
                                    <TextBlock Grid.Column="0" Classes="ColumnHeader"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               Margin="0,0,16,0"
                                               Text="{Binding LabelKey, Converter={StaticResource LocalizeConverter}}"/>
                                    <SelectableTextBlock Grid.Column="1" Classes="CellValue"
                                                         VerticalAlignment="Top"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding ValueText}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
