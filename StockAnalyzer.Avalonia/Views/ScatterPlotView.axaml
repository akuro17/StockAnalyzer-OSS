<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels"
             xmlns:controls="using:StockAnalyzer.Avalonia.Views.Controls"
             xmlns:l="using:StockAnalyzer.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="StockAnalyzer.Avalonia.Views.ScatterPlotView"
             x:DataType="vm:ScatterPlotViewModel"
             Background="{DynamicResource Brush.Background.Secondary}">

    <UserControl.Styles>
        <!-- Standard scoped action button and control styling adhering to SA_UI_SUBWINDOW_STANDARD -->
        <!-- Toolbar Mode and Action Buttons -->
        <!-- Default / Inactive state: Transparent background matching toolbar background, subtle border -->
        <Style Selector="Button.toolbar-btn">
            <Setter Property="Theme" Value="{DynamicResource InactiveModeButtonStyle}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Tertiary}"/>
        </Style>

        <!-- Active state (e.g. active mode button): Linked to Settings/Theme -> Button 4 items -->
        <Style Selector="Button.toolbar-btn.active">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Text}"/>
        </Style>
        <Style Selector="Button.toolbar-btn.active /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Background}"/>
        </Style>
        <Style Selector="Button.toolbar-btn.active:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Hover}"/>
        </Style>
        <Style Selector="Button.toolbar-btn.active:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Pressed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Pressed}"/>
        </Style>

        <!-- ToggleButton (e.g. X Log, Y Log) toolbar dimensions adhering to ChartToggleButtonStyle -->
        <Style Selector="ToggleButton.toolbar-btn">
            <Setter Property="Theme" Value="{DynamicResource ChartToggleButtonStyle}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.toolbar-combo">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox.toolbar-check">
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource Brush.Background.Primary}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border.Primary}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mode Switch Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
                    <Button Classes="toolbar-btn" Classes.active="{Binding IsScatterMode}"
                            Content="{l:Localize Scatter_Btn_Scatter}" Command="{Binding SetScatterModeCommand}"
                            TabIndex="1" />
                    <Button Classes="toolbar-btn" Classes.active="{Binding IsHeatmapMode}"
                            Content="{l:Localize Scatter_Btn_Heatmap}" Command="{Binding SetHeatmapModeCommand}"
                            TabIndex="2" />
                </StackPanel>

                <!-- Metric Selectors (Visible in Scatter Mode) -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" IsVisible="{Binding IsScatterMode}">
                    <TextBlock Text="X:" VerticalAlignment="Center"
                               FontSize="{DynamicResource DetailFontSize}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ComboBox Classes="toolbar-combo" ItemsSource="{Binding AvailableMetrics}"
                              SelectedItem="{Binding SelectedXMetric}" Width="120"
                              TabIndex="3" />

                    <TextBlock Text="Y:" VerticalAlignment="Center"
                               FontSize="{DynamicResource DetailFontSize}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="8,0,0,0" />
                    <ComboBox Classes="toolbar-combo" ItemsSource="{Binding AvailableMetrics}"
                              SelectedItem="{Binding SelectedYMetric}" Width="120"
                              TabIndex="4" />
                </StackPanel>

                <!-- Scale & Display Toggles (Visible in Scatter Mode) -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" IsVisible="{Binding IsScatterMode}">
                    <ToggleButton Classes="toolbar-btn" Content="{l:Localize Scatter_Btn_XLog}"
                                  IsChecked="{Binding IsXLog, Mode=TwoWay}"
                                  TabIndex="5" />
                    <ToggleButton Classes="toolbar-btn" Content="{l:Localize Scatter_Btn_YLog}"
                                  IsChecked="{Binding IsYLog, Mode=TwoWay}"
                                  TabIndex="6" />
                    <CheckBox Classes="toolbar-check" Content="{l:Localize Scatter_Chk_Regression}" IsChecked="{Binding ShowRegressionLine}"
                              TabIndex="7" />
                    <CheckBox Classes="toolbar-check" Content="{l:Localize Scatter_Chk_ConfidenceBand}" IsChecked="{Binding ShowConfidenceBand}"
                              TabIndex="8" />
                    <CheckBox Classes="toolbar-check" Content="{l:Localize Scatter_Chk_PredictionBand}" IsChecked="{Binding ShowPredictionBand}"
                              TabIndex="9" />
                    <CheckBox Classes="toolbar-check" Content="{l:Localize Scatter_Chk_SuppressOutliers}" IsChecked="{Binding SuppressOutliers}"
                              TabIndex="10" />
                </StackPanel>

                <!-- Heatmap Controls (Visible in Heatmap Mode) -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" IsVisible="{Binding IsHeatmapMode}">
                    <Button Classes="toolbar-btn" Content="{Binding ColorSchemeLabel}" Command="{Binding ToggleColorSchemeCommand}"
                            TabIndex="11" />
                </StackPanel>

                <!-- Status & Active Group Badge -->
                <Border Background="{DynamicResource Brush.Background.Tertiary}"
                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="0,0,8,0"
                        ToolTip.Tip="{Binding StatusMessage}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding GroupTitle}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource DetailFontSize}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </Border>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True" Width="50" Height="4" IsVisible="{Binding IsLoading}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <!-- Main Display Area -->
        <Grid Grid.Row="1">
            <!-- Scatter Plot View -->
            <controls:ScatterPlotControl
                IsVisible="{Binding IsScatterMode}"
                Dataset="{Binding Dataset}"
                AnalysisResult="{Binding AnalysisResult}"
                SelectedPointIndex="{Binding SelectedPointIndex, Mode=TwoWay}"
                ShowRegressionLine="{Binding ShowRegressionLine}"
                ShowConfidenceBand="{Binding ShowConfidenceBand}"
                ShowPredictionBand="{Binding ShowPredictionBand}"
                SuppressOutliers="{Binding SuppressOutliers}"
                XScale="{Binding XScale}"
                YScale="{Binding YScale}" />

            <!-- Uniform Heatmap View adhering to SA_UI_SUBWINDOW_STANDARD Section 2.3 -->
            <ScrollViewer
                IsVisible="{Binding IsHeatmapMode}"
                AllowAutoHide="False"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="8,8,16,8">
                <controls:UniformHeatmapControl
                    Items="{Binding HeatmapItems}"
                    ColorScheme="{Binding ColorScheme}"
                    SelectedTicker="{Binding SelectedTicker}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
