                        <NumericUpDown x:Name="SsaAnomalyEmbeddingDimensionSpin" Minimum="2" Maximum="100" Increment="1" Value="15" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
