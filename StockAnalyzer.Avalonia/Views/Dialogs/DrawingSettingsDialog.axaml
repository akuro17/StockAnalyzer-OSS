                        <NumericUpDown x:Name="FftConfidenceMultiplierSpin" Minimum="0.1" Maximum="10.0" Increment="0.1" Value="2.0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
