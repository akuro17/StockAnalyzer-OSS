<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
        xmlns:behaviors="using:StockAnalyzer.Avalonia.Behaviors"
        xmlns:controls="using:StockAnalyzer.Avalonia.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="520"
        x:Class="StockAnalyzer.Avalonia.Views.Dialogs.DrawingSettingsDialog"
        Title="Drawing Settings"
        MinWidth="640" MinHeight="480" Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource Brush.Background.Primary}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">
    
    <Window.Resources>
        <StreamGeometry x:Key="SettingsIconData">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41l-0.36,2.54c-0.59,0.24-1.13,0.57-1.62,0.94L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.81,11.69,4.81,12c0,0.31,0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ColorPicker">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.SettingsCard">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="ListBox#CategoryListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
        </Style>
        <Style Selector="ListBox#CategoryListBox ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Dialog.Border}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Dialog.Border}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Dialog.Border}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>

        <!-- Footer Action Buttons: bound to Settings > Theme > Button's 4 brush resources
             (SA_UI_INTERACTION.md §16), not the "accent" style class the footer used before. -->
        <Style Selector="Button.FooterBtn">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.FooterBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Hover}"/>
        </Style>
        <Style Selector="Button.FooterBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Pressed}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="200, *" RowDefinitions="56, *, 64">
        <!-- Sidebar (Integrated Header + Navigation) -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="56, *">
                <!-- Sidebar Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                        BorderThickness="0,0,0,1"
                        PointerPressed="OnHeaderPointerPressed"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" Spacing="10">
                        <PathIcon Data="{StaticResource SettingsIconData}" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                        <TextBlock x:Name="SidebarTitleText" Text="Drawing Settings"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Sidebar Navigation ListBox -->
                <ListBox x:Name="CategoryListBox"
                         Grid.Row="1"
                         SelectedIndex="0">
                    <ListBox.Template>
                        <ControlTemplate>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                            Margin="{TemplateBinding Padding}"/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBoxItem x:Name="GeneralCategoryItem" Content="General"/>
                    <ListBoxItem x:Name="SpecificCategoryItem" Content="Specific"/>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Content Header -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{DynamicResource Brush.Background.Tertiary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="*, Auto" Margin="24,0">
                <TextBlock x:Name="HeaderTitleText" Text="Drawing Settings"
                           FontSize="14"
                           FontWeight="Heavy"
                           LetterSpacing="1.5"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="1" Grid.Column="1" 
                      Theme="{StaticResource SidebarScrollViewerTheme}"
                      AllowAutoHide="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:WheelScrollRedirectBehavior.IsEnabled="True">
            <StackPanel x:Name="SettingsContentPanel" Spacing="12" Margin="24,15">
                
                <!-- === GENERAL SETTINGS SECTION === -->
                <StackPanel x:Name="GeneralSettingsSection" Spacing="12" IsVisible="True">
                    <!-- Color -->
                    <StackPanel x:Name="GenericColorPanel">
                        <Border Classes="SettingsCard">
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="{l:Localize Label_Color}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                                <ColorPicker x:Name="ColorPickerControl" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Thickness -->
                    <StackPanel x:Name="ThicknessPanel">
                        <Border Classes="SettingsCard">
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="{l:Localize Label_Thickness}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="ThicknessSpin" Minimum="1" Maximum="10" Value="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Line Text Common Settings (Transparent) -->
                    <StackPanel x:Name="LineTextCommonPanel" IsVisible="False">
                        <Border Classes="SettingsCard">
                            <StackPanel x:Name="LineTextCommonColumnPanel">
                                <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                    <TextBlock Text="Transparent" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="LineTextTransparentCheck" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Placeholder when tool has no general settings -->
                    <Border x:Name="NoGeneralSettingsCard" Classes="SettingsCard" IsVisible="False">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                            <PathIcon Data="{StaticResource SettingsIconData}" Width="24" Height="24" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No general settings available for this drawing tool."
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="{DynamicResource DetailFontSize}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- === SPECIFIC SETTINGS SECTION === -->
                <StackPanel x:Name="SpecificSettingsSection" Spacing="12" IsVisible="False">
                    <!-- Placeholder when tool has no specific settings -->
                    <Border x:Name="NoSpecificSettingsCard" Classes="SettingsCard" IsVisible="False">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                            <PathIcon Data="{StaticResource SettingsIconData}" Width="24" Height="24" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No specific settings available for this drawing tool."
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="{DynamicResource DetailFontSize}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic Drawing Settings (Metadata-driven unified parameter UI) -->
                    <controls:DynamicDrawingSettingsView x:Name="DynamicSettingsView" IsVisible="False" Margin="0,0,0,12"/>

                <!-- DTW Projection Settings (Unmatched Line Color) -->
                <StackPanel x:Name="DtwProjectionPanel" Spacing="4" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<TextBlock Text="{l:Localize Setting_Dtw_UnmatchedColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="DtwUnmatchedColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Kalman Filter Projection Settings (Q, R) -->
                <StackPanel x:Name="KalmanFilterProjectionPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Kalman_Q}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="KalmanQSpin" Minimum="0.0001" Maximum="1.0" Increment="0.001" Value="0.01" FormatString="0.0000" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Kalman_R}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="KalmanRSpin" Minimum="0.0001" Maximum="1.0" Increment="0.01" Value="0.1" FormatString="0.0000" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ARIMA Projection Settings (P, D, Q, Price Type) -->
                <StackPanel x:Name="ArimaProjectionPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Arima_P}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="ArimaPSpin" Minimum="0" Maximum="5" Increment="1" Value="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Arima_D}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="ArimaDSpin" Minimum="0" Maximum="2" Increment="1" Value="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Arima_Q}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="ArimaQSpin" Minimum="0" Maximum="5" Increment="1" Value="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ArimaPriceSourceCombo" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FFT Projection Settings (Harmonics, Detrend, Periods, Price Type) -->
                <StackPanel x:Name="FftProjectionPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_HarmonicCount}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FftHarmonicCountSpin" Minimum="1" Maximum="10" Increment="1" Value="3" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="FftProjectionApplyDetrendCheck" Content="{l:Localize Setting_Fft_ApplyDetrend}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_MinPeriod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FftProjectionMinPeriodSpin" Minimum="2" Maximum="500" Value="3" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_MaxPeriod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FftProjectionMaxPeriodSpin" Minimum="2" Maximum="1000" Value="200" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FftProjectionPriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- HMM Projection Settings (States, MaxIterations, Tolerance, Price Type) -->
                <StackPanel x:Name="HmmProjectionPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Hmm_States}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="HmmStatesSpin" Minimum="2" Maximum="3" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Hmm_MaxIterations}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="HmmMaxIterationsSpin" Minimum="1" Maximum="200" Increment="5" Value="30" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Hmm_Tolerance}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="HmmToleranceSpin" Minimum="0.000001" Maximum="0.01" Increment="0.0001" Value="0.0001" FormatString="0.000000" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="HmmProjectionPriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pearson Projection Settings (Unmatched Color, Min Correlation, TopK, Price Type, Show Match Highlight) -->
                <StackPanel x:Name="PearsonProjectionPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Dtw_UnmatchedColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="PearsonUnmatchedColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Pearson_MinCorrelation}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="PearsonMinCorrelationSpin" Minimum="0.10" Maximum="0.99" Increment="0.05" Value="0.70" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Pearson_TopK}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="PearsonTopKSpin" Minimum="1" Maximum="10" Increment="1" Value="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PearsonProjectionPriceFieldCombo" SelectedIndex="3" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="PearsonApplyVolatilityScalingCheck" Content="{l:Localize Setting_Pearson_ApplyVolatilityScaling}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="PearsonApplyDetrendCheck" Content="{l:Localize Setting_Pearson_ApplyDetrend}" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="PearsonShowMatchHighlightCheck" Content="{l:Localize Setting_Pearson_ShowMatchHighlight}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Fréchet Projection Settings (Unmatched Color, Price Type, Show Match Highlight) -->
                <StackPanel x:Name="FrechetProjectionPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Dtw_UnmatchedColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="FrechetUnmatchedColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FrechetProjectionPriceFieldCombo" SelectedIndex="3" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Frechet_MaxDistance}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FrechetMaxDistanceSpin" Minimum="0.00" Maximum="10.00" Increment="0.10" Value="0.00" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="FrechetShowMatchHighlightCheck" Content="{l:Localize Setting_Pearson_ShowMatchHighlight}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSA Projection Settings (Embedding Dimension, Num Components, Price Type, Apply Detrend) -->
                <StackPanel x:Name="SsaProjectionPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_EmbeddingDimension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaEmbeddingDimensionSpin" Minimum="2" Maximum="100" Increment="1" Value="10" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_NumComponents}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaNumComponentsSpin" Minimum="1" Maximum="10" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaProjectionPriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_DetrendMethod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaProjectionDetrendMethodCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_OLS}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_Endpoint}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_None}"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ForecastMode}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaProjectionForecastModeCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Forecast_Recurrent}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Forecast_Vector}"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="SsaShowReconstructedPathCheck" Content="{l:Localize Setting_Ssa_ShowReconstructedPath}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Auto Time Cycle Settings (Price Type, Detrend, Periods, Alignment, Sub-bin Interpolation) -->
                <StackPanel x:Name="AutoTimeCyclePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AutoTimeCyclePriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="AutoTimeCycleApplyDetrendCheck" Content="{l:Localize Setting_Fft_ApplyDetrend}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_MinPeriod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="AutoTimeCycleMinPeriodSpin" Minimum="2" Maximum="500" Increment="1" Value="5" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_MaxPeriod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="AutoTimeCycleMaxPeriodSpin" Minimum="2" Maximum="1000" Increment="5" Value="200" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_AutoCycle_Alignment}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AutoTimeCycleAlignmentCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_AutoCycle_Alignment_Endpoint}"/>
                            <ComboBoxItem Content="{l:Localize Setting_AutoCycle_Alignment_Peak}"/>
                            <ComboBoxItem Content="{l:Localize Setting_AutoCycle_Alignment_Trough}"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="AutoTimeCycleFrequencyInterpolationCheck" Content="{l:Localize Setting_AutoCycle_SubBinInterpolation}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSA Multi-Component Settings -->
                <StackPanel x:Name="SsaMultiComponentPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_EmbeddingDimension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaMultiEmbeddingDimensionSpin" Minimum="2" Maximum="100" Increment="1" Value="20" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_NumComponents}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaMultiNumComponentsSpin" Minimum="1" Maximum="50" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaMultiPriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_DetrendMethod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaMultiDetrendMethodCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_OLS}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_Endpoint}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_None}"/>
                        </ComboBox>
                    </Grid>
                    <!-- Layer 1: Trend -->
                    <CheckBox x:Name="SsaMultiShowTrendCheck" Content="{l:Localize Setting_Ssa_ShowTrend}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <ColorPicker x:Name="SsaMultiTrendColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding #SsaMultiShowTrendCheck.IsChecked}"/>

                    <!-- Layer 2: Primary Cycle -->
                    <CheckBox x:Name="SsaMultiShowPrimaryCycleCheck" Content="{l:Localize Setting_Ssa_ShowPrimaryCycle}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <ColorPicker x:Name="SsaMultiCycleColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding #SsaMultiShowPrimaryCycleCheck.IsChecked}"/>

                    <!-- Layer 3: Composite -->
                    <CheckBox x:Name="SsaMultiShowCompositeCheck" Content="{l:Localize Setting_Ssa_ShowComposite}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <ColorPicker x:Name="SsaMultiCompositeColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding #SsaMultiShowCompositeCheck.IsChecked}"/>

                    <!-- Layer 4: Noise Band -->
                    <CheckBox x:Name="SsaMultiShowNoiseBandCheck" Content="{l:Localize Setting_Ssa_ShowNoiseBand}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <ColorPicker x:Name="SsaMultiNoiseColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding #SsaMultiShowNoiseBandCheck.IsChecked}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32" IsEnabled="{Binding #SsaMultiShowNoiseBandCheck.IsChecked}">
                        <TextBlock Text="{l:Localize Setting_Ssa_NoiseMultiplier}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaMultiNoiseMultiplierSpin" Minimum="0.1" Maximum="10.0" Increment="0.1" Value="2.0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSA Support & Resistance Settings (Legacy / General) -->
                <StackPanel x:Name="SsaSupportResistancePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<!-- Mode Selector -->
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_Mode}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaSnrModeCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Mode_StructuralPivots}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Mode_DynamicEnvelopes}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Mode_ProjectedTargets}"/>
                        </ComboBox>
                    </Grid>

                    <!-- Embedding Dimension -->
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_EmbeddingDimension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaSnrEmbeddingDimensionSpin" Minimum="2" Maximum="100" Increment="1" Value="15" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Num Components & AutoRank -->
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_NumComponents}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaSnrNumComponentsSpin" Minimum="1" Maximum="50" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="SsaSnrAutoRankCheck" Content="{l:Localize Setting_Ssa_AutoRank}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <!-- Price Type -->
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaSnrPriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>

                    <!-- Detrend Method -->
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_DetrendMethod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaSnrDetrendMethodCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_OLS}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_Endpoint}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_None}"/>
                        </ComboBox>
                    </Grid>

                    <!-- Mode 1 Settings: Max Levels, Cluster Tolerance, Extend Lines -->
                    <StackPanel x:Name="SsaSnrMode1Section" Spacing="8">
                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_MaxLevelsPerSide}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaSnrMaxLevelsSpin" Minimum="1" Maximum="10" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ClusterTolerance}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaSnrClusterToleranceSpin" Minimum="0.1" Maximum="5.0" Increment="0.1" Value="0.5" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        <CheckBox x:Name="SsaSnrExtendLinesCheck" Content="{l:Localize Setting_Ssa_ExtendLinesToRight}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </StackPanel>

                    <!-- Mode 2 Settings: Channel Multiplier & Fill Opacity -->
                    <StackPanel x:Name="SsaSnrMode2Section" Spacing="8">
                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ChannelMultiplier}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaSnrMultiplierSpin" Minimum="0.1" Maximum="10.0" Increment="0.1" Value="2.0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ChannelFillOpacity}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaSnrChannelFillOpacitySpin" Minimum="0" Maximum="100" Increment="5" Value="15" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    </StackPanel>

                    <!-- Mode 3 Settings: Future Steps & Forecast Mode -->
                    <StackPanel x:Name="SsaSnrMode3Section" Spacing="8">
                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ProjectionSteps}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaSnrFutureStepsSpin" Minimum="1" Maximum="100" Increment="1" Value="20" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ForecastMode}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaSnrForecastModeCombo" SelectedIndex="1" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBoxItem Content="{l:Localize Setting_Ssa_Forecast_Recurrent}"/>
                                <ComboBoxItem Content="{l:Localize Setting_Ssa_Forecast_Vector}"/>
                            </ComboBox>
                    </Grid>
                    </StackPanel>

                    <!-- Colors -->
                    <TextBlock Text="{l:Localize Setting_Ssa_ResistanceColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaSnrResistanceColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    <TextBlock Text="{l:Localize Setting_Ssa_SupportColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaSnrSupportColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    <TextBlock Text="{l:Localize Setting_Ssa_CenterColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaSnrCenterColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSA Structural Pivots Settings -->
                <StackPanel x:Name="SsaStructuralPivotsPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_EmbeddingDimension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaPivotsEmbeddingDimensionSpin" Minimum="2" Maximum="100" Increment="1" Value="15" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
