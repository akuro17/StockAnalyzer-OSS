                        <NumericUpDown x:Name="SsaAnomalyEnterThresholdSpin" Minimum="0.5" Maximum="10.0" Increment="0.1" Value="2.0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_SsaAnomaly_ExitThreshold}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaAnomalyExitThresholdSpin" Minimum="0.1" Maximum="5.0" Increment="0.1" Value="1.0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_SsaAnomaly_CoolDownPeriod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaAnomalyCoolDownPeriodSpin" Minimum="1" Maximum="20" Increment="1" Value="3" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_SsaAnomaly_MinDuration}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaAnomalyMinDurationSpin" Minimum="1" Maximum="20" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_SsaAnomaly_HighlightOpacity}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaAnomalyHighlightOpacitySpin" Minimum="0" Maximum="100" Increment="5" Value="25" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="SsaAnomalyShowStructuralLineCheck" Content="{l:Localize Setting_SsaAnomaly_ShowStructuralLine}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="SsaAnomalyShowBoundaryBandsCheck" Content="{l:Localize Setting_SsaAnomaly_ShowBoundaryBands}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="SsaAnomalyShowAnomalyBadgesCheck" Content="{l:Localize Setting_SsaAnomaly_ShowAnomalyBadges}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="{l:Localize Setting_SsaAnomaly_BullishColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaAnomalyBullishColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize Setting_SsaAnomaly_BearishColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaAnomalyBearishColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
