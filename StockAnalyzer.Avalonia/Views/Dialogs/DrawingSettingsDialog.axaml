                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_OLS}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_Endpoint}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_None}"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_MaxLevelsPerSide}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaPivotsMaxLevelsSpin" Minimum="1" Maximum="10" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ClusterTolerance}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaPivotsClusterToleranceSpin" Minimum="0.1" Maximum="5.0" Increment="0.1" Value="0.5" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="SsaPivotsExtendLinesCheck" Content="{l:Localize Setting_Ssa_ExtendLinesToRight}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_ResistanceColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaPivotsResistanceColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_SupportColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaPivotsSupportColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_CenterColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaPivotsCenterColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSA Dynamic Envelopes Settings -->
                <StackPanel x:Name="SsaDynamicEnvelopesPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_EmbeddingDimension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaEnvelopesEmbeddingDimensionSpin" Minimum="2" Maximum="100" Increment="1" Value="15" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
