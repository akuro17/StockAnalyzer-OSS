                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_NumComponents}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaEnvelopesNumComponentsSpin" Minimum="1" Maximum="50" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
