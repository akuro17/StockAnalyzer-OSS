                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_ProjectionSteps}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
