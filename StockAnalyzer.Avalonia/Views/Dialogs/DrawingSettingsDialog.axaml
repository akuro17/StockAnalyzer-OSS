                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Nurbs_Degree}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="NurbsDegreeSpin" Minimum="1" Maximum="5" Value="3" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
