                <!-- Time at Price Settings -->
                <StackPanel x:Name="TimeAtPricePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TapPriceSourceCombo" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Value Area Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="TapValueAreaColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Base Profile Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="TapProfileColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Opacity (0-100)" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <NumericUpDown x:Name="TapOpacitySpin" Minimum="0" Maximum="100" Value="50" FormatString="0"/>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Fill Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="TapFillColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Fill Opacity (0-100)" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <NumericUpDown x:Name="TapFillOpacitySpin" Minimum="0" Maximum="100" Value="10" FormatString="0"/>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Vp_RepeatMode}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TapRepeatModeCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Vp_RepeatMode_Default}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Vp_RepeatMode_RangeBar}"/>
