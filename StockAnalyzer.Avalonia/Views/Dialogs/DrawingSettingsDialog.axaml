                        <NumericUpDown x:Name="SsaAnomalyNumComponentsSpin" Minimum="1" Maximum="50" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
