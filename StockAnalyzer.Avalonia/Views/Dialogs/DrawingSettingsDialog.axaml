                        <NumericUpDown x:Name="HoughResonantFanMaxLinesSpin" Minimum="1" Maximum="12" Increment="1" Value="6" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
