                <!-- Ellipse Settings (Circle toggle + Arc-enable toggle + independent Radius Lines/Chord line toggles) -->
                <StackPanel x:Name="EllipsePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ellipse_ControlPointColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="EllipseControlPointColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="EllipseCircularCheck" Content="{l:Localize Setting_Ellipse_IsEllipseMode}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="EllipseDynamicAspectRatioCheck" Content="{l:Localize Setting_Ellipse_DynamicAspectRatioByDistance}" Foreground="{DynamicResource Brush.Text.Primary}" IsVisible="{Binding #EllipseCircularCheck.IsChecked}"/>
                    <CheckBox x:Name="EllipseArcEnabledCheck" Content="{l:Localize Setting_Ellipse_ArcEnabled}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="EllipseShowRadiusLinesCheck" Content="{l:Localize Setting_Ellipse_ShowRadiusLines}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="EllipseShowChordLineCheck" Content="{l:Localize Setting_Ellipse_ShowChordLine}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="EllipseShowTangentLinesCheck" Content="{l:Localize Setting_Ellipse_ShowTangentLines}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="EllipseExtendTangentLinesToChartCheck" Content="{l:Localize Setting_Ellipse_ExtendTangentLinesToChart}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32" IsVisible="{Binding !#EllipseDynamicAspectRatioCheck.IsChecked}">
                        <TextBlock Text="{l:Localize Setting_Ellipse_AspectRatio}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="EllipseAspectRatioSpin" Minimum="0.1" Maximum="1.0" Increment="0.1" Value="0.5" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ellipse_InnerRadiusRatio}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="EllipseInnerRadiusSpin" Minimum="0" Maximum="0.98" Increment="0.02" Value="0" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ellipse Annulus Settings (Circle toggle + inner-radius fine-tuning) -->
                <StackPanel x:Name="EllipseAnnulusPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<CheckBox x:Name="EllipseAnnulusCircularCheck" Content="{l:Localize Setting_Ellipse_IsCircular}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_EllipseAnnulus_InnerRadiusRatio}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="EllipseAnnulusInnerRadiusSpin" Minimum="0.02" Maximum="0.98" Increment="0.02" Value="0.5" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- NURBS Conic / Ellipse Settings -->
                <StackPanel x:Name="NurbsConicPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<CheckBox x:Name="NurbsConicFilledCheck" Content="{l:Localize Setting_Nurbs_IsFilled}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32" IsVisible="{Binding #NurbsConicFilledCheck.IsChecked}">
                        <TextBlock Text="{l:Localize Setting_Nurbs_FillColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="NurbsConicFillColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- NURBS Weighted Curve Settings (shared by Hyperbola/ConicArc; label/range/increment
                     are set dynamically in NurbsWeightedCurveSettingsPanelDefinition.Populate) -->
                <StackPanel x:Name="NurbsWeightedCurvePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock x:Name="NurbsWeightedCurveWeightLabel" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="NurbsWeightedCurveWeightSpin" Minimum="0" Maximum="1" Increment="0.1" Value="0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Elliott Wave / Polyline Specific Settings -->
                <StackPanel x:Name="ElliottPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<CheckBox x:Name="PolylineSmoothCheck" Content="{l:Localize Setting_Polyline_IsSmooth}" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32" IsVisible="{Binding #PolylineSmoothCheck.IsChecked}">
                        <TextBlock Text="{l:Localize Setting_Polyline_Tension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="PolylineTensionSpin" Minimum="0.0" Maximum="1.0" Increment="0.1" Value="0.5" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Label Type" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LabelTypeCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Numeric (1, 2, 3...)"/>
                            <ComboBoxItem Content="Alphabet (A, B, C...)"/>
                        </ComboBox>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Font Size" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FontSizeSpin" Minimum="8" Maximum="72" Value="12" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <CheckBox x:Name="ShowLabelsCheck" Content="Show Labels" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Range Spline Settings -->
                <StackPanel x:Name="RangeSplinePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<CheckBox x:Name="RangeSplineShowResistanceCheck" Content="{l:Localize Setting_RangeSpline_ShowResistance}" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="RangeSplineShowSupportCheck" Content="{l:Localize Setting_RangeSpline_ShowSupport}" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ComboBox x:Name="RangeSplinePriceFieldCombo" SelectedIndex="3" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Open"/>
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Close"/>
                        <ComboBoxItem Content="Median (H+L)/2"/>
                        <ComboBoxItem Content="Midpoint (O+C)/2"/>
                        <ComboBoxItem Content="Typical (H+L+C)/3"/>
                        <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                        <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                        <ComboBoxItem Content="Heikin-Ashi Open"/>
                        <ComboBoxItem Content="Heikin-Ashi High"/>
                        <ComboBoxItem Content="Heikin-Ashi Low"/>
                        <ComboBoxItem Content="Heikin-Ashi Close"/>
                        <ComboBoxItem Content="True High"/>
                        <ComboBoxItem Content="True Low"/>
                    </ComboBox>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_RangeSpline_Tension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="RangeSplineTensionSpin" Minimum="0.0" Maximum="1.0" Increment="0.1" Value="0.5" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_RangeSpline_MinSwing}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="RangeSplineMinSwingSpin" Minimum="0.1" Maximum="50.0" Increment="0.5" Value="2.0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_RangeSpline_MaxLevels}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="RangeSplineMaxLevelsSpin" Minimum="1" Maximum="20" Increment="1" Value="5" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Auto Elliott Wave Settings -->
                <StackPanel x:Name="AutoElliottPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_FillColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="AutoElliottFillColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_FillOpacity}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="AutoElliottFillOpacitySpin" Minimum="0" Maximum="100" Value="10" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{l:Localize Setting_Geom_Threshold}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox x:Name="AutoElliottAutoZigZagCheck" Content="{l:Localize Setting_Geom_Auto}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <NumericUpDown x:Name="AutoElliottZigZagThresholdSpin" Minimum="0.5" Maximum="20.0" Increment="0.5" Value="2.0" FormatString="0.0" IsEnabled="{Binding !#AutoElliottAutoZigZagCheck.IsChecked}"/>
                    </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- Horizontal Line Settings -->
                <StackPanel x:Name="HorizontalLinePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Price" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="PriceSpin" Increment="0.01" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Price Label Settings -->
                <StackPanel x:Name="PriceLabelPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Font Size" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="PriceFontSizeSpin" Minimum="8" Maximum="72" Value="12" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Text Settings -->
                <StackPanel x:Name="TextPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<StackPanel Spacing="4">
                        <TextBlock Text="Content" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                        <TextBox x:Name="TextContentBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Font Size" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="TextFontSizeSpin" Minimum="8" Maximum="72" Value="12" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Alignment" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TextAlignmentCombo" SelectedIndex="0" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Left"/>
                            <ComboBoxItem Content="Center"/>
                            <ComboBoxItem Content="Right"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="TextShowBackgroundCheck" Content="Show Background Box" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                    <StackPanel x:Name="TextBackgroundDetailsPanel" Spacing="8" IsVisible="{Binding #TextShowBackgroundCheck.IsChecked}">
                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Background Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="TextBackgroundColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                            <TextBlock Text="Padding" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="TextPaddingSpin" Minimum="0" Maximum="32" Value="8" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                            <TextBlock Text="Corner Radius" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="TextCornerRadiusSpin" Minimum="0" Maximum="32" Value="4" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Line Text Settings (Top/Bottom fully independent). Shared by LineTextObject (straight)
                     and CurveLineTextObject (curved) — both implement ILineTextAnnotatedObject. -->
                <StackPanel x:Name="LineTextPanel" Spacing="12" IsVisible="False">
                    <!-- Top Text Card -->
                    <Border Classes="SettingsCard">
                        <StackPanel x:Name="LineTextTopColumnPanel" Spacing="10">
                            <TextBlock Text="Top Text Annotation" FontWeight="SemiBold" FontSize="{DynamicResource BaseFontSize}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Text" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <TextBox x:Name="LineTextTopTextBox" Height="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Font Size" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <NumericUpDown x:Name="LineTextTopFontSizeSpin" Width="120" Height="30" HorizontalAlignment="Right" Minimum="8" Maximum="72" Value="12" FormatString="0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Alignment" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ComboBox x:Name="LineTextTopAlignmentCombo" Width="140" HorizontalAlignment="Right" SelectedIndex="0">
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Right"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Offset" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <NumericUpDown x:Name="LineTextTopOffsetSpin" Width="120" Height="30" HorizontalAlignment="Right" Minimum="0" Maximum="100" Value="10" FormatString="0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Font Color" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ColorPicker x:Name="LineTextTopColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Rotation" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ComboBox x:Name="LineTextTopRotationCombo" Width="140" HorizontalAlignment="Right" SelectedIndex="1">
                                    <ComboBoxItem Content="Follow Line"/>
                                    <ComboBoxItem Content="Upright"/>
                                    <ComboBoxItem Content="Auto-Flip"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Orientation" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ComboBox x:Name="LineTextTopOrientationCombo" Width="140" HorizontalAlignment="Right" SelectedIndex="0">
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="Mirror"/>
                                    <ComboBoxItem Content="180° Rotate"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="LineTextTopReverseOrderCheck" Content="Reverse Order" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <CheckBox x:Name="LineTextTopPositionFixedCheck" Content="Keep Same Side" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <CheckBox x:Name="LineTextTopPositionLockedCheck" Content="Lock Position" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <CheckBox x:Name="LineTextTopExtendBeyondLineCheck" Content="Show Text Beyond Line" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Text Card -->
                    <Border Classes="SettingsCard">
                        <StackPanel x:Name="LineTextBottomColumnPanel" Spacing="10">
                            <TextBlock Text="Bottom Text Annotation" FontWeight="SemiBold" FontSize="{DynamicResource BaseFontSize}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Text" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <TextBox x:Name="LineTextBottomTextBox" Height="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Font Size" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <NumericUpDown x:Name="LineTextBottomFontSizeSpin" Width="120" Height="30" HorizontalAlignment="Right" Minimum="8" Maximum="72" Value="12" FormatString="0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Alignment" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ComboBox x:Name="LineTextBottomAlignmentCombo" Width="140" HorizontalAlignment="Right" SelectedIndex="0">
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Right"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Offset" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <NumericUpDown x:Name="LineTextBottomOffsetSpin" Width="120" Height="30" HorizontalAlignment="Right" Minimum="0" Maximum="100" Value="10" FormatString="0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Font Color" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ColorPicker x:Name="LineTextBottomColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Rotation" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ComboBox x:Name="LineTextBottomRotationCombo" Width="140" HorizontalAlignment="Right" SelectedIndex="1">
                                    <ComboBoxItem Content="Follow Line"/>
                                    <ComboBoxItem Content="Upright"/>
                                    <ComboBoxItem Content="Auto-Flip"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                                <TextBlock Text="Orientation" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                                <ComboBox x:Name="LineTextBottomOrientationCombo" Width="140" HorizontalAlignment="Right" SelectedIndex="0">
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="Mirror"/>
                                    <ComboBoxItem Content="180° Rotate"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="LineTextBottomReverseOrderCheck" Content="Reverse Order" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <CheckBox x:Name="LineTextBottomPositionFixedCheck" Content="Keep Same Side" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <CheckBox x:Name="LineTextBottomPositionLockedCheck" Content="Lock Position" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <CheckBox x:Name="LineTextBottomExtendBeyondLineCheck" Content="Show Text Beyond Line" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Volume Profile Settings -->
                <StackPanel x:Name="VolumeProfilePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Value Area Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="ValueAreaColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Base Volume Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="ProfileColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Opacity (0-100)" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="OpacitySpin" Minimum="0" Maximum="100" Value="50" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Fill Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="VpFillColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Fill Opacity (0-100)" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="VpFillOpacitySpin" Minimum="0" Maximum="100" Value="10" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Vp_RepeatMode}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="VpRepeatModeCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Vp_RepeatMode_Default}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Vp_RepeatMode_RangeBar}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Vp_RepeatMode_Weekly}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Vp_RepeatMode_Monthly}"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="VpLockRangeCheck" Content="Lock Range" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Range Bars" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="VpRangeBarsSpin" Minimum="1" Maximum="100000" Value="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Anchored VWAP Settings (Price Type) -->
                <StackPanel x:Name="AnchoredVwapPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AnchoredVwapPriceFieldCombo" SelectedIndex="6" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FFT Spectrum Settings -->
                <StackPanel x:Name="FftSpectrumPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_PeakColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="FftPeakColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FftPriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_MinPeriod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FftMinPeriodSpin" Minimum="2" Maximum="500" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Fft_MaxPeriod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FftMaxPeriodSpin" Minimum="2" Maximum="500" Value="100" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox x:Name="FftDetrendCheck" Content="{l:Localize Setting_Fft_ApplyDetrend}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="FftWindowCheck" Content="{l:Localize Setting_Fft_ApplyWindow}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_FillOpacity}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="FftOpacitySpin" Minimum="0" Maximum="100" Value="60" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Bar Pattern Settings -->
                <StackPanel x:Name="BarPatternPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Up Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="BarUpColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Down Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="BarDownColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Opacity (%)" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="BarOpacitySpin" Minimum="0" Maximum="100" Increment="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Long/Short Position Settings -->
                <StackPanel x:Name="LongShortPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Entry Price" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="LsEntryPriceSpin" Increment="0.01" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Target Price" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="LsTargetPriceSpin" Increment="0.01" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Stop Price" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="LsStopPriceSpin" Increment="0.01" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Target Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="LsTargetColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Stop Color" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="LsStopColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="Opacity (%)" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="LsOpacitySpin" Minimum="0" Maximum="100" Increment="1" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Geometric Pattern Settings -->
                <StackPanel x:Name="GeometricPatternPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<TextBlock Text="{l:Localize Setting_Geom_Threshold}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox x:Name="AutoZigZagCheck" Content="{l:Localize Setting_Geom_Auto}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <NumericUpDown x:Name="ZigZagThresholdSpin" Minimum="0.5" Maximum="20.0" Increment="0.5" Value="2.0" FormatString="0.0" IsEnabled="{Binding !#AutoZigZagCheck.IsChecked}"/>
                    </StackPanel>

                    <TextBlock Text="{l:Localize Setting_Geom_DisplayedPatterns}" Foreground="{DynamicResource Brush.Dialog.LabelText}" Margin="0,5,0,0"/>
                    <CheckBox x:Name="ShowChannelsCheck" Content="{l:Localize Setting_Geom_Channels}" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <CheckBox x:Name="ShowWedgesCheck" Content="{l:Localize Setting_Geom_Wedges}" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <CheckBox x:Name="ShowTrianglesCheck" Content="{l:Localize Setting_Geom_Triangles}" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <CheckBox x:Name="ShowPennantsCheck" Content="{l:Localize Setting_Geom_Pennants}" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <CheckBox x:Name="ShowMegaphoneCheck" Content="{l:Localize Setting_Geom_Megaphone}" Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Harmonic Pattern Settings -->
                <StackPanel x:Name="HarmonicPatternPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_FillColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="HarmonicFillColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_FillOpacity}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="HarmonicFillOpacitySpin" Minimum="0" Maximum="100" Value="10" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{l:Localize Setting_Geom_Threshold}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox x:Name="HarmonicAutoZigZagCheck" Content="{l:Localize Setting_Geom_Auto}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <NumericUpDown x:Name="HarmonicZigZagThresholdSpin" Minimum="0.5" Maximum="20.0" Increment="0.5" Value="2.0" FormatString="0.0" IsEnabled="{Binding !#HarmonicAutoZigZagCheck.IsChecked}"/>
                    </StackPanel>
                    <CheckBox x:Name="HarmonicShowPrzCheck" Content="Potential Reversal Zone" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </StackPanel> <!-- SpecificSettingsSection -->

            </StackPanel> <!-- SettingsContentPanel -->
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource Brush.Background.Tertiary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="24,0">
                <Button x:Name="DeleteButton" Grid.Column="0" Content="Delete" Click="OnDeleteClick" Classes="FooterBtn"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="OkButton" Content="OK" Click="OnOkClick" Classes="FooterBtn"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" Classes="FooterBtn"/>
                    <Button x:Name="ApplyButton" Content="Apply" Click="OnApplyClick" Classes="FooterBtn"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
