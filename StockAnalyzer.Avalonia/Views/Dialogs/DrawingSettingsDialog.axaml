                        <TextBlock Text="{l:Localize Label_FontColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ColorPicker x:Name="InformationFontColorPicker"  Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_FontSize}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="InformationFontSizeSpin" Minimum="8" Maximum="72" Value="12" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

