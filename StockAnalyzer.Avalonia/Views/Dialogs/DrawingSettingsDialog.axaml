                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_Endpoint}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_None}"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ChannelMultiplier}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaEnvelopesMultiplierSpin" Minimum="0.1" Maximum="10.0" Increment="0.1" Value="2.0" FormatString="0.0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ChannelFillOpacity}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaEnvelopesChannelFillOpacitySpin" Minimum="0" Maximum="100" Increment="5" Value="15" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{l:Localize Setting_Ssa_UpperBandColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaEnvelopesResistanceColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_LowerBandColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaEnvelopesSupportColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_CenterColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaEnvelopesCenterColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSA Projected Targets Settings -->
                <StackPanel x:Name="SsaProjectedTargetsPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_EmbeddingDimension}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaTargetsEmbeddingDimensionSpin" Minimum="2" Maximum="100" Increment="1" Value="15" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_NumComponents}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaTargetsNumComponentsSpin" Minimum="1" Maximum="50" Increment="1" Value="2" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="SsaTargetsAutoRankCheck" Content="{l:Localize Setting_Ssa_AutoRank}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Label_PriceType}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaTargetsPriceFieldCombo" SelectedIndex="4" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
                            <ComboBoxItem Content="Typical (H+L+C)/3"/>
                            <ComboBoxItem Content="Weighted (H+L+2C)/4"/>
                            <ComboBoxItem Content="Average (O+H+L+C)/4"/>
                            <ComboBoxItem Content="Heikin-Ashi Open"/>
                            <ComboBoxItem Content="Heikin-Ashi High"/>
                            <ComboBoxItem Content="Heikin-Ashi Low"/>
                            <ComboBoxItem Content="Heikin-Ashi Close"/>
                            <ComboBoxItem Content="True High"/>
                            <ComboBoxItem Content="True Low"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_DetrendMethod}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaTargetsDetrendMethodCombo" SelectedIndex="0" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_OLS}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_Endpoint}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Detrend_None}"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ProjectionSteps}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="SsaTargetsFutureStepsSpin" Minimum="1" Maximum="100" Increment="1" Value="20" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Ssa_ForecastMode}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SsaTargetsForecastModeCombo" SelectedIndex="1" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Forecast_Recurrent}"/>
                            <ComboBoxItem Content="{l:Localize Setting_Ssa_Forecast_Vector}"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="SsaTargetsExtendLinesCheck" Content="{l:Localize Setting_Ssa_ExtendLinesToRight}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_TargetResistanceColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaTargetsResistanceColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_TargetSupportColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaTargetsSupportColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Localize Setting_Ssa_CenterColor}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <ColorPicker x:Name="SsaTargetsCenterColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSA Anomaly Highlight Settings -->
