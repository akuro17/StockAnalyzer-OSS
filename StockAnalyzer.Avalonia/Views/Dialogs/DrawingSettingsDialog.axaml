                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Close"/>
                            <ComboBoxItem Content="Median (H+L)/2"/>
                            <ComboBoxItem Content="Midpoint (O+C)/2"/>
