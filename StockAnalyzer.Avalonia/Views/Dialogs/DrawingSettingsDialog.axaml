                    <CheckBox x:Name="TapLockRangeCheck" Content="Lock Range" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <TextBlock Text="Range Bars" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <NumericUpDown x:Name="TapRangeBarsSpin" Minimum="1" Maximum="100000" Value="1" FormatString="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cyclic Lines Settings Panel (Custom Intervals / Range) -->
                <StackPanel x:Name="CyclicLinesPanel" Spacing="6" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<TextBlock Text="{l:Localize Setting_CyclicLines_CustomRange}" Foreground="{DynamicResource Brush.Dialog.LabelText}"/>
                    <Grid ColumnDefinitions="Auto, *">
                        <CheckBox x:Name="CyclicLinesCustomRangeCheck" IsChecked="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="CyclicLinesCustomRangeTextBox" Grid.Column="1" Text="1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144, 169, 196, 225, 256, 289, 324, 361, 400" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox x:Name="CyclicLinesCustomModeCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{l:Localize Setting_CyclicLines_Mode_AnchorForwardDays}"/>
                        <ComboBoxItem Content="{l:Localize Setting_CyclicLines_Mode_TwoPointRange}"/>
                    </ComboBox>
                        </StackPanel>
                    </Border>
