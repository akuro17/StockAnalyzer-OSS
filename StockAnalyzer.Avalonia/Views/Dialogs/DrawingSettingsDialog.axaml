<CheckBox x:Name="IchimokuShowLabelsCheck" Content="{l:Localize Setting_Ichimoku_ShowLabels}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
