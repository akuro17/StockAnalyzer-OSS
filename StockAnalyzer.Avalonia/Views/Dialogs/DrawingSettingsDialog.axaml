<CheckBox x:Name="ShowProjectionCheck" Content="{l:Localize Setting_Trend_ShowProjection}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Trend_ProjectionColumns}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="ProjectionColumnsSpin" Minimum="1" Maximum="100" Value="10" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Catenary Curve Settings -->
                <StackPanel x:Name="CatenaryCurvePanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Catenary_P0Price}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="CatenaryP0PriceSpin" Increment="0.01" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Catenary_P1Price}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="CatenaryP1PriceSpin" Increment="0.01" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Catenary_P2Price}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="CatenaryP2PriceSpin" Increment="0.01" FormatString="0.00" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox x:Name="CatenaryShowProjectionCheck" Content="{l:Localize Setting_Catenary_ShowProjection}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Catenary_ProjectionBars}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="CatenaryProjectionBarsSpin" Minimum="1" Maximum="100" Value="10" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Hough Auto Lines Settings -->
                <StackPanel x:Name="HoughAutoLinesPanel" Spacing="8" IsVisible="False">
                    <Border Classes="SettingsCard">
                        <StackPanel Spacing="10">
<Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Hough_PivotWindow}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="HoughAutoLinesPivotSpin" Minimum="1" Maximum="15" Increment="1" Value="3" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Hough_VoteThreshold}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="HoughAutoLinesThresholdSpin" Minimum="2" Maximum="20" Increment="1" Value="3" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" MinHeight="32">
                        <TextBlock Text="{l:Localize Setting_Hough_MaxLines}" Foreground="{DynamicResource Brush.Dialog.LabelText}" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="HoughAutoLinesMaxLinesSpin" Minimum="1" Maximum="10" Increment="1" Value="5" FormatString="0" Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="HoughAutoLinesShowChannelsCheck" Content="{l:Localize Setting_Hough_ShowChannels}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="HoughAutoLinesShowLabelsCheck" Content="{l:Localize Setting_Hough_ShowLabels}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <CheckBox x:Name="HoughAutoLinesExtendRightCheck" Content="{l:Localize Setting_Hough_ExtendLinesToRight}" IsChecked="False" Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <!-- Trend Line Visibility & Color -->
                    <CheckBox x:Name="HoughAutoLinesShowTrendCheck" Content="{l:Localize Setting_Hough_TrendLine}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <ColorPicker x:Name="HoughAutoLinesTrendColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding #HoughAutoLinesShowTrendCheck.IsChecked}"/>

                    <!-- Support Line Visibility & Color -->
                    <CheckBox x:Name="HoughAutoLinesShowSupportCheck" Content="{l:Localize Setting_Hough_SupportLine}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <ColorPicker x:Name="HoughAutoLinesSupportColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding #HoughAutoLinesShowSupportCheck.IsChecked}"/>

                    <!-- Resistance Line Visibility & Color -->
                    <CheckBox x:Name="HoughAutoLinesShowResistanceCheck" Content="{l:Localize Setting_Hough_ResistanceLine}" IsChecked="True" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <ColorPicker x:Name="HoughAutoLinesResistanceColorPicker" Width="50" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding #HoughAutoLinesShowResistanceCheck.IsChecked}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Hough Parabolic Curve Settings -->
