        <StreamGeometry x:Key="SettingsThemeIcon">M12,3c-4.97,0-9,4.03-9,9s4.03,9,9,9c0.83,0,1.5-0.67,1.5-1.5c0-0.39-0.15-0.75-0.39-1.02c-0.25-0.28-0.4-0.64-0.4-1.03 c0-0.83,0.67-1.5,1.5-1.5h1.91c2.97,0,5.38-2.41,5.38-5.38C21.38,6.03,17.18,3,12,3z M6.5,12c-0.83,0-1.5-0.67-1.5-1.5S5.67,9,6.5,9 S8,9.67,8,10.5S7.33,12,6.5,12z M9.5,8C8.67,8,8,7.33,8,6.5S8.67,5,9.5,5S11,5.67,11,6.5S10.33,8,9.5,8z M14.5,8 c-0.83,0-1.5-0.67-1.5-1.5S13.67,5,14.5,5s1.5,0.67,1.5,1.5S15.33,8,14.5,8z M17.5,12c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5 s1.5,0.67,1.5,1.5S18.33,12,17.5,12z</StreamGeometry>
        <StreamGeometry x:Key="SettingsChartIcon">M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M9,17H7v-7h2V17z M13,17h-2V7h2V17z M17,17h-2v-4h2V17z</StreamGeometry>
        <StreamGeometry x:Key="SettingsNotifyIcon">M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z</StreamGeometry>
        <StreamGeometry x:Key="SettingsConnIcon">M12,11c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,11,12,11z M18,13c0-3.31-2.69-6-6-6s-6,2.69-6,6c0,1.66,0.67,3.16,1.76,4.24 l1.42-1.42C8.45,15.1,8,14.11,8,13c0-2.21,1.79-4,4-4s4,1.79,4,4c0,1.11-0.45,2.1-1.18,2.82l1.42,1.42C17.33,16.16,18,14.66,18,13z M12,3C6.48,3,2,7.48,2,13c0,2.76,1.12,5.26,2.93,7.07l1.41-1.41C4.85,17.15,4,15.18,4,13c0-4.41,3.59-8,8-8s8,3.59,8,8 c0,2.18-0.85,4.15-2.34,5.66l1.41,1.41C20.88,18.26,22,15.76,22,13C22,7.48,17.52,3,12,3z</StreamGeometry>
        <StreamGeometry x:Key="SettingsAdvIcon">M19.43,12.98c0.04-0.32,0.07-0.64,0.07-0.98s-0.03-0.66-0.07-0.98l2.11-1.65c0.19-0.15,0.24-0.42,0.12-0.64 l-2-3.46c-0.12-0.22-0.39-0.31-0.61-0.22l-2.49,1c-0.52-0.4-1.08-0.73-1.69-0.98l-0.38-2.65C14.46,2.18,14.25,2,14,2h-4 C9.75,2,9.54,2.18,9.51,2.42L9.13,5.07C8.52,5.32,7.96,5.66,7.44,6.05l-2.49-1c-0.22-0.09-0.49,0-0.61,0.22l-2,3.46 C2.22,8.95,2.27,9.22,2.46,9.37l2.11,1.65C4.53,11.34,4.5,11.66,4.5,12s0.03,0.66,0.07,0.98l-2.11,1.65 c-0.19,0.15-0.24,0.42-0.12,0.64l2,3.46c0.12,0.22,0.39,0.31,0.61,0.22l2.49-1c0.52,0.4,1.08,0.73,1.69,0.98l0.38,2.65 C9.54,21.82,9.75,22,10,22h4c0.25,0,0.46-0.18,0.49-0.42l0.38-2.65c0.61-0.25,1.17-0.59,1.69-0.98l2.49,1 c0.22,0.09,0.49,0,0.61-0.22l2-3.46c0.12-0.22,0.07-0.49-0.12-0.64L19.43,12.98z M12,15.5c-1.93,0-3.5-1.57-3.5-3.5s1.57-3.5,3.5-3.5 s3.5,1.57,3.5,3.5S13.93,15.5,12,15.5z</StreamGeometry>
        <StreamGeometry x:Key="SettingsPythonIcon">M9.4,16.6L4.8,12l4.6-4.6L8,6l-6,6l6,6L9.4,16.6z M14.6,16.6l4.6-4.6l-4.6-4.6L16,6l6,6l-6,6L14.6,16.6z</StreamGeometry>
        <StreamGeometry x:Key="SettingsAboutIcon">M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-6h2V17z M13,9h-2V7h2V9z</StreamGeometry>

        <!-- Action Icons -->
