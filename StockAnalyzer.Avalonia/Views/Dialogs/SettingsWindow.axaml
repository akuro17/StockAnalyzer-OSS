<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
        xmlns:models="using:StockAnalyzer.Avalonia.Models"
        xmlns:conv="using:StockAnalyzer.Avalonia.Converters"
        xmlns:l="using:StockAnalyzer.Avalonia.Markup"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="760"
        x:Class="StockAnalyzer.Avalonia.Views.Dialogs.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="1060" Height="760"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource Brush.Background.Primary}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <!-- Mock data for designer -->
    </Design.DataContext>

    <Grid ColumnDefinitions="240, *" RowDefinitions="56, *, 64">
        
        <!-- Sidebar (Integrated Header + TreeView) -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="56, *">
                <!-- Sidebar Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                        BorderThickness="0,0,0,1"
                        PointerPressed="OnHeaderPointerPressed"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0" Spacing="12">
                        <PathIcon Data="{StaticResource SettingsIconData}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                        <TextBlock Text="{l:Localize Settings_WindowTitle}" 
                                   FontSize="{DynamicResource BaseFontSize}" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Sidebar Navigation -->
                <TreeView Grid.Row="1"
                          x:Name="CategoryTreeView"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,4">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="28"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:SettingsCategory">
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,1" Opacity="{Binding IsImplemented, Converter={StaticResource BoolToOpacityConverter}}">
                                <TextBlock Text="{Binding TitleKey, Converter={StaticResource LocalizeConverter}}" 
                                           FontSize="{DynamicResource BaseFontSize}"
                                           VerticalAlignment="Center"
                                           FontWeight="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected, Converter={StaticResource SelectionToFontWeightConverter}}"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- Main Content Header -->
        <Border Grid.Row="0" Grid.Column="1"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnHeaderPointerPressed"
                Background="Transparent">
            <TextBlock Text="{Binding SelectedCategory.TitleKey, Converter={StaticResource LocalizeConverter}}" 
                       FontSize="{DynamicResource TitleFontSize}" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center"
                       Margin="40,0"/>
        </Border>

        <!-- Main Content Page -->
        <Border Grid.Row="1" Grid.Column="1" Padding="40">
            <TransitioningContentControl Content="{Binding CurrentPage}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.25" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" 
                Background="{DynamicResource Brush.Background.Tertiary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="24,0">
                <!-- Left: Reset Page -->
                <Button Grid.Column="0" 
                        Content="{l:Localize Btn_ResetToDefault}" 
                        Command="{Binding ResetCurrentPageCommand}"
                        Classes="accent"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"/>
                
                <!-- Right: OK / Cancel / Apply -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="{l:Localize Btn_OK}" 
                            Command="{Binding SaveAndCloseCommand}"
                            Classes="accent"
                            HorizontalContentAlignment="Center"
                            Width="100"/>
                      <Button Content="{l:Localize Btn_Cancel}" 
                            Command="{Binding DiscardAndCloseCommand}"
                            Classes="accent"
                            HorizontalContentAlignment="Center"
                            Width="100"/>
                      <Button Content="{l:Localize Btn_Apply}" 
                            Command="{Binding SaveAllChangesCommand}"
                            Classes="accent"
                            HorizontalContentAlignment="Center"
                            Width="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <conv:SelectionToBrushConverter x:Key="SelectionToBrushConverter"/>
        <conv:SelectionToFontWeightConverter x:Key="SelectionToFontWeightConverter"/>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <conv:IconKeyToDataConverter x:Key="IconKeyToDataConverter"/>
        <conv:LocalizeConverter x:Key="LocalizeConverter"/>

