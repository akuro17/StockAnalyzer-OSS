<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
             xmlns:l="using:StockAnalyzer.Avalonia.Markup"
             xmlns:conv="using:StockAnalyzer.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="StockAnalyzer.Avalonia.Views.Dialogs.TickersSettingsView"
             x:DataType="vm:TickersSettingsViewModel">

    <UserControl.Resources>
        <conv:EnumToLocalizedNameConverter x:Key="EnumToLocalizedNameConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:TickersSettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="16">

            <!-- Section: Auto Play (all text styles come from the global Theme/Fonts resources, SA_UI_INTERACTION section 12) -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Tickers_AutoPlayTitle}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    <TextBlock Text="{l:Localize Settings_Tickers_AutoPlayDesc}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>

                    <UniformGrid Columns="2">
                        <!-- 1. Stop at list end -->
                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Tickers_Item_StopAtListEnd}" FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedAutoPlayStopAtListEnd}" OnContent="" OffContent=""/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Tickers_Desc_StopAtListEnd}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 2. Stop on list change -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Tickers_Item_StopOnListChange}" FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedAutoPlayStopOnListChange}" OnContent="" OffContent=""/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Tickers_Desc_StopOnListChange}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 3. Interval (seconds); bounds come from the ViewModel (appsettings.json), not from literals here -->
                        <StackPanel Margin="0,0,24,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Tickers_Item_IntervalSeconds}" FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding SelectedAutoPlayIntervalSeconds}"
                                               Minimum="{Binding AutoPlayMinIntervalSeconds}"
                                               Maximum="{Binding AutoPlayMaxIntervalSeconds}"
                                               Increment="1" FormatString="0"
                                               Width="110" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Tickers_Desc_IntervalSeconds}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Section: Columns (Column Customization dropdown selection scope) -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Tickers_ColumnsTitle}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    <TextBlock Text="{l:Localize Settings_Tickers_ColumnsDesc}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,24,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Tickers_Item_ColumnSelectionScope}" FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="150"
                                          ItemsSource="{Binding ColumnSelectionScopeOptions}"
                                          SelectedItem="{Binding SelectedColumnSelectionScope}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedNameConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Tickers_Desc_ColumnSelectionScope}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
