<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
             xmlns:vconv="using:StockAnalyzer.Avalonia.Converters"
             xmlns:l="using:StockAnalyzer.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="StockAnalyzer.Avalonia.Views.Dialogs.Chart.ThreeLineBreakSettingsView"
             x:DataType="vm:ThreeLineBreakSettingsViewModel">

    <UserControl.Resources>
        <vconv:HsvDataToAvaloniaHsvColorConverter x:Key="HsvConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="16">
            
            <!-- Color Settings -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Chart_Appearance}" FontWeight="SemiBold" FontSize="{DynamicResource DetailFontSize}"/>
                    
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_UpCandle}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <ColorPicker Grid.Column="1" HsvColor="{Binding UpColor, Mode=TwoWay, Converter={StaticResource HsvConverter}}" Width="50" Height="28"/>
                        </Grid>
                        
                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_DownCandle}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <ColorPicker Grid.Column="1" HsvColor="{Binding DownColor, Mode=TwoWay, Converter={StaticResource HsvConverter}}" Width="50" Height="28"/>
                        </Grid>

                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_BreakoutBullishColor}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <ColorPicker Grid.Column="1" HsvColor="{Binding BreakoutBullishColor, Mode=TwoWay, Converter={StaticResource HsvConverter}}" Width="50" Height="28"/>
                        </Grid>

                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_BreakoutBearishColor}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <ColorPicker Grid.Column="1" HsvColor="{Binding BreakoutBearishColor, Mode=TwoWay, Converter={StaticResource HsvConverter}}" Width="50" Height="28"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Display Settings -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Chart_BreakoutPatterns}" FontWeight="SemiBold" FontSize="{DynamicResource DetailFontSize}"/>
                    
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_MultiWave}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowMultiWavePatterns}" OnContent="" OffContent=""/>
                        </Grid>

                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1" IsVisible="{Binding ShowMultiWavePatterns}"/>

                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding ShowMultiWavePatterns}">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_MultiWaveMaxLines}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <NumericUpDown Grid.Column="1" Width="150" Height="28"
                                           Value="{Binding MultiWaveMaxLines}" Minimum="1" Maximum="20" Increment="1"/>
                        </Grid>

                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_GhostProjections}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGhostProjections}" OnContent="" OffContent=""/>
                        </Grid>

                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1" IsVisible="{Binding ShowGhostProjections}"/>

                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding ShowGhostProjections}">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_GhostFontSize}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding GhostFontSize}" Minimum="6" Maximum="48" Width="120" Height="28"/>
                        </Grid>

                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1" IsVisible="{Binding ShowGhostProjections}"/>

                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding ShowGhostProjections}">
                            <TextBlock Text="{l:Localize Settings_Chart_Item_ShowLabelsOnHoverOnly}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowLabelsOnHoverOnly}" OnContent="" OffContent=""/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Description -->
            <TextBlock Text="{l:Localize Settings_Chart_ThreeLineBreak_Desc}" 
                       FontSize="{DynamicResource HelperFontSize}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextWrapping="Wrap"
                       Margin="4,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
