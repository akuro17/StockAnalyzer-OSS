<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
        xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
        xmlns:conv="clr-namespace:StockAnalyzer.Avalonia.Converters"
        xmlns:controls="clr-namespace:StockAnalyzer.Avalonia.Views.Controls;assembly=StockAnalyzer.Avalonia"
        xmlns:views="using:StockAnalyzer.Avalonia.Views.Dialogs"
        xmlns:c="using:StockAnalyzer.Avalonia.Common"
        xmlns:behaviors="using:StockAnalyzer.Avalonia.Behaviors"
        xmlns:sys="using:System"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="800"
        x:Class="StockAnalyzer.Avalonia.Views.Dialogs.TrainingWizardWindow"
        x:DataType="dialogs:TrainingWizardViewModel"
        Icon="avares://StockAnalyzer.Avalonia/Assets/avalonia-logo.ico"
        Title="{l:Localize TrainingWizard_Title}"
        Width="1180" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <StreamGeometry x:Key="TrainingWizardIconData">M13,3V9H21V3M13,21H21V11H13M3,21H11V15H3M3,13H11V3H3V13Z</StreamGeometry>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <conv:EnumToLocalizedDisplayNameConverter x:Key="EnumToLocalizedDisplayNameConverter"/>

        <!-- Minimum laid-out width of the Per-Fold Results grid: the two fixed 64px columns
             (Fold / N) plus the four metric columns held at a readable ~110px. Below this the
             enclosing card scrolls horizontally instead of letting the star columns collapse and
             clip their text. Named here (not inline) per CLAUDE.md's hardcoded-value prohibition. -->
        <sys:Double x:Key="TrainingWizardFoldTableMinWidth">568</sys:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Tertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="TextBox.clipInvalid">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Semantic.Error}"/>
        </Style>
        <Style Selector="Grid.foldRow > TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource DetailFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>

        <!-- The calendar picker's default button draws a day number; the shared resource replaces it with the date_range icon. -->
        <StyleInclude Source="avares://StockAnalyzer.Avalonia/Assets/CalendarDatePickerIcon.axaml"/>

        <!-- The ticker-list tree (written for this window): rows of the ticker tab's list view, expanded, minimum row height. -->
        <Style Selector="TreeView.tickers TreeViewItem">
            <Setter Property="MinHeight" Value="{x:Static c:TrainingWizardUiLayout.SourceRowHeight}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style Selector="TreeView.tickers TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="MinHeight" Value="{x:Static c:TrainingWizardUiLayout.SourceRowHeight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding StartTrainingCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <dialogs:TrainingWizardViewModel/>
    </Design.DataContext>

    <Border BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="1">
        <Grid RowDefinitions="56,*,64">
            <!-- Header (56px) -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0"
                    Background="{DynamicResource Brush.Background.Tertiary}"
                    PointerPressed="OnHeaderPointerPressed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <PathIcon Data="{StaticResource TrainingWizardIconData}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    <TextBlock Text="{l:Localize TrainingWizard_Title}"
                               FontSize="{DynamicResource TitleFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1"
                          x:Name="BodyScroll"
                          Theme="{StaticResource SidebarScrollViewerTheme}"
                          AllowAutoHide="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0"
                          behaviors:WheelScrollRedirectBehavior.IsEnabled="True">
                <!-- Viewport-capped wrapper Border, per SA_UI_INTERACTION.md section 28
                     ("TrainingWizardWindow Body ScrollViewer Star-Content Width Containment Standard"):
                     on this window's TabControl > StackPanel > body ScrollViewer measure path a
                     star-sized child lays out wider than the viewport with real fonts and slides under
                     the vertical scrollbar. MaxWidth pinned to the viewport keeps content inside it so
                     the 24px Padding here is a real, equal left/right gutter. Background="Transparent"
                     keeps the wrapper hit-testable so a wheel gesture over a blank gap still routes to
                     the body ScrollViewer's WheelScrollRedirectBehavior (section 25). -->
                <Border MaxWidth="{Binding #BodyScroll.Viewport.Width}" Padding="24,16,24,16"
                        Background="Transparent">
                <StackPanel Spacing="20">

                    <!-- Scope and Features are grouped into a window-level TabControl. [Scope] carries the
                         target-population selection plus every training-run setting (Period/Model/
                         Validation/Hyperparameters/Progress); [Features] carries only the channel
                         composer, so the two tabs stay concern-separated (what to train on vs. how). -->
                    <TabControl>

                    <!-- Tab: Scope (population + all run settings) -->
                    <TabItem Header="{l:Localize TrainingWizard_Section_Scope}">
                    <StackPanel Spacing="20" Margin="0,10,0,0">
                        <!-- Row: ticker lists (left) | data period (right) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                            <Border Grid.Column="0" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{l:Localize TrainingWizard_Section_Tickers}" Classes="sectionHeader"/>
                                    <TextBlock Text="{l:Localize TrainingWizard_NoTickerLists}" IsVisible="{Binding !HasSourceTree}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="{DynamicResource HelperFontSize}"/>
                                    <ScrollViewer MaxHeight="{x:Static c:TrainingWizardUiLayout.SourceListMaxHeight}"
                                                  Theme="{StaticResource SidebarScrollViewerTheme}"
                                                  AllowAutoHide="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="{DynamicResource ListScrollGutter}">
                                        <TreeView x:Name="TickerTree" Classes="tickers" ItemsSource="{Binding SourceTree}"
                                                  Background="Transparent" BorderThickness="0"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <TreeView.DataTemplates>
                                                <TreeDataTemplate DataType="dialogs:TrainingSourceTreeItem" ItemsSource="{Binding Children}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <CheckBox IsVisible="{Binding IsSelectable}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Content="{Binding Name}" AutomationProperties.Name="{Binding Name}"/>
                                                        <TextBlock IsVisible="{Binding !IsSelectable}" Text="{Binding Name}" VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource DetailFontSize}"/>
                                                        <PathIcon IsVisible="{Binding HasIcon}" Data="{Binding IconData}" VerticalAlignment="Center"
                                                                  Width="{x:Static c:TrainingWizardUiLayout.TreeIconSize}" Height="{x:Static c:TrainingWizardUiLayout.TreeIconSize}"
                                                                  Foreground="{DynamicResource Brush.Accent.Primary}"/>
                                                    </StackPanel>
                                                </TreeDataTemplate>
                                            </TreeView.DataTemplates>
                                        </TreeView>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Section: Data Period (vertical) -->
                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{l:Localize TrainingWizard_Section_Period}" Classes="sectionHeader"/>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_StartDate}" Classes="fieldLabel"/>
                                        <CalendarDatePicker Classes="isoDate isoDateHint" SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                                             Height="36" HorizontalAlignment="Stretch"
                                                             Background="{DynamicResource Brush.Background.Tertiary}"
                                                             BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_EndDate}" Classes="fieldLabel"/>
                                        <CalendarDatePicker Classes="isoDate isoDateHint" SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                                             Height="36" HorizontalAlignment="Stretch"
                                                             Background="{DynamicResource Brush.Background.Tertiary}"
                                                             BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_Timeframe}" Classes="fieldLabel"/>
                                        <ComboBox ItemsSource="{Binding AvailableTimeframes}"
                                                  SelectedItem="{Binding SelectedTimeframe, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Height="36"
                                                  Background="{DynamicResource Brush.Background.Tertiary}"
                                                  BorderBrush="{DynamicResource Brush.Border.Primary}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="6" IsVisible="{Binding IsManifestRelevant}">
                                        <TextBlock Text="{l:Localize TrainingWizard_SourceManifest}" Classes="fieldLabel"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding SourceManifestPath, Mode=TwoWay}" Height="36"/>
                                            <Button Grid.Column="1" Content="{l:Localize TrainingWizard_BrowseManifest}" Click="OnBrowseManifestClick" Height="36"/>
                                        </Grid>
                                        <TextBlock Text="{l:Localize TrainingWizard_ManifestRequired}" IsVisible="{Binding IsManifestMissing}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   FontSize="{DynamicResource HelperFontSize}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Section: Model & Initialization -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{l:Localize TrainingWizard_Section_Model}" Classes="sectionHeader"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Prediction Type | Framework -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_TargetType}" Classes="fieldLabel"/>
                                        <ComboBox ItemsSource="{Binding AvailableTargetTypes}"
                                                  SelectedItem="{Binding SelectedTargetType, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Height="36"
                                                  Background="{DynamicResource Brush.Background.Tertiary}"
                                                  BorderBrush="{DynamicResource Brush.Border.Primary}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6" IsEnabled="{Binding HasFrameworkChoice}">
                                        <TextBlock Text="{l:Localize TrainingWizard_Framework}" Classes="fieldLabel"/>
                                        <ComboBox ItemsSource="{Binding SelectableFrameworks}"
                                                  SelectedItem="{Binding SelectedFramework, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Height="36"
                                                  Background="{DynamicResource Brush.Background.Tertiary}"
                                                  BorderBrush="{DynamicResource Brush.Border.Primary}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Row 1: Architecture | Training Start Mode -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" IsEnabled="{Binding HasArchitectureChoice}">
                                        <TextBlock Text="{l:Localize TrainingWizard_Architecture}" Classes="fieldLabel"/>
                                        <ComboBox ItemsSource="{Binding AvailableArchitectures}"
                                                  SelectedItem="{Binding SelectedArchitecture, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Height="36"
                                                  Background="{DynamicResource Brush.Background.Tertiary}"
                                                  BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" IsEnabled="{Binding HasInitializationChoice}">
                                        <TextBlock Text="{l:Localize TrainingWizard_InitializationMode}" Classes="fieldLabel"/>
                                        <ComboBox ItemsSource="{Binding AvailableInitializationModes}"
                                                  SelectedItem="{Binding SelectedInitializationMode, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Height="36"
                                                  Background="{DynamicResource Brush.Background.Tertiary}"
                                                  BorderBrush="{DynamicResource Brush.Border.Primary}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Row 2: Checkpoint Path (Resume/FineTune) | Parent Model ID (FineTune) -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6" IsVisible="{Binding IsTransferMode}">
                                        <TextBlock Text="{l:Localize TrainingWizard_CheckpointPath}" Classes="fieldLabel"/>
                                        <TextBox Text="{Binding CheckpointPath, Mode=TwoWay}" Height="36"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6" IsVisible="{Binding IsFineTuneMode}">
                                        <TextBlock Text="{l:Localize TrainingWizard_ParentModelId}" Classes="fieldLabel"/>
                                        <TextBox Text="{Binding ParentModelId, Mode=TwoWay}" Height="36"/>
                                    </StackPanel>

                                    <!-- Row 3: Freeze Paths (FineTune on PyTorch) -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" IsVisible="{Binding CanFreezeModules}">
                                        <TextBlock Text="{l:Localize TrainingWizard_FreezePaths}" Classes="fieldLabel"/>
                                        <TextBox Text="{Binding FreezePathsText, Mode=TwoWay}" Height="36"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Input Shape -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{l:Localize TrainingWizard_Section_Input}" Classes="sectionHeader"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_WindowSize}" Classes="fieldLabel"/>
                                        <NumericUpDown Value="{Binding WindowSize}" Minimum="1" Increment="1" FormatString="F0"
                                                       ClipValueToMinMax="True"
                                                       Height="36" HorizontalContentAlignment="Right"
                                                       Background="{DynamicResource Brush.Background.Tertiary}"
                                                       BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_Horizon}" Classes="fieldLabel"/>
                                        <NumericUpDown Value="{Binding Horizon}" Minimum="0" Increment="1" FormatString="F0"
                                                       ClipValueToMinMax="True"
                                                       Height="36" HorizontalContentAlignment="Right"
                                                       Background="{DynamicResource Brush.Background.Tertiary}"
                                                       BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding WindowUnitNote}"
                                           IsVisible="{Binding WindowUnitNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           TextWrapping="Wrap" FontSize="{DynamicResource HelperFontSize}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Validation -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{l:Localize TrainingWizard_Section_Validation}" Classes="sectionHeader"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Row 0: NSplits | Gap -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_NSplits}" Classes="fieldLabel"/>
                                        <NumericUpDown Value="{Binding NSplits}" Minimum="2" Increment="1" FormatString="F0"
                                                       ClipValueToMinMax="True"
                                                       Height="36" HorizontalContentAlignment="Right"
                                                       Background="{DynamicResource Brush.Background.Tertiary}"
                                                       BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_Gap}" Classes="fieldLabel"/>
                                        <NumericUpDown Value="{Binding Gap}" Minimum="0" Increment="1" FormatString="F0"
                                                       ClipValueToMinMax="True"
                                                       Watermark="{l:Localize TrainingWizard_Optional_Watermark}"
                                                       Height="36" HorizontalContentAlignment="Right"
                                                       Background="{DynamicResource Brush.Background.Tertiary}"
                                                       BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                    <!-- Row 1: OosTailDays -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_OosTailDays}" Classes="fieldLabel"/>
                                        <NumericUpDown Value="{Binding OosTailDays}" Minimum="0" Increment="1" FormatString="F0"
                                                       ClipValueToMinMax="True"
                                                       Watermark="{l:Localize TrainingWizard_Optional_Watermark}"
                                                       Height="36" HorizontalContentAlignment="Right"
                                                       Background="{DynamicResource Brush.Background.Tertiary}"
                                                       BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <CheckBox Content="{l:Localize TrainingWizard_Calibration}"
                                              IsChecked="{Binding UseCalibration, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="TrainingWizard_CalibrationCheck"/>
                                    <TextBlock Text="{Binding CalibrationValidationMessage}"
                                               IsVisible="{Binding CalibrationValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               TextWrapping="Wrap" FontSize="{DynamicResource HelperFontSize}"
                                               Foreground="{DynamicResource Brush.Semantic.Error}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <CheckBox Content="{l:Localize TrainingWizard_Cpcv}"
                                              IsChecked="{Binding UseCpcv, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="TrainingWizard_CpcvCheck"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding UseCpcv}">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="{l:Localize TrainingWizard_CpcvGroups}" Classes="fieldLabel"/>
                                            <NumericUpDown Value="{Binding CpcvGroups}" Minimum="2" Increment="1" FormatString="F0"
                                                           ClipValueToMinMax="True" Height="36" HorizontalContentAlignment="Right"
                                                           AutomationProperties.AutomationId="TrainingWizard_CpcvGroups"
                                                           Background="{DynamicResource Brush.Background.Tertiary}"
                                                           BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{l:Localize TrainingWizard_CpcvTestGroups}" Classes="fieldLabel"/>
                                            <NumericUpDown Value="{Binding CpcvTestGroups}" Minimum="1" Increment="1" FormatString="F0"
                                                           ClipValueToMinMax="True" Height="36" HorizontalContentAlignment="Right"
                                                           AutomationProperties.AutomationId="TrainingWizard_CpcvTestGroups"
                                                           Background="{DynamicResource Brush.Background.Tertiary}"
                                                           BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding CpcvCountText}"
                                               IsVisible="{Binding CpcvCountText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               AutomationProperties.AutomationId="TrainingWizard_CpcvCount"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section: Advanced Settings: Preprocessing -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{l:Localize TrainingWizard_Section_Preprocessing}" Classes="sectionHeader"/>
                                <CheckBox Content="{l:Localize TrainingWizard_FixedZScore}"
                                          IsChecked="{Binding UseFixedZScore, Mode=TwoWay}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <CheckBox Content="{l:Localize TrainingWizard_ClipSigmaEnabled}"
                                                  IsChecked="{Binding UseClipSigma, Mode=TwoWay}"
                                                  IsEnabled="{Binding UseFixedZScore}"/>
                                        <StackPanel Spacing="6" IsVisible="{Binding CanEditClipSigma}">
                                            <TextBlock Text="{l:Localize TrainingWizard_ClipSigmaValue}" Classes="fieldLabel"/>
                                            <TextBox x:Name="ClipSigmaInput"
                                                     Text="{Binding ClipSigmaText, Mode=TwoWay}"
                                                     Width="120" Height="36"
                                                     HorizontalAlignment="Left" HorizontalContentAlignment="Right"
                                                     Classes.clipInvalid="{Binding HasErrors}"
                                                     AutomationProperties.AutomationId="TrainingWizard_ClipSigmaInput"
                                                     Background="{DynamicResource Brush.Background.Tertiary}"
                                                     BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                            <TextBlock Text="{Binding ClipSigmaValidationMessage}" IsVisible="{Binding HasErrors}"
                                                       AutomationProperties.AutomationId="TrainingWizard_ClipSigmaError"
                                                       TextWrapping="Wrap" FontSize="{DynamicResource HelperFontSize}"
                                                       Foreground="{DynamicResource Brush.Semantic.Error}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding UseFixedZScore}">
                                        <TextBlock Text="{l:Localize TrainingWizard_Lags}" Classes="fieldLabel"/>
                                        <TextBox Text="{Binding LagsText, Mode=TwoWay}" Height="36"
                                                 Watermark="{l:Localize TrainingWizard_LagsWatermark}"
                                                 Background="{DynamicResource Brush.Background.Tertiary}"
                                                 BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Advanced Settings: Extended Learning (Ensemble & Pretraining) -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{l:Localize TrainingWizard_Section_Extended}" Classes="sectionHeader"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Row 0: Ensemble Method | Pretraining toggle -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                        <TextBlock Text="{l:Localize TrainingWizard_Ensemble}" Classes="fieldLabel"/>
                                        <ComboBox ItemsSource="{Binding AvailableEnsembleMethods}"
                                                  SelectedItem="{Binding SelectedEnsembleMethod, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Height="36"
                                                  AutomationProperties.AutomationId="TrainingWizard_EnsembleMethodCombo"
                                                  Background="{DynamicResource Brush.Background.Tertiary}"
                                                  BorderBrush="{DynamicResource Brush.Border.Primary}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                        <CheckBox Content="{l:Localize TrainingWizard_Pretraining}"
                                                  IsChecked="{Binding UsePretraining, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="TrainingWizard_PretrainingCheck"/>
                                    </StackPanel>

                                    <!-- Row 1 (Bagging): Ensemble Members -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" IsVisible="{Binding IsBaggingSelected}">
                                        <TextBlock Text="{l:Localize TrainingWizard_EnsembleMembers}" Classes="fieldLabel"/>
                                        <NumericUpDown Value="{Binding EnsembleMembers}" Minimum="2" Increment="1" FormatString="F0"
                                                       ClipValueToMinMax="True" Height="36" HorizontalContentAlignment="Right"
                                                       AutomationProperties.AutomationId="TrainingWizard_EnsembleMembers"
                                                       Background="{DynamicResource Brush.Background.Tertiary}"
                                                       BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>

                                    <!-- Row 1 (Stacking): Stacking Bases | Stacking Weight Source -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" IsVisible="{Binding IsStackingSelected}">
                                        <TextBlock Text="{l:Localize TrainingWizard_StackingBases}" Classes="fieldLabel"/>
                                        <TextBox Text="{Binding StackingBasesText, Mode=TwoWay}" Height="36"
                                                 Watermark="{l:Localize TrainingWizard_StackingBasesWatermark}"
                                                 AutomationProperties.AutomationId="TrainingWizard_StackingBases"
                                                 Background="{DynamicResource Brush.Background.Tertiary}"
                                                 BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" IsVisible="{Binding IsStackingSelected}">
                                        <TextBlock Text="{l:Localize TrainingWizard_StackingWeightSource}" Classes="fieldLabel"/>
                                        <ComboBox ItemsSource="{Binding AvailableStackingWeightSources}"
                                                  SelectedItem="{Binding SelectedStackingWeightSource, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Height="36"
                                                  AutomationProperties.AutomationId="TrainingWizard_StackingWeightSourceCombo"
                                                  Background="{DynamicResource Brush.Background.Tertiary}"
                                                  BorderBrush="{DynamicResource Brush.Border.Primary}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ExtendedLearningValidationMessage}"
                                           IsVisible="{Binding ExtendedLearningValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           TextWrapping="Wrap" FontSize="{DynamicResource HelperFontSize}"
                                           Foreground="{DynamicResource Brush.Semantic.Error}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Advanced Settings: Hyperparameters -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{l:Localize TrainingWizard_Section_Hyperparameters}" Classes="sectionHeader" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{l:Localize TrainingWizard_Hyperparameters_AddButton}"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            Padding="10,4" Height="32"
                                            Command="{Binding AddHyperparameterCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Hyperparameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dialogs:TrainingHyperparameterEntry">
                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                <TextBox Text="{Binding Key}" Watermark="{l:Localize TrainingWizard_Hyperparameters_KeyWatermark}"
                                                         Height="32"
                                                         Background="{DynamicResource Brush.Background.Tertiary}"
                                                         BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="{l:Localize TrainingWizard_Hyperparameters_ValueWatermark}"
                                                         Height="32"
                                                         Background="{DynamicResource Brush.Background.Tertiary}"
                                                         BorderBrush="{DynamicResource Brush.Border.Primary}"/>
                                                <Button Grid.Column="2" Width="32" Height="32" Padding="0"
                                                        Theme="{DynamicResource SecondaryButtonStyle}"
                                                        ToolTip.Tip="{l:Localize TrainingWizard_Hyperparameters_RemoveButton}"
                                                        Command="{Binding $parent[ItemsControl].((dialogs:TrainingWizardViewModel)DataContext).RemoveHyperparameterCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static c:SharedIconGeometries.Delete}" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Section: Registered Features (Pre-execution Review) -->
                        <Border Classes="card" IsVisible="{Binding FeaturePicker.HasChannels}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{l:Localize TrainingWizard_Scope_RegisteredFeatures_Header}" Classes="sectionHeader"/>
                                <ItemsControl ItemsSource="{Binding FeaturePicker.Channels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dialogs:FeatureChannelRowViewModel">
                                            <Border Background="{DynamicResource Brush.Background.Secondary}"
                                                    CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource HelperFontSize}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Section: Progress & Results -->
                        <StackPanel Spacing="8" IsVisible="{Binding HasRunActivity}">
                            <TextBlock Text="{l:Localize TrainingWizard_Section_Results}" Classes="sectionHeader"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" VerticalAlignment="Center"
                                             Foreground="{DynamicResource Brush.Accent.Primary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding CurrentStageDisplay}" FontWeight="SemiBold" IsVisible="{Binding CurrentStageDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <Border Classes="card" Padding="0" HorizontalAlignment="Stretch" IsVisible="{Binding HasLogLines}">
                                <ListBox ItemsSource="{Binding LogLines}" MaxHeight="140"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalAlignment="Stretch"
                                         Padding="{DynamicResource ListScrollGutter}"
                                         ScrollViewer.AllowAutoHide="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </Border>

                            <!-- Per-fold results table (populated from fold-scoped METRIC: lines) -->
                            <StackPanel Spacing="4" IsVisible="{Binding HasCpcvResults}">
                                <TextBlock Text="{l:Localize TrainingWizard_CpcvResults_Header}" Classes="fieldLabel"/>
                                <Border Classes="card" Padding="8" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding CpcvResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="dialogs:CpcvMetricRow">
                                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding HasFoldResults}">
                                <TextBlock Text="{l:Localize TrainingWizard_FoldResults_Header}" Classes="fieldLabel"/>
                                <Border Classes="card" Padding="8" HorizontalAlignment="Stretch">
                                    <!-- Horizontal scroll (permanent, non-overlay) so the metric columns keep a
                                         readable width and pan instead of collapsing when the card is narrow. -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  AllowAutoHide="False">
                                    <StackPanel Spacing="2" MinWidth="{StaticResource TrainingWizardFoldTableMinWidth}">
                                        <Grid ColumnDefinitions="64,64,*,*,*,*" IsVisible="{Binding !FoldResultsAreRegression}">
                                            <TextBlock Grid.Column="0" Text="{l:Localize TrainingWizard_FoldResults_Fold}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="1" Text="{l:Localize TrainingWizard_FoldResults_Samples}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="2" Text="{l:Localize TrainingWizard_FoldResults_Accuracy}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="3" Text="{l:Localize TrainingWizard_FoldResults_Baseline}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="4" Text="{l:Localize TrainingWizard_FoldResults_MacroF1}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="5" Text="{l:Localize TrainingWizard_FoldResults_Logloss}" Classes="fieldLabel"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="64,64,*,*,*,*" IsVisible="{Binding FoldResultsAreRegression}">
                                            <TextBlock Grid.Column="0" Text="{l:Localize TrainingWizard_FoldResults_Fold}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="1" Text="{l:Localize TrainingWizard_FoldResults_Samples}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="2" Text="{l:Localize TrainingWizard_FoldResults_Rmse}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="3" Text="{l:Localize TrainingWizard_FoldResults_Mae}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="4" Text="{l:Localize TrainingWizard_FoldResults_DirectionalAccuracy}" Classes="fieldLabel"/>
                                            <TextBlock Grid.Column="5" Text="{l:Localize TrainingWizard_FoldResults_RmseBaseline}" Classes="fieldLabel"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding FoldResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="dialogs:FoldMetricRow">
                                                    <Grid Classes="foldRow" ColumnDefinitions="64,64,*,*,*,*" Margin="0,1">
                                                        <StackPanel Grid.Column="0" Spacing="0">
                                                            <TextBlock Text="{Binding FoldLabel}"/>
                                                            <!-- FoldMetricRow.IsHoldout records whether this row's scoring
                                                                 data was held out from the model used for that fold. -->
                                                            <TextBlock Text="{l:Localize TrainingWizard_FoldResults_HoldoutTag}"
                                                                       FontSize="{DynamicResource HelperFontSize}" Opacity="0.6"
                                                                       IsVisible="{Binding IsHoldout}">
                                                                <ToolTip.Tip>
                                                                    <TextBlock Text="{l:Localize TrainingWizard_FoldResults_HoldoutTooltip}"
                                                                               TextWrapping="Wrap" MaxWidth="320"/>
                                                                </ToolTip.Tip>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SampleCount}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Accuracy, StringFormat='{}{0:P1}'}" IsVisible="{Binding !IsRegression}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding BaselineAccuracy, StringFormat='{}{0:P1}'}" IsVisible="{Binding !IsRegression}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding MacroF1, StringFormat='{}{0:F3}'}" IsVisible="{Binding !IsRegression}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding MultiLogloss, StringFormat='{}{0:F4}'}" IsVisible="{Binding !IsRegression}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Rmse, StringFormat='{}{0:F4}'}" IsVisible="{Binding IsRegression}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Mae, StringFormat='{}{0:F4}'}" IsVisible="{Binding IsRegression}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding DirectionalAccuracy, StringFormat='{}{0:P1}'}" IsVisible="{Binding IsRegression}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding RmseBaseline, StringFormat='{}{0:F4}'}" IsVisible="{Binding IsRegression}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding CheckpointManifestPath, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{l:Localize TrainingWizard_CheckpointResult}"/>
                                <TextBox Text="{Binding CheckpointManifestPath, Mode=OneWay}" IsReadOnly="True"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </TabItem>

                    <!-- Tab: Features (composed_features channel composer only; always shown, no
                         on/off toggle - selecting zero channels simply falls back to the fixed
                         OHLCV min-max model, see TrainingWizardViewModel.UseComposedFeatures) -->
                    <TabItem Header="{l:Localize TrainingWizard_Section_Features}">
                    <!-- FeatureChannelPickerView already draws its own bordered nav/catalog/detail
                         columns, so wrapping it in the full "card" box (background + border on all
                         sides) doubled the frame at every seam. A top-only rule line separates it from
                         the tab header instead, without enclosing content that already has its own border. -->
                    <Border BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                        <views:FeatureChannelPickerView DataContext="{Binding FeaturePicker}"/>
                    </Border>
                    </TabItem>

                    </TabControl>

                </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Footer (64px) -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="0,1,0,0"
                    Padding="24,0"
                    Background="{DynamicResource Brush.Background.Tertiary}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="{Binding LastResult.RunId}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource HelperFontSize}"
                                   IsVisible="{Binding LastResult, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{l:Localize TrainingWizard_DeployButton}"
                                Theme="{DynamicResource SecondaryButtonStyle}"
                                Padding="16,0" Height="36"
                                IsVisible="{Binding LastResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Command="{Binding DeployToModelsCommand}"/>
                        <Button Content="{l:Localize TrainingWizard_UseAsEnsembleButton}"
                                Theme="{DynamicResource SecondaryButtonStyle}"
                                Padding="16,0" Height="36"
                                IsVisible="{Binding HasRegisteredEnsemble}"
                                Command="{Binding UseAsEnsembleCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                        <Button Content="{l:Localize TrainingWizard_CancelButton}"
                                Theme="{DynamicResource SecondaryButtonStyle}"
                                Padding="16,0" Height="36"
                                IsVisible="{Binding IsTraining}"
                                Command="{Binding CancelTrainingCommand}"/>
                        <Button Content="{l:Localize TrainingWizard_StartButton}"
                                Theme="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,0" Height="36"
                                FontWeight="Bold"
                                IsVisible="{Binding !IsTraining}"
                                Command="{Binding StartTrainingCommand}"/>
                        <Button Content="{l:Localize TrainingWizard_CloseButton}"
                                Theme="{DynamicResource SecondaryButtonStyle}"
                                Padding="16,0" Height="36"
                                Command="{Binding $parent[Window].Close}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
