<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
        xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
        xmlns:c="clr-namespace:StockAnalyzer.Avalonia.Common;assembly=StockAnalyzer.Avalonia"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="260"
        x:Class="StockAnalyzer.Avalonia.Views.Dialogs.BulkTagEditWindow"
        x:DataType="vm:BulkTagEditViewModel"
        x:CompileBindings="True"
        Title="{l:Localize Window_BulkTagEdit_Title}"
        Icon="/Assets/avalonia-logo.ico"
        Width="480" Height="260"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Grid RowDefinitions="56,*,64">
        <!-- Header -->
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource Brush.Border.Primary}" 
                BorderThickness="0,0,0,1" 
                Padding="24,0" 
                Background="{DynamicResource Brush.Background.Tertiary}"
                PointerPressed="OnHeaderPointerPressed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <PathIcon Data="{x:Static c:SharedIconGeometries.Tag}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                <TextBlock Text="{l:Localize Window_BulkTagEdit_Title}" 
                           FontSize="{DynamicResource TitleFontSize}" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Padding="24,16">
            <StackPanel Spacing="16">
                <!-- Tags Input -->
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Text="{l:Localize Label_Tags}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0" 
                               FontWeight="SemiBold" 
                               FontSize="{DynamicResource DetailFontSize}"/>
                    <TextBox Grid.Column="1" 
                             Height="32"
                             Text="{Binding BulkTagInput, Mode=TwoWay}" 
                             Watermark="{l:Localize BulkTagEdit_Watermark}" 
                             FontSize="{DynamicResource DetailFontSize}"/>
                </Grid>

                <!-- Existing Tags list -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{l:Localize Label_ExistingTags}" 
                               VerticalAlignment="Center" 
                               Opacity="0.7" 
                               FontSize="{DynamicResource SmallFontSize}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="320">
                        <ItemsControl ItemsSource="{Binding ExistingTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding $parent[Window].((vm:BulkTagEditViewModel)DataContext).SelectTagCommand}" 
                                            CommandParameter="{Binding}" 
                                            Margin="2" 
                                            Padding="6,2" 
                                            CornerRadius="10" 
                                            FontSize="{DynamicResource SmallFontSize}" 
                                            Background="{DynamicResource Brush.Background.Primary}" 
                                            BorderBrush="{DynamicResource Brush.Border.Primary}" 
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource Brush.Border.Primary}" 
                BorderThickness="0,1,0,0" 
                Padding="24,0" 
                Background="{DynamicResource Brush.Background.Primary}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                <Button Content="{l:Localize Btn_Add}" 
                        Click="OnOkClick"
                        Theme="{DynamicResource PrimaryButtonStyle}" 
                        Foreground="{DynamicResource Brush.Text.Inverse}"
                        Width="80" 
                        HorizontalContentAlignment="Center"/>
                <Button Content="{l:Localize Btn_Cancel}" 
                        Click="OnCancelClick"
                        Theme="{DynamicResource SecondaryButtonStyle}"
                        Foreground="{DynamicResource Brush.Text.Inverse}" 
                        Width="80" 
                        HorizontalContentAlignment="Center"/>
                <Button Content="{l:Localize Btn_Delete}" 
                        Click="OnDeleteClick"
                        Theme="{DynamicResource SecondaryButtonStyle}"
                        Foreground="{DynamicResource Brush.Text.Inverse}"
                        Width="80" 
                        HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
