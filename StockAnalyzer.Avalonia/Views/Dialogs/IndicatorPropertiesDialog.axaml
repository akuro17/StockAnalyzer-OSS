<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StockAnalyzer.Avalonia.ViewModels.Dialogs;assembly=StockAnalyzer.Avalonia"
        xmlns:controls="clr-namespace:StockAnalyzer.Avalonia.Views.Controls;assembly=StockAnalyzer.Avalonia"
        xmlns:converters="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
        xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
        x:Class="StockAnalyzer.Avalonia.Views.Dialogs.IndicatorPropertiesDialog"
        x:DataType="vm:IndicatorPropertiesViewModel"
        Title="{l:Localize Window_IndicatorProperties_Title}"
        Width="450" Height="600"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Primary}">

    <Window.Resources>
        <converters:IndicatorColorToAvaloniaColorConverter x:Key="ColorConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding EditingSettings.DisplayName}" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   Margin="0,0,0,15"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Margin="0,0,10,0">
                
                <!-- Basic Settings -->
                <StackPanel Spacing="10">
                    <CheckBox Content="{l:Localize Check_EnableIndicator}" 
                              IsChecked="{Binding EditingSettings.IsEnabled, Mode=TwoWay}"/>
                    
                    <DockPanel>
                        <TextBlock Text="{l:Localize Label_DisplayName}" 
                                   Width="120" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBox Text="{Binding EditingSettings.DisplayName, Mode=TwoWay}"
                                 HorizontalAlignment="Stretch"/>
                    </DockPanel>
                </StackPanel>

                <!-- Dynamic Parameters -->
                <Border BorderBrush="{DynamicResource Brush.Border.Primary}" 
                        BorderThickness="0,1,0,0" 
                        Padding="0,15,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Localize Label_Parameters}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <controls:DynamicIndicatorSettingsView ParameterObject="{Binding EditingSettings.ParameterObject}" />
                    </StackPanel>
                </Border>

                <!-- Appearance Settings -->
                <Border BorderBrush="{DynamicResource Brush.Border.Primary}" 
                        BorderThickness="0,1,0,0" 
                        Padding="0,15,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Localize Label_ColorSettings}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <!-- Simple Color Settings -->
                        <StackPanel Spacing="10" 
                                    IsVisible="{Binding EditingSettings.SeriesColors.Count, Converter={x:Static converters:NumericalConverters.IsEqualToZero}}">
                            
                            <DockPanel>
                                <TextBlock Text="{l:Localize Label_MainColor}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <ColorPicker Color="{Binding EditingSettings.Color, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                             ColorSpectrumShape="Box" Height="30" Width="200"
                                             HorizontalAlignment="Right"/>
                            </DockPanel>
                            
                            <CheckBox Content="{l:Localize Check_UseUpDownColors}" 
                                      IsChecked="{Binding EditingSettings.UseUpDownColors, Mode=TwoWay}"
                                      IsVisible="{Binding ShowUpDownColors}"/>
                            
                            <DockPanel IsVisible="{Binding EditingSettings.UseUpDownColors}">
                                <TextBlock Text="{l:Localize Label_UpColor}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="20,0,0,0"/>
                                <ColorPicker Color="{Binding EditingSettings.UpColor, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                             ColorSpectrumShape="Box" Height="30" Width="200"
                                             HorizontalAlignment="Right"/>
                            </DockPanel>
                            
                            <DockPanel IsVisible="{Binding EditingSettings.UseUpDownColors}">
                                <TextBlock Text="{l:Localize Label_DownColor}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="20,0,0,0"/>
                                <ColorPicker Color="{Binding EditingSettings.DownColor, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                             ColorSpectrumShape="Box" Height="30" Width="200"
                                             HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel IsVisible="{Binding ShowThicknessAndOffset}">
                                <TextBlock Text="{l:Localize Label_Thickness}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider Name="ThicknessSlider"
                                            Value="{Binding EditingSettings.Thickness, Mode=TwoWay}" 
                                            Minimum="0.5" Maximum="5" TickFrequency="0.5" Width="150"
                                            IsSnapToTickEnabled="True" 
                                            VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding #ThicknessSlider.Value, Mode=TwoWay, StringFormat={}{0:F1}}" 
                                             Width="40" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel IsVisible="{Binding ShowThicknessAndOffset}">
                                <TextBlock Text="{l:Localize Label_Offset}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider Name="OffsetSlider"
                                            Value="{Binding EditingSettings.Offset, Mode=TwoWay}" 
                                            Minimum="-50" Maximum="50" TickFrequency="1" Width="150"
                                            IsSnapToTickEnabled="True" 
                                            VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding #OffsetSlider.Value, Mode=TwoWay}" 
                                             Width="40" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <!-- Multi-Series Color Settings -->
                        <ItemsControl ItemsSource="{Binding EditingSettings.SeriesColors}"
                                      IsVisible="{Binding EditingSettings.SeriesColors.Count, Converter={x:Static converters:NumericalConverters.IsGreaterThanZero}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <TextBlock Text="{Binding DisplayName}" 
                                                   Width="150" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <!-- Note: SeriesColorConfig doesn't have Thickness yet -->
                                        <ColorPicker Color="{Binding Color, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                                     ColorSpectrumShape="Box" Height="30" Width="200"
                                                     HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Layout / Misc Settings -->
                <Border BorderBrush="{DynamicResource Brush.Border.Primary}" 
                        BorderThickness="0,1,0,0" 
                        Padding="0,15,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Localize Label_OverlayPanel}" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" 
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding ShowPanelSelector}"/>
                        <ComboBox ItemsSource="{Binding PanelOptions}" 
                                  SelectedItem="{Binding SelectedOverlayPanelOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding ShowPanelSelector}"/>

                        <!-- Show Cross Markers (GC/DC) -->
                        <CheckBox IsChecked="{Binding EditingSettings.ShowCrossMarkers, Mode=TwoWay}"
                                  Content="{l:Localize Check_ShowCrossMarkers}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <!-- Show Value on Y-Axis -->
                        <CheckBox IsChecked="{Binding EditingSettings.ShowAxisLabel, Mode=TwoWay}"
                                  Content="{l:Localize Check_ShowAxisLabel}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <!-- Show Signals (Bullish/Bearish Markers) -->
                        <CheckBox IsChecked="{Binding EditingSettings.ShowSignals, Mode=TwoWay}"
                                  Content="{l:Localize Check_ShowSignals}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                  IsVisible="{Binding ShowSignals}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource Brush.Border.Primary}" 
                BorderThickness="0,1,0,0" 
                Padding="0,15,0,0"
                Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Content="{l:Localize Btn_Reset}" 
                        Command="{Binding ResetCommand}"
                        Theme="{StaticResource SecondaryButtonStyle}"/>
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Spacing="10">
                    <Button Content="{l:Localize Btn_Apply}" 
                            Command="{Binding ApplyCommand}"
                            Theme="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="{l:Localize Btn_OK}" 
                            Command="{Binding OkCommand}"
                            Theme="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="{l:Localize Btn_Cancel}" 
                            Command="{Binding CancelCommand}"
                            Theme="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
