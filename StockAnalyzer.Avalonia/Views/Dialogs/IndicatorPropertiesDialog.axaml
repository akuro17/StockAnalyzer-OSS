<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StockAnalyzer.Avalonia.ViewModels.Dialogs;assembly=StockAnalyzer.Avalonia"
        xmlns:controls="clr-namespace:StockAnalyzer.Avalonia.Views.Controls;assembly=StockAnalyzer.Avalonia"
        xmlns:converters="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
        xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:behaviors="using:StockAnalyzer.Avalonia.Behaviors"
        xmlns:c="using:StockAnalyzer.Avalonia.Common"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
        x:Class="StockAnalyzer.Avalonia.Views.Dialogs.IndicatorPropertiesDialog"
        x:DataType="vm:IndicatorPropertiesViewModel"
        Title="{l:Localize Window_IndicatorProperties_Title}"
        Width="520" Height="650"
        MinHeight="450" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Primary}">

    <Window.Resources>
        <converters:IndicatorColorToAvaloniaColorConverter x:Key="ColorConverter"/>
        <StreamGeometry x:Key="SettingsSvgIconData">m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm112-260q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Z</StreamGeometry>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding EditingSettings.DisplayName}" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   Margin="0,0,0,15"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="False"
                      Padding="0,0,12,0"
                      behaviors:WheelScrollRedirectBehavior.IsEnabled="True">
            <StackPanel Spacing="20" Margin="0,0,4,0">

                
                <!-- Basic Settings -->
                <StackPanel Spacing="10">
                    <CheckBox Content="{l:Localize Check_EnableIndicator}" 
                              IsChecked="{Binding EditingSettings.IsEnabled, Mode=TwoWay}"/>
                    
                    <DockPanel>
                        <TextBlock Text="{l:Localize Label_DisplayName}" 
                                   Width="120" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBox Text="{Binding EditingSettings.DisplayName, Mode=TwoWay}"
                                 HorizontalAlignment="Stretch"/>
                    </DockPanel>
                </StackPanel>

                <!-- Input Series (Price Type & Chained Indicators) -->
                <Border BorderBrush="{DynamicResource Brush.Border.Primary}" 
                        BorderThickness="0,1,0,0" 
                        Padding="0,15,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Localize Label_InputSeries}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <DockPanel>
                            <TextBlock Text="{l:Localize Label_PriceTypeColon}" 
                                       Width="150" 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <ComboBox ItemsSource="{Binding PriceTypeOptions}" 
                                      SelectedItem="{Binding EditingSettings.PriceSource, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Width="200"/>
                        </DockPanel>

                        <!-- Input Source (Indicator on Indicator) -->
                        <DockPanel>
                            <TextBlock Text="{l:Localize Label_SourceIndicator}" 
                                       Width="150" 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding OpenSourceIndicatorSettingsCommand}"
                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                    Width="30" Height="30" Padding="0"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="{l:Localize Label_SourceIndicatorRegistration}"
                                    VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource SettingsSvgIconData}" Width="14" Height="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            </Button>
                            <ComboBox ItemsSource="{Binding AvailableSourceIndicators}"
                                      SelectedItem="{Binding SelectedSourceIndicatorOption, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      HorizontalAlignment="Right"
                                      Width="164"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Dynamic Parameters -->
                <Border BorderBrush="{DynamicResource Brush.Border.Primary}"
                        BorderThickness="0,1,0,0"
                        Padding="0,15,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Localize Label_Parameters}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <!-- Dynamic Period Driver: shown here (in place of the Period row) only while HasDynamicPeriodDriver is ON -->
                        <DockPanel IsVisible="{Binding HasDynamicPeriodDriver}">
                            <TextBlock Text="{l:Localize Label_DynamicPeriodDriver}"
                                       Width="150"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding OpenDynamicPeriodDriverSettingsCommand}"
                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                    Width="30" Height="30" Padding="0"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="{l:Localize Label_DynamicPeriodDriverRegistration}"
                                    VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource SettingsSvgIconData}" Width="14" Height="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            </Button>
                            <ComboBox ItemsSource="{Binding AvailableDynamicPeriodDrivers}"
                                      SelectedItem="{Binding SelectedDynamicPeriodDriverOption, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      HorizontalAlignment="Right"
                                      Width="164"/>
                        </DockPanel>

                        <controls:DynamicIndicatorSettingsView ParameterObject="{Binding EditingSettings.ParameterObject}"
                                                                HiddenParameterTags="{Binding HiddenParameterTags}" />

                        <!-- Positioned below Period / Dynamic Period Driver (whichever is currently shown) -->
                        <CheckBox Content="{l:Localize Check_UseDynamicPeriodDriver}"
                                  IsChecked="{Binding HasDynamicPeriodDriver, Mode=TwoWay}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Appearance Settings -->
                <Border BorderBrush="{DynamicResource Brush.Border.Primary}" 
                        BorderThickness="0,1,0,0" 
                        Padding="0,15,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Localize Label_ColorSettings}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <!-- Simple Color Settings -->
                        <StackPanel Spacing="10" 
                                    IsVisible="{Binding EditingSettings.SeriesColors.Count, Converter={x:Static converters:NumericalConverters.IsEqualToZero}}">
                            
                            <DockPanel>
                                <TextBlock Text="{l:Localize Label_MainColor}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <ColorPicker Color="{Binding EditingSettings.Color, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                             ColorSpectrumShape="Box" Height="30" Width="200"
                                             HorizontalAlignment="Right"/>
                            </DockPanel>
                            
                            <CheckBox Content="{l:Localize Check_UseUpDownColors}" 
                                      IsChecked="{Binding EditingSettings.UseUpDownColors, Mode=TwoWay}"
                                      IsVisible="{Binding ShowUpDownColors}"/>
                            
                            <DockPanel IsVisible="{Binding EditingSettings.UseUpDownColors}">
                                <TextBlock Text="{l:Localize Label_UpColor}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="20,0,0,0"/>
                                <ColorPicker Color="{Binding EditingSettings.UpColor, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                             ColorSpectrumShape="Box" Height="30" Width="200"
                                             HorizontalAlignment="Right"/>
                            </DockPanel>
                            
                            <DockPanel IsVisible="{Binding EditingSettings.UseUpDownColors}">
                                <TextBlock Text="{l:Localize Label_DownColor}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="20,0,0,0"/>
                                <ColorPicker Color="{Binding EditingSettings.DownColor, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                             ColorSpectrumShape="Box" Height="30" Width="200"
                                             HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel IsVisible="{Binding ShowThicknessAndOffset}">
                                <TextBlock Text="{l:Localize Label_Thickness}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider Name="ThicknessSlider"
                                            Value="{Binding EditingSettings.Thickness, Mode=TwoWay}" 
                                            Minimum="0.5" Maximum="5" TickFrequency="0.5" Width="150"
                                            IsSnapToTickEnabled="True" 
                                            VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding #ThicknessSlider.Value, Mode=TwoWay, StringFormat={}{0:F1}}" 
                                             Width="40" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel IsVisible="{Binding ShowThicknessAndOffset}">
                                <TextBlock Text="{l:Localize Label_Offset}" 
                                           Width="150" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider Name="OffsetSlider"
                                            Value="{Binding EditingSettings.Offset, Mode=TwoWay}" 
                                            Minimum="-50" Maximum="50" TickFrequency="1" Width="150"
                                            IsSnapToTickEnabled="True" 
                                            VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding #OffsetSlider.Value, Mode=TwoWay}" 
                                             Width="40" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <!-- Multi-Series Color Settings -->
                        <ItemsControl ItemsSource="{Binding EditingSettings.SeriesColors}"
                                      IsVisible="{Binding EditingSettings.SeriesColors.Count, Converter={x:Static converters:NumericalConverters.IsGreaterThanZero}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <TextBlock Text="{Binding DisplayName}" 
                                                   Width="150" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <!-- Note: SeriesColorConfig doesn't have Thickness yet -->
                                        <ColorPicker Color="{Binding Color, Converter={StaticResource ColorConverter}, Mode=TwoWay}" 
                                                     ColorSpectrumShape="Box" Height="30" Width="200"
                                                     HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Layout / Misc Settings -->
                <Border BorderBrush="{DynamicResource Brush.Border.Primary}" 
                        BorderThickness="0,1,0,0" 
                        Padding="0,15,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Localize Label_OverlayPanel}" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" 
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding ShowPanelSelector}"/>
                        <ComboBox ItemsSource="{Binding PanelOptions}" 
                                  SelectedItem="{Binding SelectedOverlayPanelOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding ShowPanelSelector}"/>

                        <!-- Show Cross Markers (GC/DC) -->
                        <CheckBox IsChecked="{Binding EditingSettings.ShowCrossMarkers, Mode=TwoWay}"
                                  Content="{l:Localize Check_ShowCrossMarkers}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <!-- Show Value on Y-Axis -->
                        <CheckBox IsChecked="{Binding EditingSettings.ShowAxisLabel, Mode=TwoWay}"
                                  Content="{l:Localize Check_ShowAxisLabel}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"/>

                        <!-- Show Signals (Bullish/Bearish Markers) -->
                        <CheckBox IsChecked="{Binding EditingSettings.ShowSignals, Mode=TwoWay}"
                                  Content="{l:Localize Check_ShowSignals}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                  IsVisible="{Binding ShowSignals}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource Brush.Border.Primary}" 
                BorderThickness="0,1,0,0" 
                Padding="0,15,0,0"
                Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Content="{l:Localize Btn_Reset}" 
                        Command="{Binding ResetCommand}"
                        Theme="{StaticResource SecondaryButtonStyle}"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10">
                    <Button Content="{l:Localize Btn_OK}"
                            Command="{Binding OkCommand}"
                            Theme="{StaticResource PrimaryButtonStyle}"
                            MinWidth="80"/>
                    <Button Content="{l:Localize Btn_Cancel}"
                            Command="{Binding CancelCommand}"
                            Theme="{StaticResource SecondaryButtonStyle}"
                            MinWidth="80"/>
                    <Button Content="{l:Localize Btn_Apply}"
                            Command="{Binding ApplyCommand}"
                            Theme="{StaticResource SecondaryButtonStyle}"
                            MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
