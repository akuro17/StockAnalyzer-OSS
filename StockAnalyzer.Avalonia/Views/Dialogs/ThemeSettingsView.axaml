<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
             xmlns:conv="using:StockAnalyzer.Avalonia.Converters"
             xmlns:l="using:StockAnalyzer.Avalonia.Markup"
             xmlns:c="using:StockAnalyzer.Avalonia.Common"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1000"
             x:Class="StockAnalyzer.Avalonia.Views.Dialogs.ThemeSettingsView"
             x:DataType="vm:ThemeSettingsViewModel">

    <UserControl.Resources>
        <conv:IndicatorColorToAvaloniaColorConverter x:Key="ColorConverter"/>
        <conv:EnumToLocalizedNameConverter x:Key="EnumConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:ThemeSettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="16">
            
            <!-- Section: Preset Selection & Custom Themes (2-Column Layout) -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{l:Localize Settings_Theme_PresetSelection}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    
                    <Grid ColumnDefinitions="*, 1, *" Margin="0,4,0,0">
                        <!-- Left Column: Standard Theme Mode -->
                        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,16,0">
                            <TextBlock Text="{l:Localize Settings_Theme_StandardMode}" FontWeight="SemiBold" FontSize="{DynamicResource DetailFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Text="{l:Localize Settings_Theme_Mode}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource DetailFontSize}"/>
                                <ComboBox Grid.Column="1" 
                                          ItemsSource="{Binding AvailablePresets}" 
                                          SelectedItem="{Binding SelectedPreset}" 
                                          HorizontalAlignment="Stretch"
                                          Height="36">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" FontSize="{DynamicResource DetailFontSize}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            
                            <TextBlock Text="{l:Localize Settings_Theme_PresetWarning}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Vertical Divider -->
                        <Separator Grid.Column="1" Background="{DynamicResource Brush.Border.Primary}" Width="1" VerticalAlignment="Stretch" Margin="0,2"/>

                        <!-- Right Column: Custom Themes -->
                        <StackPanel Grid.Column="2" Spacing="12" Margin="16,0,0,0">
                            <TextBlock Text="{l:Localize Settings_Theme_CustomThemesHeader}" FontWeight="SemiBold" FontSize="{DynamicResource DetailFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            
                            <!-- Save Custom Theme Input -->
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Text="{Binding NewThemeName, Mode=TwoWay}"
                                         Watermark="{l:Localize Settings_Theme_ThemeNamePlaceholder}"
                                         Height="36"
                                         FontSize="{DynamicResource DetailFontSize}"
                                         Margin="0,0,8,0">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SaveCustomThemeCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding SaveCustomThemeCommand}"
                                        Height="36" Width="36"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="{DynamicResource Brush.Button.Background}"
                                        Foreground="{DynamicResource Brush.Button.Text}"
                                        ToolTip.Tip="{l:Localize Settings_Theme_SaveThemeTooltip}">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Button.Hover}"/>
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Button.Pressed}"/>
                                        </Style>
                                    </Button.Styles>
                                    <PathIcon Data="{x:Static c:SharedIconGeometries.Save}" Width="16" Height="16" Foreground="{DynamicResource Brush.Button.Text}"/>
                                </Button>
                            </Grid>

                            <!-- Saved Custom Themes List -->
                            <ListBox ItemsSource="{Binding SavedThemes}"
                                     SelectedItem="{Binding SelectedThemeTemplate}"
                                     Height="110"
                                     Background="{DynamicResource Brush.Background.Primary}"
                                     BorderBrush="{DynamicResource Brush.Border.Primary}"
                                     BorderThickness="1"
                                     CornerRadius="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,2">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}" FontWeight="Medium"/>
                                            
                                            <!-- Apply Button -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding $parent[ListBox].((vm:ThemeSettingsViewModel)DataContext).ApplyCustomThemeCommand}"
                                                    CommandParameter="{Binding}"
                                                    Height="28" Width="28"
                                                    Padding="0"
                                                    Margin="0,0,4,0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="{DynamicResource Brush.Button.Background}"
                                                    Foreground="{DynamicResource Brush.Button.Text}"
                                                    ToolTip.Tip="{l:Localize Settings_Theme_ApplyThemeTooltip}">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Button.Hover}"/>
                                                    </Style>
                                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Button.Pressed}"/>
                                                    </Style>
                                                </Button.Styles>
                                                <PathIcon Data="{x:Static c:SharedIconGeometries.Load}" Width="13" Height="13" Foreground="{DynamicResource Brush.Button.Text}"/>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding $parent[ListBox].((vm:ThemeSettingsViewModel)DataContext).DeleteCustomThemeCommand}"
                                                    CommandParameter="{Binding}"
                                                    Height="28" Width="28"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="{DynamicResource Brush.Button.Background}"
                                                    Foreground="{DynamicResource Brush.Button.Text}"
                                                    ToolTip.Tip="{l:Localize Settings_Theme_DeleteThemeTooltip}">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Button.Hover}"/>
                                                    </Style>
                                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Button.Pressed}"/>
                                                    </Style>
                                                </Button.Styles>
                                                <PathIcon Data="{x:Static c:SharedIconGeometries.Delete}" Width="13" Height="13" Foreground="{DynamicResource Brush.Button.Text}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Interface Colors (Shell) -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Theme_InterfaceColors}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ShellBackground}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ShellBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ShellBackground}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ShellText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ShellTextColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ShellText}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ShellSecondaryText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ShellSecondaryTextColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ShellSecondaryText}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ShellAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ShellAccentColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ShellAccent}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ShellBorder}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ShellBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ShellBorder}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Section: Button Colors -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Theme_ButtonColors}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ButtonBackground}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ButtonBackground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ButtonBackground}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ButtonText, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ButtonText}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ButtonHover}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ButtonHover, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ButtonHover}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_ButtonPressed}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ButtonPressed, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_ButtonPressed}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Section: Chart Colors (Workspace) -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Theme_ChartColors}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_Background}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding BackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_Background}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_Grid}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding GridColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_Grid}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_Axis}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding AxisColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_Axis}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_Crosshair}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding CrosshairColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_Crosshair}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Section: Chart Elements -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Theme_ChartElements}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_VolumeUp}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding VolumeUpColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_VolumeUp}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_VolumeDown}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding VolumeDownColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_VolumeDown}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_RulerFill}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding RulerFillColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_RulerFill}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_RulerStroke}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding RulerStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_RulerStroke}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Section: Semantic Colors -->
            <Border Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings_Theme_SemanticColors}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_SemanticPlus}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding SemanticPlusColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_SemanticPlus}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_SemanticMinus}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding SemanticMinusColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_SemanticMinus}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{l:Localize Settings_Theme_Item_SemanticNeutral}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding SemanticNeutralColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" Width="50" Height="28"/>
                            </Grid>
                            <Separator Background="{DynamicResource Brush.Border.Primary}" Margin="0,4"/>
                            <TextBlock Text="{l:Localize Settings_Theme_Desc_SemanticNeutral}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
