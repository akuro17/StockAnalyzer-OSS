<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
             xmlns:l="using:StockAnalyzer.Avalonia.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StockAnalyzer.Avalonia.Views.Dialogs.PlaceholderSettingsView"
             x:DataType="vm:PlaceholderSettingsViewModel">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Grid.Row="0" Spacing="20" Margin="0,0,0,40">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <PathIcon Data="{DynamicResource SettingsAdvIcon}" Width="32" Height="32" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                <TextBlock Text="{Binding TitleKey, Converter={StaticResource LocalizeConverter}}" 
                           FontSize="24" FontWeight="SemiBold"/>
            </StackPanel>
            <Separator Background="{DynamicResource Brush.Border.Primary}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <PathIcon Data="{DynamicResource SettingsChartIcon}" Width="64" Height="64" Opacity="0.2"/>
            <StackPanel Spacing="8">
                <TextBlock Text="Feature Coming Soon" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock Text="This settings page is currently under migration." HorizontalAlignment="Center" Opacity="0.4"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
