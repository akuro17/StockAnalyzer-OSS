<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="using:StockAnalyzer.Avalonia.ViewModels.Dialogs"
        xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="540"
        x:Class="StockAnalyzer.Avalonia.Views.Dialogs.AddTickerWindow"
        x:DataType="dialogs:AddTickerViewModel"
        Title="{l:Localize TickerList_AddTicker_Title}"
        Width="480" Height="540"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <StreamGeometry x:Key="PlusIconData">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    </Window.Resources>

    <Design.DataContext>
        <dialogs:AddTickerViewModel/>
    </Design.DataContext>

    <Border BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="1">
        <Grid RowDefinitions="56,*,64" Margin="0">
            <!-- Header (56px) -->
            <Border Grid.Row="0" 
                    BorderBrush="{DynamicResource Brush.Border.Primary}" 
                    BorderThickness="0,0,0,1" 
                    Padding="24,0" 
                    Background="{DynamicResource Brush.Background.Tertiary}"
                    PointerPressed="OnHeaderPointerPressed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <PathIcon Data="{StaticResource PlusIconData}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    <TextBlock Text="{l:Localize TickerList_AddTicker_Title}" 
                               FontSize="{DynamicResource TitleFontSize}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main Workspace / Body -->
            <Border Grid.Row="1" Padding="24,16">
                <StackPanel Spacing="16">
                    
                    <!-- Section 1: Search -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Localize AddTicker_SearchHeader}" 
                                   FontSize="{DynamicResource HelperFontSize}" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Text="{Binding SearchText}"
                                     Watermark="{l:Localize AddTicker_Placeholder}"
                                     FontSize="{DynamicResource BaseFontSize}"
                                     Height="36"
                                     Background="{DynamicResource Brush.Background.Tertiary}"
                                     BorderBrush="{DynamicResource Brush.Border.Primary}"
                                     Padding="12,0,40,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchTextBox_KeyDown"/>
                            
                            <Path HorizontalAlignment="Right"
                                  Margin="0,0,12,0"
                                  Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="{DynamicResource Brush.Text.Tertiary}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Suggestions / Results -->
                        <ListBox x:Name="SuggestionsListBox"
                                 ItemsSource="{Binding Suggestions}"
                                 SelectedItem="{Binding SelectedSuggestion}"
                                 MaxHeight="110"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 IsVisible="{Binding Suggestions.Count}"
                                 KeyDown="SuggestionsListBox_KeyDown"
                                 Tapped="SuggestionsListBox_Tapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="SuggestionItemBorder" BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="1" Padding="12,8" Background="{DynamicResource Brush.Background.Tertiary}" Margin="0,0,0,4" CornerRadius="4">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                            <TextBlock Text="{Binding}" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource Brush.Semantic.Success}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource BaseFontSize}"/>
                                            <TextBlock Grid.Column="1" Text="{l:Localize AddTicker_SymbolSeparator}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{l:Localize AddTicker_SymbolDescription}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}"/>
                                            
                                            <Border Grid.Column="3" Background="{DynamicResource Brush.Background.Primary}" Padding="6,2" CornerRadius="2" Margin="10,0">
                                                <TextBlock Text="{l:Localize AddTicker_MarketLabel}" FontSize="{DynamicResource HelperFontSize}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontWeight="Bold"/>
                                            </Border>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" 
                                                      Fill="{DynamicResource Brush.Semantic.Success}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{l:Localize AddTicker_ValidLabel}" Foreground="{DynamicResource Brush.Semantic.Success}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.SuggestionItemBorder">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Semantic.Success}"/>
                                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Border.SuggestionItemBorder">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Semantic.Success}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>

                        <!-- New Ticker Status (when no suggestions but valid format) -->
                        <Border BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="1" Padding="12,8" Background="{DynamicResource Brush.Background.Tertiary}" CornerRadius="4" 
                                IsVisible="{Binding IsNew}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="{Binding SearchText, StringFormat=' — {0}'}" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource Brush.Semantic.Info}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource BaseFontSize}"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize AddTicker_NewTicker}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="{DynamicResource DetailFontSize}" Margin="12,0,8,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                                          Fill="{DynamicResource Brush.Semantic.Info}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="{l:Localize AddTicker_AddNew}" Foreground="{DynamicResource Brush.Semantic.Info}" FontSize="{DynamicResource HelperFontSize}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Section 2: Batch -->
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <Button Height="36" 
                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                    Padding="14,0"
                                    Command="{Binding ImportBulkCommand}"
                                    Click="OnBulkImportClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="M14,2H6C4.89,2 4,2.9 4,4V20C4,21.1 4.89,22 6,22H18C19.11,22 20,21.1 20,20V8L14,2M13,9V3.5L18.5,9H13Z" 
                                          Fill="{DynamicResource Brush.Button.Text}" Width="14" Height="14" Stretch="Uniform"/>
                                    <TextBlock Text="{l:Localize AddTicker_ImportButton}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource DetailFontSize}"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:Localize AddTicker_FormatHelp}" 
                                           FontSize="{DynamicResource HelperFontSize}" 
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Divider Line under Import From File -->
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Border.Primary}" Margin="-24,4" HorizontalAlignment="Stretch"/>

                    <!-- Section 3: Bulk Attribute Assignment (List & Tags) -->
                    <StackPanel Spacing="10">
                        <!-- List UI: Multi-selection dropdown with checkboxes grouped by category -->
                        <Grid ColumnDefinitions="60,*">
                            <TextBlock Text="{l:Localize AddTicker_ListLabel}" 
                                       VerticalAlignment="Center" 
                                       FontWeight="SemiBold" 
                                       FontSize="{DynamicResource DetailFontSize}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            
                            <DropDownButton Grid.Column="1" 
                                            HorizontalAlignment="Stretch"
                                            Height="34"
                                            Background="{DynamicResource Brush.Background.Tertiary}"
                                            BorderBrush="{DynamicResource Brush.Border.Primary}">
                                <DropDownButton.Content>
                                    <TextBlock Text="{Binding SelectedListsSummary}" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center" 
                                               FontSize="{DynamicResource DetailFontSize}"/>
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <Border Width="260" MaxHeight="240">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="8" Margin="4">
                                                    <!-- Watchlists Category -->
                                                    <StackPanel IsVisible="{Binding WatchlistProfiles.Count}" Spacing="4">
                                                        <TextBlock Text="{l:Localize TickerList_TypeName_Watchlist}" 
                                                                   FontSize="{DynamicResource HelperFontSize}" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                                   Margin="4,2,4,2"/>
                                                        <ItemsControl ItemsSource="{Binding WatchlistProfiles}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,2">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource DetailFontSize}"/>
                                                                    </CheckBox>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- Portfolios Category -->
                                                    <StackPanel IsVisible="{Binding PortfolioProfiles.Count}" Spacing="4">
                                                        <TextBlock Text="{l:Localize TickerList_TypeName_Portfolio}" 
                                                                   FontSize="{DynamicResource HelperFontSize}" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                                   Margin="4,4,4,2"/>
                                                        <ItemsControl ItemsSource="{Binding PortfolioProfiles}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,2">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource DetailFontSize}"/>
                                                                            <Border Background="{DynamicResource Brush.Accent.Primary}" Padding="4,1" CornerRadius="2">
                                                                                <TextBlock Text="{l:Localize AddTicker_PortfolioBadge}" FontSize="10" Foreground="{DynamicResource Brush.Text.Inverse}"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </CheckBox>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <!-- Tags UI: Spec matches existing Add/Delete Tags component -->
                        <Grid ColumnDefinitions="60,*">
                            <TextBlock Text="{l:Localize Label_Tags}" 
                                       VerticalAlignment="Center" 
                                       FontWeight="SemiBold" 
                                       FontSize="{DynamicResource DetailFontSize}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            
                            <TextBox Grid.Column="1" 
                                     Height="34"
                                     Text="{Binding ImportTags, Mode=TwoWay}"
                                     Watermark="{l:Localize AddTicker_TagsPlaceholder}"
                                     FontSize="{DynamicResource DetailFontSize}"
                                     Background="{DynamicResource Brush.Background.Tertiary}"
                                     BorderBrush="{DynamicResource Brush.Border.Primary}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer (64px) -->
            <Border Grid.Row="2" 
                    BorderBrush="{DynamicResource Brush.Border.Primary}" 
                    BorderThickness="0,1,0,0" 
                    Padding="24,0" 
                    Background="{DynamicResource Brush.Background.Tertiary}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <Button Content="{l:Localize Btn_Add}" 
                            Theme="{DynamicResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Padding="24,0"
                            Height="36"
                            FontWeight="Bold"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding AddCommand}"
                            Click="OnAddClick"/>
                    <Button Content="{l:Localize Btn_Cancel}" 
                            Theme="{DynamicResource SecondaryButtonStyle}"
                            Padding="24,0"
                            Height="36"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnCancelClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
