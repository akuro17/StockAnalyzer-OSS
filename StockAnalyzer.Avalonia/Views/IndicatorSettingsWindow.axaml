<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:StockAnalyzer.Core.Models;assembly=StockAnalyzer.Core"
        xmlns:params="clr-namespace:StockAnalyzer.Core.Models.Parameters;assembly=StockAnalyzer.Core"
        xmlns:converters="clr-namespace:StockAnalyzer.Avalonia.Converters;assembly=StockAnalyzer.Avalonia"
        xmlns:vm="clr-namespace:StockAnalyzer.Avalonia.ViewModels.Dialogs;assembly=StockAnalyzer.Avalonia"
        xmlns:l="clr-namespace:StockAnalyzer.Avalonia.Markup;assembly=StockAnalyzer.Avalonia"
        xmlns:controls="clr-namespace:StockAnalyzer.Avalonia.Views.Controls;assembly=StockAnalyzer.Avalonia"
        xmlns:behaviors="using:StockAnalyzer.Avalonia.Behaviors"
        xmlns:c="using:StockAnalyzer.Avalonia.Common"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
        x:Class="StockAnalyzer.Avalonia.Views.IndicatorSettingsWindow"
        x:DataType="vm:IndicatorSettingsDialogViewModel"
        Title="{l:Localize Window_IndicatorSettings_Title}"
        Icon="/Assets/avalonia-logo.ico"
        Width="950" Height="650"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        behaviors:WindowPersistenceBehavior.PersistenceEnabled="True"
        Background="{DynamicResource Brush.Background.Primary}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <converters:IndicatorColorToAvaloniaColorConverter x:Key="ColorConverter"/>
        <StreamGeometry x:Key="IndicatorHeaderIconData">M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.47,19H2V17H4.13L9.77,7.25L16,11.78Z</StreamGeometry>
    </Window.Resources>

    <Window.DataTemplates>
        <!-- Generic Template for all Indicator Parameters using Dynamic UI Generation -->
        <DataTemplate DataType="{x:Type models:CoreIndicatorParameterBase}">
            <controls:DynamicIndicatorSettingsView ParameterObject="{Binding}"
                                                    HiddenParameterTags="{Binding $parent[Window].DataContext.HiddenParameterTags}" />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="56,*,64">

        <!-- Header (Custom TitleBar) -->
        <Border Grid.Row="0" Height="56"
                Padding="24,0,16,0"
                Background="{DynamicResource Brush.Background.Tertiary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsHitTestVisible="False">
                    <PathIcon Data="{StaticResource IndicatorHeaderIconData}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                    <TextBlock Text="{l:Localize Window_IndicatorSettings_Title}" 
                               FontSize="{DynamicResource TitleFontSize}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Margin="10,10,10,0" Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid ColumnDefinitions="240,*">

                <!-- ==================== LEFT PANEL ==================== -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Border.Primary}" BorderThickness="0,0,1,0" Background="{DynamicResource Brush.Background.Secondary}">
                    <DockPanel>

                        <!-- Tab Header (Active / Library) -->
                        <Border DockPanel.Dock="Top" Margin="8,8,8,4">
                            <Grid ColumnDefinitions="*,1,*">
                                <!-- Active Tab Button -->
                                <Button Grid.Column="0"
                                        Content="{l:Localize Tab_Active}"
                                        Command="{Binding SwitchToActiveCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="8,6"
                                        Margin="0"
                                        CornerRadius="4,0,0,0"
                                        FontWeight="SemiBold"
                                        AutomationProperties.AutomationId="Tab_Active">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Tertiary}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <!-- Tab Divider Line -->
                                <Border Grid.Column="1" Background="{DynamicResource Brush.Border.Primary}" Width="1" VerticalAlignment="Stretch"/>
                                <!-- Library Tab Button -->
                                <Button Grid.Column="2"
                                        Content="{l:Localize Tab_Library}"
                                        Command="{Binding SwitchToLibraryCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="8,6"
                                        Margin="0"
                                        CornerRadius="0,4,0,0"
                                        FontWeight="SemiBold"
                                        AutomationProperties.AutomationId="Tab_Library">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Tertiary}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Divider line under tabs -->
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border.Primary}" Margin="0,4,0,4"/>

                        <!-- ===== ACTIVE MODE: Left Panel Content ===== -->
                        <DockPanel IsVisible="{Binding IsActiveMode}">

                            <!-- Active Indicator List -->
                            <ListBox Background="Transparent"
                                     BorderThickness="0"
                                     Margin="5"
                                     ItemsSource="{Binding Indicators}"
                                     SelectedItem="{Binding SelectedIndicator}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:CoreIndicatorSettings">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2" Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:Localize Menu_TurnOffIndicator}" 
                                                              Command="{Binding $parent[ListBox].((vm:IndicatorSettingsDialogViewModel)DataContext).TurnOffIndicatorCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{l:Localize Menu_TurnOffAll}" 
                                                              Command="{Binding $parent[ListBox].((vm:IndicatorSettingsDialogViewModel)DataContext).TurnOffAllIndicatorsCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{l:Localize Menu_RemoveIndicator}" 
                                                              Command="{Binding $parent[ListBox].((vm:IndicatorSettingsDialogViewModel)DataContext).RemoveIndicatorCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{l:Localize Menu_RemoveAll}" 
                                                              Command="{Binding $parent[ListBox].((vm:IndicatorSettingsDialogViewModel)DataContext).RemoveAllIndicatorsCommand}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,5,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- Error Indicator -->
                                            <TextBlock Grid.Column="2"
                                                       Text="⚠️"
                                                       Foreground="Red"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0"
                                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       ToolTip.Tip="{Binding ErrorMessage}"/>
                                            <!-- Delete Button -->
                                            <Button Grid.Column="3"
                                                    Command="{Binding $parent[ListBox].((vm:IndicatorSettingsDialogViewModel)DataContext).RemoveIndicatorCommand}"
                                                    CommandParameter="{Binding}"
                                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                                    Foreground="{DynamicResource Brush.Button.Text}"
                                                    Width="24" Height="24"
                                                    Padding="0"
                                                    Margin="4,0,0,0"
                                                    ToolTip.Tip="{l:Localize Btn_Delete}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                                <PathIcon Data="{x:Static c:SharedIconGeometries.Delete}" Width="12" Height="12" Foreground="{Binding $parent[Button].Foreground}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- ===== LIBRARY MODE: Left Panel Content (Category Accordion) ===== -->
                        <ScrollViewer IsVisible="{Binding IsLibraryMode}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="0">
                                <!-- "All Categories" button -->
                                <Button Content="{l:Localize Library_AllCategories}"
                                        Command="{Binding ClearCategoryFilterCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                        Background="Transparent"
                                        Padding="10,6"
                                        Margin="5,4,5,2"
                                        FontWeight="SemiBold"
                                        FontSize="{DynamicResource DetailFontSize}"/>

                                <!-- Category List -->
                                <ListBox Background="Transparent"
                                         BorderThickness="0"
                                         Margin="5,0"
                                         ItemsSource="{Binding Categories}"
                                         SelectedItem="{Binding SelectedCategory}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="{DynamicResource DetailFontSize}"
                                                       Padding="8,6"
                                                       Margin="2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- "Templates" button -->
                                <Button Content="{l:Localize Library_Templates}"
                                        Command="{Binding SelectTemplatesCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                        Background="Transparent"
                                        Padding="10,6"
                                        Margin="5,2,5,2"
                                        FontWeight="SemiBold"
                                        FontSize="{DynamicResource DetailFontSize}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>


                <!-- ==================== RIGHT PANEL ==================== -->

                <!-- ===== ACTIVE MODE: Right Panel (Parameter Settings with Card UI) ===== -->
                <Border Grid.Column="1"
                        Background="Transparent"
                        IsVisible="{Binding IsActiveMode}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">

                            <!-- When No Indicator Selected -->
                            <TextBlock Text="{l:Localize Msg_SelectIndicator}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="{DynamicResource DetailFontSize}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,50,0,0"
                                       IsVisible="{Binding SelectedIndicator, Converter={x:Static ObjectConverters.IsNull}}"/>

                            <!-- When Indicator Selected -->
                            <StackPanel IsVisible="{Binding SelectedIndicator, Converter={x:Static ObjectConverters.IsNotNull}}">

                                <!-- Indicator Name Header -->
                                <TextBlock Text="{Binding SelectedIndicator.DisplayName}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold"
                                           Margin="0,5,0,12"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Card 1: Configuration & Parameters -->
                                <Border Background="{DynamicResource Brush.Background.Primary}"
                                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{l:Localize Label_DisplayName}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold"/>
                                        <TextBox Text="{Binding SelectedIndicator.DisplayName}" Margin="0,0,0,4"/>

                                        <!-- Price Source -->
                                        <TextBlock Text="{l:Localize Label_PriceSource}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold"/>
                                        <ComboBox ItemsSource="{Binding PriceTypeOptions}" 
                                                  SelectedItem="{Binding SelectedIndicator.PriceSource, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,4"/>

                                        <!-- Input Source (Indicator on Indicator) -->
                                        <TextBlock Text="{l:Localize Label_SourceIndicator}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold"/>
                                        <ComboBox ItemsSource="{Binding AvailableSourceIndicators}" 
                                                  SelectedItem="{Binding SelectedSourceIndicatorOption, Mode=TwoWay}"
                                                  DisplayMemberBinding="{Binding DisplayName}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,4"/>

                                        <TextBlock Text="{l:Localize Label_Parameters}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold"/>
                                        <ContentControl Content="{Binding SelectedIndicator.ParameterObject}" Margin="0,0,0,4" />

                                        <!-- Dynamic Period Driver: shown here (in place of the Period row) only while HasDynamicPeriodDriver is ON -->
                                        <StackPanel IsVisible="{Binding HasDynamicPeriodDriver}" Spacing="4">
                                            <TextBlock Text="{l:Localize Label_DynamicPeriodDriver}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold"/>
                                            <ComboBox ItemsSource="{Binding AvailableDynamicPeriodDrivers}"
                                                      SelectedItem="{Binding SelectedDynamicPeriodDriverOption, Mode=TwoWay}"
                                                      DisplayMemberBinding="{Binding DisplayName}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,0,0,4"/>
                                        </StackPanel>

                                        <!-- Positioned below Period / Dynamic Period Driver (whichever is currently shown) -->
                                        <CheckBox Content="{l:Localize Check_UseDynamicPeriodDriver}"
                                                  IsChecked="{Binding HasDynamicPeriodDriver, Mode=TwoWay}"
                                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                                  FontSize="{DynamicResource BaseFontSize}"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,4"/>

                                        <!-- Offset -->
                                        <StackPanel IsVisible="{Binding ShowThicknessAndOffset}">
                                            <TextBlock Text="{l:Localize Label_Offset}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Slider Value="{Binding SelectedIndicator.Offset}"
                                                        Minimum="-50"
                                                        Maximum="50"
                                                        Width="200"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding SelectedIndicator.Offset}"
                                                         Width="40"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"
                                                         TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Style & Appearance -->
                                <Border Background="{DynamicResource Brush.Background.Primary}"
                                        BorderBrush="{DynamicResource Brush.Border.Primary}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{l:Localize Label_ColorSettings}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold"/>

                                        <!-- Main Color (Hidden if SeriesColors is present) -->
                                        <StackPanel Margin="0,0,0,4" IsVisible="{Binding SelectedIndicator.SeriesColors.Count, Converter={x:Static converters:NumericalConverters.IsEqualToZero}}">
                                            <TextBlock Text="{l:Localize Label_MainColor}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource DetailFontSize}" Margin="0,0,0,4"/>
                                            <ColorPicker Color="{Binding SelectedIndicator.Color, Converter={StaticResource ColorConverter}}" 
                                                         ColorSpectrumShape="Box"
                                                         Height="30" Width="200" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <!-- Multi-Series Colors -->
                                        <StackPanel Margin="0,0,0,4" IsVisible="{Binding SelectedIndicator.SeriesColors.Count, Converter={x:Static converters:NumericalConverters.IsGreaterThanZero}}">
                                            <ItemsControl ItemsSource="{Binding SelectedIndicator.SeriesColors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource DetailFontSize}" Margin="0,0,0,4"/>
                                                            <ColorPicker Color="{Binding Color, Converter={StaticResource ColorConverter}}" 
                                                                         ColorSpectrumShape="Box"
                                                                         Height="30" Width="200" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Use Up/Down Colors -->
                                        <StackPanel Margin="0,4,0,4" IsVisible="{Binding ShowUpDownColors}">
                                            <CheckBox Name="UseUpDownColorsCheck"
                                                      IsChecked="{Binding SelectedIndicator.UseUpDownColors}"
                                                      Content="{l:Localize Check_UseUpDownColors}"
                                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                                      Margin="0,0,0,6"/>

                                            <StackPanel IsVisible="{Binding #UseUpDownColorsCheck.IsChecked}">
                                                <TextBlock Text="{l:Localize Label_UpColor}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource DetailFontSize}" Margin="0,4,0,4"/>
                                                <ColorPicker Color="{Binding SelectedIndicator.UpColor, Converter={StaticResource ColorConverter}}" 
                                                             ColorSpectrumShape="Box"
                                                             Height="30" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                                <TextBlock Text="{l:Localize Label_DownColor}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource DetailFontSize}" Margin="0,4,0,4"/>
                                                <ColorPicker Color="{Binding SelectedIndicator.DownColor, Converter={StaticResource ColorConverter}}" 
                                                             ColorSpectrumShape="Box"
                                                             Height="30" Width="200" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Line Thickness -->
                                        <StackPanel IsVisible="{Binding ShowThicknessAndOffset}">
                                            <TextBlock Text="{l:Localize Label_Thickness}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource BaseFontSize}" FontWeight="Bold" Margin="0,4,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Slider Name="ThicknessSlider"
                                                        Value="{Binding SelectedIndicator.Thickness, Mode=TwoWay}"
                                                        Minimum="0.5"
                                                        Maximum="5"
                                                        Width="200"
                                                        TickFrequency="0.5"
                                                        IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding #ThicknessSlider.Value, Mode=TwoWay, StringFormat={}{0:F1}}"
                                                         Width="40"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"
                                                         TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Divider line under visual properties -->
                                        <Separator Background="{DynamicResource Brush.Border.Primary}" Height="1" Margin="0,8"/>

                                        <!-- Display & Layout Options -->
                                        <!-- Overlay Panel Selection -->
                                        <StackPanel IsVisible="{Binding ShowPanelSelector}">
                                            <TextBlock Text="{l:Localize Label_OverlayPanel}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding PanelOptions}"
                                                      SelectedItem="{Binding SelectedOverlayPanelOption}"
                                                      MinWidth="200"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,8"/>

                                            <!-- Show Cross Markers -->
                                            <CheckBox IsChecked="{Binding SelectedIndicator.ShowCrossMarkers}"
                                                      Content="{l:Localize Check_ShowCrossMarkers}"
                                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                                      Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- Show Value on Y-Axis -->
                                        <CheckBox IsChecked="{Binding SelectedIndicator.ShowAxisLabel}"
                                                  Content="{l:Localize Check_ShowAxisLabel}"
                                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                                  Margin="0,0,0,8"/>

                                        <!-- Show Signals -->
                                        <CheckBox IsChecked="{Binding SelectedIndicator.ShowSignals}"
                                                  Content="{l:Localize Check_ShowSignals}"
                                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                                  IsVisible="{Binding ShowSignals}"
                                                  Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===== LIBRARY MODE: Right Panel ===== -->
                <Border Grid.Column="1"
                        Background="Transparent"
                        IsVisible="{Binding IsLibraryMode}">
                    <Grid>
                        <!-- Standard Catalog view (not templates) -->
                        <DockPanel Margin="15" IsVisible="{Binding IsNotTemplatesCategory}">
                            <!-- Search Bar -->
                            <TextBox DockPanel.Dock="Top"
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     Watermark="{l:Localize Library_SearchPlaceholder}"
                                     FontSize="14"
                                     Margin="0,0,0,12"
                                     Padding="10,8"
                                     CornerRadius="6"
                                     AutomationProperties.AutomationId="Library_SearchBox"/>

                            <!-- Catalog Grid (WrapPanel in ScrollViewer) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FilteredCatalogItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IndicatorCatalogItem">
                                            <Button Command="{Binding $parent[ItemsControl].((vm:IndicatorSettingsDialogViewModel)DataContext).AddFromLibraryCommand}"
                                                    CommandParameter="{Binding}"
                                                    Width="130" Height="80"
                                                    Margin="4"
                                                    Padding="8"
                                                    CornerRadius="6"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="{DynamicResource Brush.Background.Tertiary}"
                                                    ToolTip.Tip="{Binding DisplayName}"
                                                    AutomationProperties.AutomationId="{Binding ShortName}">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
                                                    </Style>
                                                </Button.Styles>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShortName}"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                               FontSize="14" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Templates view -->
                        <Grid IsVisible="{Binding IsTemplatesCategory}" ColumnDefinitions="280, *" Margin="15">
                            <!-- Center Column (Templates List & Save) -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Brush.Background.Secondary}"
                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,10,0"
                                    Padding="10">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Top Editor -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,10" VerticalAlignment="Center">
                                        <Button Grid.Column="0"
                                                Command="{Binding SaveTemplateCommand}"
                                                Theme="{DynamicResource PrimaryButtonStyle}"
                                                Foreground="{DynamicResource Brush.Button.Text}"
                                                Width="32" Height="32"
                                                Padding="0"
                                                Margin="0,0,8,0"
                                                ToolTip.Tip="{l:Localize Btn_Save}">
                                            <PathIcon Data="{x:Static c:SharedIconGeometries.Save}" Width="16" Height="16" Foreground="{DynamicResource Brush.Button.Text}"/>
                                        </Button>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding NewTemplateName, Mode=TwoWay}"
                                                 Watermark="Template Name"
                                                 Height="32"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                    
                                    <!-- List of templates -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ListBox ItemsSource="{Binding Templates}"
                                                 SelectedItem="{Binding SelectedTemplate}"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Padding" Value="4"/>
                                                    <Setter Property="Margin" Value="0,1"/>
                                                </Style>
                                                <Style Selector="ListBoxItem:selected TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*, Auto, Auto, Auto" Margin="4,2" Background="Transparent">
                                                        <!-- Template Name -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>

                                                        <!-- Load Button -->
                                                        <Button Grid.Column="1"
                                                                Command="{Binding $parent[ListBox].DataContext.LoadTemplateCommand}"
                                                                CommandParameter="{Binding}"
                                                                Theme="{DynamicResource PrimaryButtonStyle}"
                                                                Foreground="{DynamicResource Brush.Button.Text}"
                                                                Width="28" Height="28"
                                                                Padding="0"
                                                                Margin="0,0,4,0"
                                                                ToolTip.Tip="{l:Localize Library_Btn_LoadTemplate}">
                                                            <PathIcon Data="{x:Static c:SharedIconGeometries.Load}" Width="14" Height="14" Foreground="{DynamicResource Brush.Button.Text}"/>
                                                        </Button>

                                                        <!-- Append Button -->
                                                        <Button Grid.Column="2"
                                                                Command="{Binding $parent[ListBox].DataContext.AppendTemplateCommand}"
                                                                CommandParameter="{Binding}"
                                                                Theme="{DynamicResource PrimaryButtonStyle}"
                                                                Foreground="{DynamicResource Brush.Button.Text}"
                                                                Width="28" Height="28"
                                                                Padding="0"
                                                                Margin="0,0,4,0"
                                                                ToolTip.Tip="{l:Localize Library_Btn_AppendTemplate}">
                                                            <PathIcon Data="{x:Static c:SharedIconGeometries.Add}" Width="14" Height="14" Foreground="{DynamicResource Brush.Button.Text}"/>
                                                        </Button>
                                                        
                                                        <!-- Delete Button -->
                                                        <Button Grid.Column="3"
                                                                Command="{Binding $parent[ListBox].DataContext.DeleteTemplateCommand}"
                                                                CommandParameter="{Binding}"
                                                                Theme="{DynamicResource PrimaryButtonStyle}"
                                                                Foreground="{DynamicResource Brush.Button.Text}"
                                                                Width="28" Height="28"
                                                                Padding="0"
                                                                Margin="0"
                                                                ToolTip.Tip="{l:Localize Library_Btn_DeleteTemplate}">
                                                            <PathIcon Data="{x:Static c:SharedIconGeometries.Delete}" Width="14" Height="14" Foreground="{DynamicResource Brush.Button.Text}"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Right Column (Template Indicators List) -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource Brush.Background.Secondary}"
                                    BorderBrush="{DynamicResource Brush.Border.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Template Indicators" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTemplateIndicatorNames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="14" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Height="64"
                Background="{DynamicResource Brush.Background.Tertiary}"
                BorderBrush="{DynamicResource Brush.Border.Primary}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <!-- Reset Button on the Far Left -->
                <Button Content="{l:Localize Btn_Reset}"
                        Theme="{StaticResource SecondaryButtonStyle}"
                        MinWidth="80" Padding="15,5" Height="32"
                        HorizontalAlignment="Left"
                        Command="{Binding ResetCommand}"/>
                <!-- Action Buttons on the Far Right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Localize Btn_OK}"
                            AutomationProperties.AutomationId="Settings_OkButton"
                            Theme="{StaticResource PrimaryButtonStyle}"
                            MinWidth="80" Padding="15,5" Height="32" Margin="5,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="{l:Localize Btn_Cancel}"
                            Theme="{StaticResource SecondaryButtonStyle}"
                            MinWidth="80" Padding="15,5" Height="32" Margin="5,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="{l:Localize Btn_Apply}"
                            Theme="{StaticResource PrimaryButtonStyle}"
                            MinWidth="80" Padding="15,5" Height="32" Margin="5,0,0,0"
                            Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast Notification Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                IsVisible="{Binding ToastService.IsNotificationVisible}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,60" Padding="16,10"
                Background="{DynamicResource Brush.Background.Tertiary}"
                CornerRadius="8" BoxShadow="0 4 10 0 #40000000"
                ZIndex="1000">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✅" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="{DynamicResource TitleFontSize}"/>
                <TextBlock Text="{Binding ToastService.NotificationMessage}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontSize="{DynamicResource BaseFontSize}" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
