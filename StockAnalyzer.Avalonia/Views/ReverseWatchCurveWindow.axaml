<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="StockAnalyzer.Avalonia.Views.ReverseWatchCurveWindow"
        Title="Reverse Watch Curve"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Dialog.DarkBackground}">
    
    
    <Grid x:Name="MainGrid">
        <!-- Header with chart title and Info (Date, Price, Volume) -->
        <StackPanel Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="Reverse Watch Curve" 
                       Foreground="{DynamicResource Brush.Dialog.Border}" 
                       FontSize="14" 
                       Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <!-- Info display removed as per user request -->
            </StackPanel>
        </StackPanel>
        
        <!-- Period display -->
        <TextBlock x:Name="PeriodLabel" 
                   Foreground="{DynamicResource Brush.Dialog.MutedText}" 
                   FontSize="11" 
                   Margin="0,10,10,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"/>
        
        <!-- Tooltip Panel Removed (Info in Header) -->
    </Grid>
</Window>
