<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DESIGN_TIME</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StockAnalyzer.Avalonia.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StockAnalyzer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.axaml" />
  </ItemGroup>

  <!-- Phase Space Spiral is retained in source but excluded from the product build. -->
  <ItemGroup>
    <Compile Remove="ViewModels\SpiralAnalysisViewModel.cs" />
    <Compile Remove="Views\SpiralAnalysisView.axaml.cs" />
    <Compile Remove="Views\Controls\SpiralPhasePlotControl.cs" />
    <Compile Remove="Views\Controls\SpiralPhasePlotLayout.cs" />
    <AvaloniaXaml Remove="Views\SpiralAnalysisView.axaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include specific static assets to avoid conflict with default .axaml inclusion -->
    <AvaloniaResource Include="Assets\**\*.ico" />
  </ItemGroup>

  <!-- Localization Resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Locales\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.10" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.10" />
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.3" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <!-- Serilog Logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>




  <!-- Configuration Files -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Models\*.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Python scripts: Include all StockAnalyzer.Python files in the publish output -->
  <ItemGroup>
    <None Include="..\StockAnalyzer.Python\**\*" Exclude="..\StockAnalyzer.Python\**\__pycache__\**;..\StockAnalyzer.Python\**\*.pyc;..\StockAnalyzer.Python\.venv\**;..\StockAnalyzer.Python\venv\**;..\StockAnalyzer.Python\**\.venv\**;..\StockAnalyzer.Python\**\venv\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>StockAnalyzer.Python\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- Drawing Assets: Include default drawing folders and icons in build and publish outputs -->
  <ItemGroup>
    <None Include="Assets\Icons\Drawings\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Data\Drawings\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockAnalyzer.Core\StockAnalyzer.Core.csproj" />
  </ItemGroup>

  <!-- Auto-create appsettings.json from example if missing for seamless OSS onboarding -->
  <Target Name="CopyAppSettings" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="appsettings.example.json" DestinationFiles="appsettings.json" Condition="!Exists('appsettings.json')" />
  </Target>

  <!-- Copy default drawing assets from Assets to solution-level Data\Drawings\ and target output directory after build -->
  <Target Name="CopyDefaultDrawingAssets" AfterTargets="Build">
    <ItemGroup>
      <_DefaultDrawingFiles Include="$(MSBuildProjectDirectory)\Assets\Icons\Drawings\**\*.*" />
    </ItemGroup>
    <!-- Copy to solution-level Data\Drawings for IDE/development runtime discovery -->
    <Copy SourceFiles="@(_DefaultDrawingFiles)"
          DestinationFolder="$(MSBuildProjectDirectory)\..\Data\Drawings\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <!-- Also copy to target output directory Data\Drawings for standalone execution -->
    <Copy SourceFiles="@(_DefaultDrawingFiles)"
          DestinationFolder="$(TargetDir)Data\Drawings\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'$(TargetDir)' != ''" />
  </Target>

  <!-- Copy default drawing assets to publish directory for dotnet publish / GitHub Actions packaging -->
  <Target Name="CopyDefaultDrawingAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_DefaultDrawingPublishFiles Include="$(MSBuildProjectDirectory)\Assets\Icons\Drawings\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DefaultDrawingPublishFiles)"
          DestinationFolder="$(PublishDir)Data\Drawings\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
